FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS base
WORKDIR /app
EXPOSE 8080

FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build

# installing Node.js and pnpm for the Vite build
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs && \
    npm install -g pnpm

WORKDIR /src
COPY ["UI-User/UI-User.csproj", "UI-User/"]
RUN dotnet restore "UI-User/UI-User.csproj"

# copy package files so pnpm install layer is cached
COPY ["UI-User/package.json", "UI-User/"]
COPY ["UI-User/pnpm-lock.yaml", "UI-User/"]
WORKDIR /src/UI-User
RUN pnpm install
WORKDIR /src

COPY . .

# Run Vite build explicitly before dotnet publish so MSBuild can discover the
# generated files in wwwroot/dist/ when it evaluates static web assets.
WORKDIR /src/UI-User
RUN pnpm run build
WORKDIR /src

RUN dotnet publish "UI-User/UI-User.csproj" -c Release -o /app/publish

FROM base AS final
WORKDIR /app
COPY --from=build /app/publish .
ENTRYPOINT ["dotnet", "SynapseEnqueteManagement.UI.User.dll"]
