@inject IViewLocalizer L
@{
    ViewData["Title"] = "Synapse — Deelplatform";
}

<div class="flex flex-col items-center justify-center min-h-[calc(100dvh-64px)] page-enter px-6">
    <div class="w-full max-w-sm text-center space-y-4">

        <div class="w-16 h-16 mx-auto mb-6 rounded-2xl bg-base-200 border border-base-300 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-neutral" fill="none" viewBox="0 0 24 24"
                 stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M13.5 10.5V6.75a4.5 4.5 0 119 0v3.75M3.75 21.75h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H3.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
            </svg>
        </div>

        <h1 class="font-heading text-2xl font-semibold text-base-content">
            @L["WelcomeHeading"]
        </h1>
        <p class="text-sm text-neutral leading-relaxed">
            @L["WelcomePlatformInfo"]
        </p>
        <p class="text-sm text-neutral leading-relaxed">
            @L["AdminQuestion"]
            @L["AdminDirectionPrefix"] <strong>admin.synapse-ip.xyz</strong>.
        </p>

    </div>
</div>
