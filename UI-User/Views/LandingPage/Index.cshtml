@model ProjectViewModel
@inject IViewLocalizer L


@{
    ViewData["Title"] = Model.OrganisationName;
    ViewData["SurveyTitle"] = Model.OrganisationName;
    ViewData["OrganisationLogoUrl"] = Model.OrganisationLogoUrl;
    ViewData["BgAnimationMobile"] = true;
}

<div class="scroll-lock-marker hidden"></div>

@await Html.PartialAsync("_BackgroundAnimation")

<div class="min-h-[calc(100vh-var(--header-h))] flex flex-col px-8 py-6 page-enter relative z-10">

    @* Main hero *@
    <div class="flex-1 flex flex-col justify-center w-full max-w-3xl mx-auto gap-12 py-16">

        @* Project title — left border accent *@
        <div class="border-l-4 border-primary pl-6">
            <p class="text-sm font-medium text-primary/70 uppercase tracking-widest mb-2">@Model.OrganisationName</p>
            <h1 class="font-heading text-4xl sm:text-5xl font-bold text-base-content leading-tight">
                @(string.IsNullOrEmpty(Model.Name) ? Model.OrganisationName : Model.Name)
            </h1>
        </div>

        @* CTA *@
        <div class="flex justify-center sm:justify-start">
            <span class="btn-travel-wrap">
                <a asp-controller="Survey" asp-action="Index" asp-route-projectId="@Model.ProjectId"
                   class="btn btn-primary rounded-2xl font-heading font-semibold text-base px-10 py-4 h-auto gap-2 shadow-md hover:shadow-lg transition-shadow">
                    @L["StartSurveyButton"]
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24"
                         stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                    </svg>
                </a>
                @* CTA *@
            </span>
        </div>

    </div>

    <div class="pb-6 text-xs text-base-content/50">
        <a asp-controller="Privacy" asp-action="Index" class="underline hover:text-base-content/70 transition-colors">
            @L["Privacy"]
        </a>
    </div>

</div>
