@model ThankYouViewModel
@{
    ViewData["Title"] = "Bedankt";
}

<div class="flex flex-col items-center justify-center min-h-[calc(100dvh-64px)] px-6 text-center">

    <div class="w-full max-w-sm flex flex-col items-center gap-6">

        <div class="w-16 h-16 rounded-2xl bg-secondary/10 border border-secondary/20 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-secondary" fill="none"
                 viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
            </svg>
        </div>

        <div>
            <h1 class="font-heading text-2xl font-semibold text-base-content mb-2">
                Bedankt voor je deelname!
            </h1>
            <p class="text-neutral text-sm max-w-xs leading-relaxed">
                Jouw ideeën en reacties zijn waardevol. We nemen ze mee in het verdere proces.
                Je kan dit venster nu sluiten.
            </p>
        </div>

        @if (!string.IsNullOrEmpty(Model.OrganisationLogoUrl))
        {
            <img src="@Model.OrganisationLogoUrl" alt="@Model.OrganisationName"
                 class="h-10 object-contain"/>
        }

        @if (!string.IsNullOrEmpty(Model.OrganisationWebsiteUrl))
        {
            <a href="@Model.OrganisationWebsiteUrl" target="_blank" rel="noopener noreferrer"
               class="inline-flex items-center gap-1.5 text-sm text-primary hover:underline">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none"
                     viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                </svg>
                @(string.IsNullOrEmpty(Model.OrganisationName) ? Model.OrganisationWebsiteUrl : Model.OrganisationName)
            </a>
        }

    </div>
</div>
