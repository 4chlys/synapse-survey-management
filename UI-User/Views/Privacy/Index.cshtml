@inject IViewLocalizer L
@inject IHtmlLocalizer<SharedResource> Shared
@{
    ViewData["Title"] = L["PageTitle"].Value;
}

<div class="min-h-[calc(100dvh-64px)] px-6 py-12 page-enter">
    <div class="w-full max-w-3xl mx-auto prose prose-sm text-base-content">
        <h1 class="font-heading text-2xl font-semibold">@L["PageTitle"]</h1>

        <p>@string.Format(L["Intro"].Value, ViewData["OrganisationName"])</p>

        <h2 class="font-heading text-lg font-semibold mt-8">@L["WhatWeCollectTitle"]</h2>
        <p>@L["WhatWeCollectBody"]</p>

        <h2 class="font-heading text-lg font-semibold mt-8">@L["AnonymityTitle"]</h2>
        <p>@L["AnonymityBody"]</p>

        <h2 class="font-heading text-lg font-semibold mt-8">@L["AITitle"]</h2>
        <p>@L["AIBody"]</p>

        <h2 class="font-heading text-lg font-semibold mt-8">@L["DataAccessTitle"]</h2>
        <p>@L["DataAccessBody"]</p>

        <h2 class="font-heading text-lg font-semibold mt-8">@L["ContactTitle"]</h2>
        <p>@L["ContactBody"]</p>
    </div>

    @{
        var returnUrl = ViewData["PrivacyReturnUrl"] as string
            ?? Url.Action("Index", "LandingPage", new { projectId = ViewData["ProjectId"] });
    }
    <a href="@returnUrl"
       class="fixed bottom-6 left-6 btn btn-sm btn-ghost gap-1 text-base-content/60 hover:text-base-content z-50">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
        @Shared["Back"]
    </a>
</div>
