@model SynapseEnqueteManagement.UI.User.Models.ProjectInfo

@{
    ViewData["Title"] = Model.OrganisationName;
    ViewData["SurveyTitle"] = Model.OrganisationName;
}

<div class="flex flex-col items-center justify-center min-h-[80vh] px-6">
    <div class="w-full max-w-md">

        @* Card *@
        <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">

            @* Top accent bar *@
            <div class="h-1.5 bg-emerald-500 w-full"></div>

            <div class="px-8 py-10 flex flex-col items-center text-center">

                @* Logo *@
                @if (!string.IsNullOrEmpty(Model.OrganisationLogoUrl))
                {
                    <img src="@Model.OrganisationLogoUrl"
                         alt="@Model.OrganisationName"
                         class="h-14 object-contain mb-6" />
                }
                else
                {
                    <div class="w-14 h-14 bg-emerald-100 rounded-full flex items-center justify-center mb-6">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19 21H5a2 2 0 01-2-2V7l7-5 7 5v12a2 2 0 01-2 2z" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 21V12h6v9" />
                        </svg>
                    </div>
                }

                @* Organisation name *@
                <h2 class="text-xl font-semibold text-gray-900 mb-1">@Model.OrganisationName</h2>

                @* Divider *@
                <div class="w-8 h-0.5 bg-emerald-400 rounded-full my-4"></div>

                @* Introduction text *@
                @if (!string.IsNullOrEmpty(Model.Introduction))
                {
                    <p class="text-gray-500 text-sm leading-relaxed max-w-sm mb-8">
                        @Model.Introduction
                    </p>
                }
                else
                {
                    <p class="text-gray-500 text-sm leading-relaxed max-w-sm mb-8">
                        Neem deel aan de bevraging van @Model.OrganisationName
                    </p>
                }

                @* CTA button *@
                <a asp-controller="Survey" asp-action="Index" asp-route-projectId="@Model.ProjectId"
                   class="w-full py-3 bg-emerald-600 text-white text-sm font-medium rounded-xl hover:bg-emerald-700 active:scale-[.98] transition-all text-center">
                    Start enquête &rarr;
                </a>

                @* Website link *@
                @if (!string.IsNullOrEmpty(Model.OrganisationWebsiteUrl))
                {
                    <a href="@Model.OrganisationWebsiteUrl" target="_blank" rel="noopener noreferrer"
                       class="mt-4 text-xs text-gray-400 hover:text-emerald-600 transition-colors">
                        @Model.OrganisationWebsiteUrl
                    </a>
                }

            </div>
        </div>

    </div>
</div>
