@model ProjectViewModel

@{
    ViewData["Title"] = Model.OrganisationName;
    ViewData["SurveyTitle"] = Model.OrganisationName;
}

<div class="flex flex-col items-center justify-center min-h-[calc(100dvh-64px)] px-6 py-12">
    <div class="w-full max-w-sm">

        <div class="bg-base-100 rounded-2xl shadow-sm border border-base-300 overflow-hidden">

            @* Ideation accent strip *@
            <div class="h-1.5 accent-strip w-full"></div>

            <div class="px-8 py-10 flex flex-col items-center text-center">

                @* Logo or icon *@
                @if (!string.IsNullOrEmpty(Model.OrganisationLogoUrl))
                {
                    <img src="@Model.OrganisationLogoUrl"
                         alt="@Model.OrganisationName"
                         class="h-14 object-contain mb-6" />
                }
                else
                {
                    <div class="w-14 h-14 bg-base-200 rounded-2xl flex items-center justify-center mb-6 border border-base-300">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19 21H5a2 2 0 01-2-2V7l7-5 7 5v12a2 2 0 01-2 2z" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 21V12h6v9" />
                        </svg>
                    </div>
                }

                @* Organisation name *@
                <h2 class="font-heading text-xl font-semibold text-base-content mb-1">
                    @Model.OrganisationName
                </h2>

                @* Divider *@
                <div class="w-8 h-0.5 bg-primary/30 rounded-full my-4"></div>

                @* Introduction text *@
                @if (!string.IsNullOrEmpty(Model.Introduction))
                {
                    <p class="text-neutral text-sm leading-relaxed max-w-sm mb-8">
                        @Model.Introduction
                    </p>
                }
                else
                {
                    <p class="text-neutral text-sm leading-relaxed max-w-sm mb-8">
                        Neem deel aan de bevraging van @Model.OrganisationName
                    </p>
                }

                @* Primary CTA *@
                <a asp-controller="Survey" asp-action="Index" asp-route-projectId="@Model.ProjectId"
                   class="btn btn-primary w-full rounded-xl font-heading font-semibold text-sm">
                    Start enquête
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
                    </svg>
                </a>

                @* Website link *@
                @if (!string.IsNullOrEmpty(Model.OrganisationWebsiteUrl))
                {
                    <a href="@Model.OrganisationWebsiteUrl" target="_blank" rel="noopener noreferrer"
                       class="mt-4 text-xs text-neutral/60 hover:text-primary transition-colors">
                        @Model.OrganisationWebsiteUrl
                    </a>
                }

            </div>
        </div>

    </div>
</div>
