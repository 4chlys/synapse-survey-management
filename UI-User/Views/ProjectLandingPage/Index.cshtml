@model ProjectViewModel
@inject IViewLocalizer L

@{
    ViewData["Title"] = Model.OrganisationName;
    ViewData["SurveyTitle"] = Model.OrganisationName;
}

<div class="flex flex-col items-center justify-center min-h-[calc(100dvh-64px)] px-6 page-enter">
    <div class="w-full max-w-xs">

        <div class="bg-base-100 rounded-2xl shadow-md border border-base-300 overflow-hidden">

            @* Accent strip *@
            <div class="h-1 accent-strip w-full"></div>

            <div class="px-8 pt-10 pb-8 flex flex-col items-center text-center">

                @* Logo -> only shown when a real URL is provided *@
                @if (!string.IsNullOrEmpty(Model.OrganisationLogoUrl))
                {
                    <div class="mb-5">
                        <img src="@Model.OrganisationLogoUrl" alt="@Model.OrganisationName" class="h-12 object-contain" />
                    </div>
                }

                @* Organisation name *@
                <h2 class="font-heading text-2xl font-bold text-base-content leading-tight mb-2">
                    @Model.OrganisationName
                </h2>

                @* Divider *@
                <div class="w-6 h-px bg-primary/40 rounded-full mb-6"></div>

                @* Introduction text *@
                <div class="w-full text-left mb-8">
                    <p class="text-base text-base-content/85 leading-relaxed">
                        @(string.IsNullOrEmpty(Model.Introduction)
                            ? L["DefaultIntroduction", Model.OrganisationName].Value
                            : Model.Introduction)
                    </p>
                </div>

                @* CTA *@
                <a asp-controller="Survey" asp-action="Index" asp-route-projectId="@Model.ProjectId"
                       class="btn btn-primary w-full rounded-xl font-heading font-semibold text-base py-4 h-auto">
                    @L["StartSurveyButton"]
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24"
                         stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                    </svg>
                </a>

            </div>
        </div>

        @* Website link below card *@
        @if (!string.IsNullOrEmpty(Model.OrganisationWebsiteUrl))
        {
            <div class="text-center mt-5">
                <a href="@Model.OrganisationWebsiteUrl" target="_blank" rel="noopener noreferrer"
                       class="text-xs text-neutral/70 hover:text-primary transition-colors">
                    @Model.OrganisationWebsiteUrl
                </a>
            </div>
        }

    </div>
</div>
