@inject IViewLocalizer L
@* Discard-confirmation for the AI idea/comment chats.
   Sits above the chat overlay (z-50) so it can guard accidental dismissal.
   Driven by confirmDiscard() in src/lib/discard-confirm.ts. *@
<div id="discard-confirm-overlay"
     class="fixed inset-0 z-[70] hidden items-center justify-center bg-black/50 backdrop-blur-sm px-4">

    <div role="dialog" aria-modal="true" aria-labelledby="discard-confirm-heading"
         class="relative bg-base-100 rounded-box shadow-2xl w-full max-w-md flex flex-col gap-5 p-6 border border-base-300">

        @* Header *@
        <div class="flex items-start gap-3">
            <div class="w-10 h-10 rounded-field bg-accent/10 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-accent" fill="none" viewBox="0 0 24 24"
                     stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0
                    001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2
                    2 0 00-3.42 0z" />
                </svg>
            </div>
            <div>
                <h3 id="discard-confirm-heading" class="font-heading font-semibold text-base-content text-base leading-snug">
                    @L["AiChat_DiscardTitle"]
                </h3>
                <p class="text-neutral text-sm mt-0.5 leading-relaxed">
                    @L["AiChat_DiscardMessage"]
                </p>
            </div>
        </div>

        @* Action buttons *@
        <div class="flex flex-col gap-2">
            <button id="discard-confirm-btn-cancel" type="button"
                    class="btn btn-primary w-full rounded-field font-heading font-semibold cursor-pointer">
                @L["AiChat_DiscardCancel"]
            </button>

            <button id="discard-confirm-btn-confirm" type="button"
                    class="w-full py-3 rounded-field border border-base-300 text-error text-sm font-semibold
                           hover:bg-error/10 active:scale-95 transition-all cursor-pointer">
                @L["AiChat_DiscardConfirm"]
            </button>
        </div>

    </div>
</div>
