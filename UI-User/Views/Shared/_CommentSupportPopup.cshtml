@inject IViewLocalizer L
@* AI Comment Support Chat Overlay
   Similar structure to _IdeaSupportPopup but simpler:
   - Two-turn flow (AI intro → user comment → AI feedback)
   - Submit UI rendered dynamically by commentsupportchat.ts
   - "Direct plaatsen" skip button in the header
*@

<div id="comment-support-overlay"
     class="fixed inset-0 z-50 hidden items-end sm:items-center justify-center
            bg-black/50 backdrop-blur-sm p-0 sm:p-6">

    <div id="comment-support-panel"
         role="dialog" aria-modal="true" aria-labelledby="comment-support-heading"
         class="relative bg-base-100 flex flex-col shadow-2xl
                w-full max-w-full sm:max-w-xl md:max-w-2xl
                h-[80dvh] sm:h-[75dvh] md:h-[70dvh]
                rounded-t-[1.25rem] sm:rounded-[1.25rem]">

        @* Header *@
        <div class="flex items-center justify-between px-5 pt-5 pb-3 border-b border-base-300 flex-shrink-0">
            <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-full bg-primary/15 flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary" fill="none"
                         viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                    </svg>
                </div>
                <div>
                    <p id="comment-support-heading" class="text-sm font-heading font-semibold text-base-content leading-none">@L["HeaderTitle"]</p>
                    <p class="text-xs text-primary mt-0.5">@L["HeaderSubtitle"]</p>
                </div>
            </div>
            <div class="flex items-center gap-1">
                @* Skip to manual *@
                <button id="comment-support-btn-skip"
                        type="button"
                        title="@L["SkipButtonTitle"]"
                        class="btn-pill-ghost">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 flex-shrink-0" fill="none"
                         viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5
                                 m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                    </svg>
                    <span>@L["SkipButtonText"]</span>
                </button>

                @* Close *@
                <button id="comment-support-btn-close"
                        type="button"
                        aria-label="@L["CloseAriaLabel"]"
                        class="btn-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none"
                         viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>
            </div>
        </div>

        @* Chat messages + submit UI rendered here by JS *@
        <div id="comment-support-messages" role="log" aria-live="polite"
             class="flex-1 overflow-y-auto px-4 py-4 flex flex-col gap-3 min-h-0">
        </div>

        @* Input area — hidden after user sends (JS toggles via comment-support-input-area) *@
        <div id="comment-support-input-area"
             class="px-4 pb-5 pt-2 flex-shrink-0 border-t border-base-300">
            <div class="flex gap-2 items-end">
                <textarea id="comment-support-input"
                          rows="1"
                          maxlength="500"
                          placeholder="@L["InputPlaceholder"]"
                          class="support-textarea"></textarea>
                <partial name="_MicButton"
                         model='new MicButtonModel(TargetSelector: "#comment-support-input", SizeClass: "w-11 h-11")' />
                <button id="comment-support-btn-send"
                        type="button"
                        aria-label="@L["SendAriaLabel"]"
                        class="btn-chat-send">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none"
                         viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
                    </svg>
                </button>
            </div>
            <p class="text-xs text-base-content/40 mt-2 text-center leading-relaxed">
                @L["FooterNote"]
            </p>
        </div>

    </div>
</div>
