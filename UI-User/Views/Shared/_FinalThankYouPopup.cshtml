@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer L
@{
    var orgName = ViewData["OrganisationName"] as string;
    var orgLogo = ViewData["OrganisationLogoUrl"] as string;
    var orgSite = ViewData["OrganisationWebsiteUrl"] as string;
}

<div id="thank-you-popup"
     class="fixed inset-0 z-[60] hidden items-center justify-center bg-black/40 backdrop-blur-sm p-6"
     data-action="close-thank-you-backdrop">

    <div class="w-full max-w-xs" data-thank-you-panel>

        <div class="bg-base-100 rounded-2xl border border-base-300 shadow-2xl overflow-hidden relative">

            <button type="button" data-action="close-thank-you"
                    aria-label="@L["CloseLabel"]"
                    class="absolute top-3 right-3 w-8 h-8 rounded-full flex items-center justify-center text-base-content/60 hover:text-base-content hover:bg-base-200 transition-colors cursor-pointer">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24"
                     stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>

            <div class="h-1 accent-strip w-full"></div>

            <div class="px-8 pt-10 pb-8 flex flex-col items-center text-center gap-6">

                <div class="w-20 h-20 rounded-2xl bg-secondary/25 flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-11 w-11 text-secondary" fill="none"
                         viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                    </svg>
                </div>

                <div>
                    <h2 class="font-heading text-[26px] font-bold text-base-content mb-3 leading-tight">
                        @L["ThankYouHeading"]
                    </h2>
                    <p class="text-[15px] text-base-content/80 leading-relaxed max-w-60 mx-auto">
                        @L["ThankYouBody"]
                    </p>
                </div>

                @if (!string.IsNullOrEmpty(orgLogo))
                {
                    <img src="@orgLogo" alt="@orgName" class="h-7 object-contain opacity-40"/>
                }
            </div>
        </div>

        @if (!string.IsNullOrEmpty(orgSite))
        {
            <div class="text-center mt-5">
                <a href="@orgSite" target="_blank" rel="noopener noreferrer"
                   class="inline-flex items-center gap-1.5 text-xs text-neutral/60 hover:text-primary transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24"
                         stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                    </svg>
                    @(string.IsNullOrEmpty(orgName) ? orgSite : orgName)
                </a>
            </div>
        }
    </div>
</div>

<script>
    (function () {
        const popup = document.getElementById('thank-you-popup');
        if (!popup || popup.dataset.bound === '1') return;
        popup.dataset.bound = '1';

        const open = () => {
            popup.classList.remove('hidden');
            popup.classList.add('flex');
            document.body.style.overflow = 'hidden';
        };
        const close = () => {
            popup.classList.add('hidden');
            popup.classList.remove('flex');
            document.body.style.overflow = '';
        };

        document.addEventListener('click', (e) => {
            const target = e.target;
            if (!(target instanceof Element)) return;
            const opener = target.closest('[data-action="show-thank-you"]');
            if (opener) {
                e.preventDefault();
                open();
                return;
            }
            if (target.closest('[data-action="close-thank-you"]')) {
                e.preventDefault();
                close();
                return;
            }
            if (target === popup) close();
        });

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && !popup.classList.contains('hidden')) close();
        });
    })();
</script>
