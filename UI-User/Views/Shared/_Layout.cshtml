@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - SynapseIP</title>

    @* Read by ideahub.ts → getProjectId() *@
    <meta name="project-id" content="@(ViewData["ProjectId"] ?? Context.GetRouteValue("projectId") ?? 1)"/>
    @* Read by moderation.ts → getCsrfToken() for fetch requests to /api *@
    <meta name="__RequestVerificationToken" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken"/>

    <script type="module" vite-src="~/main.ts"></script>
    <environment include="Development">
        <link rel="stylesheet" vite-href="~/main.css"/>
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" vite-href="~/main.ts"/>
    </environment>

</head>
<body class="bg-gray-100 min-h-screen">

@if (ViewData["ShowModerationPopup"] is true)
{
    @await Html.PartialAsync("_ModerationPopup")
}

    @* Survey header *@
    <header class="fixed left-0 right-0 z-40 bg-white border-b border-gray-200 flex items-center px-4 py-3">
        @{
            var logoUrl = ViewData["OrganisationLogoUrl"]?.ToString();
            var websiteUrl = ViewData["OrganisationWebsiteUrl"]?.ToString();
        }
        @if (!string.IsNullOrEmpty(logoUrl))
        {
            <img src="@logoUrl" alt="Organisation logo" class="h-8 w-auto object-contain shrink-0" />
        }
        else
        {
            <div class="w-8"></div>
        }
        <h1 class="survey-title flex-1 text-center text-amber-600 text-2xl">
            @(ViewData["SurveyTitle"] ?? "SynapseIP")
        </h1>
        @if (!string.IsNullOrEmpty(websiteUrl))
        {
            <a href="@websiteUrl" target="_blank" rel="noopener noreferrer"
               class="shrink-0 text-xs text-emerald-600 hover:underline">
                Visit website
            </a>
        }
        else
        {
            <div class="w-8"></div>
        }
    </header>

<main class="pt-[92px]">
    @RenderBody()
</main>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
