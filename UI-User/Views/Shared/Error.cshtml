@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="flex flex-col items-center justify-center min-h-[calc(100dvh-64px)] page-enter px-6">
    <div class="w-full max-w-sm text-center">

        <div class="w-16 h-16 mx-auto mb-6 rounded-2xl bg-error/10 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-error" fill="none" viewBox="0 0 24 24"
                 stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
            </svg>
        </div>

        <h1 class="font-heading text-2xl font-semibold text-base-content mb-2">Er ging iets mis</h1>
        <p class="text-sm text-neutral leading-relaxed mb-6">
            Er is een fout opgetreden bij het verwerken van je aanvraag.
        </p>

        @if (Model.ShowRequestId)
        {
            <div class="inline-flex items-center gap-2 px-3 py-2 rounded-lg bg-base-200 border border-base-300 mb-6">
                <span class="text-xs text-neutral">Request ID:</span>
                <code class="text-xs font-mono text-base-content">@Model.RequestId</code>
            </div>
        }

    </div>
</div>
