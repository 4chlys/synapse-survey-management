<div id="moderation-overlay"
     class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40 backdrop-blur-sm">

    <div id="moderation-card"
         class="bg-white rounded-2xl shadow-xl mx-4 w-full max-w-md flex flex-col gap-4 p-6
                animate-[fade-up_0.2s_ease-out_both]">

        <div class="flex items-start gap-3">
            <div class="w-10 h-10 rounded-full bg-amber-100 flex items-center justify-center flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-amber-600"
                     fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0
                             001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2
                             2 0 00-3.42 0z" />
                </svg>
            </div>
            <div>
                <h3 class="text-gray-900 font-semibold text-base">
                    Je bericht bevat ongepaste inhoud
                </h3>
                <p id="moderation-reason" class="text-gray-500 text-sm mt-0.5"></p>
            </div>
        </div>

        <div id="moderation-suggestion-block" class="flex flex-col gap-3">
            <p class="text-xs font-semibold tracking-widest uppercase text-gray-400">
                Voorgestelde herschrijving
            </p>
            <div class="rounded-2xl border-2 border-emerald-200 bg-emerald-50 px-4 py-3
                        text-sm text-gray-800 leading-relaxed">
                <p id="moderation-suggestion-text"></p>
            </div>
            <p class="text-xs text-gray-400">
                Accepteer de herschrijving of dien je originele bericht in als anonieme melding.
            </p>
        </div>

        <p id="moderation-block-message" class="hidden text-sm text-gray-600">
            Je bericht kan niet worden ingediend. Pas het aan en probeer opnieuw.
        </p>
        
        <div id="moderation-btn-row" class="flex gap-3 mt-1">

            <button id="moderation-btn-decline"
                    type="button"
                    class="flex-1 py-3.5 rounded-2xl border-2 border-gray-200
                           text-gray-600 text-sm font-medium cursor-pointer
                           hover:border-gray-300 hover:bg-gray-50 active:scale-95 transition-all">
                Toch insturen (als melding)
            </button>

            <button id="moderation-btn-accept"
                    type="button"
                    class="flex-1 py-3.5 rounded-2xl bg-emerald-500 shadow-lg
                           text-white text-sm font-semibold cursor-pointer
                           hover:bg-emerald-600 active:scale-95 transition-all">
                Herschrijving gebruiken
            </button>

            <button id="moderation-btn-close"
                    type="button"
                    class="hidden w-full py-3.5 rounded-2xl border-2 border-gray-200
                           text-gray-600 text-sm font-medium cursor-pointer
                           hover:border-gray-300 hover:bg-gray-50 active:scale-95 transition-all">
                Sluiten en aanpassen
            </button>

        </div>

    </div>
</div>
