<div id="moderation-overlay"
     class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 backdrop-blur-sm">

    <div id="moderation-card"
         class="relative bg-white rounded-2xl shadow-2xl mx-4 w-full max-w-md flex flex-col gap-5 p-6">

        @* Close button *@
        <button id="moderation-btn-x"
                type="button"
                aria-label="Sluiten"
                class="absolute top-4 right-4 w-7 h-7 flex items-center justify-center
                       rounded-full text-gray-400 hover:text-gray-600 hover:bg-gray-100
                       transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none"
                 viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
            </svg>
        </button>

        @* Header *@
        <div class="flex items-start gap-3 pr-6">
            <div class="w-10 h-10 rounded-full bg-amber-100 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-amber-600"
                     fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0
                             001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2
                             2 0 00-3.42 0z"/>
                </svg>
            </div>
            <div>
                <h3 class="text-gray-900 font-semibold text-base leading-snug">
                    Je bericht bevat ongepaste inhoud
                </h3>
                <p id="moderation-reason" class="text-gray-500 text-sm mt-0.5 leading-relaxed"></p>
            </div>
        </div>

        @* Rewrite suggestion — shown when AI produced one *@
        <div id="moderation-suggestion-block" class="flex flex-col gap-2">
            <p class="text-xs font-semibold tracking-widest uppercase text-gray-400">
                Voorgestelde herschrijving
            </p>
            <div class="rounded-xl border-2 border-emerald-200 bg-emerald-50 px-4 py-3
                        text-sm text-gray-800 leading-relaxed">
                <p id="moderation-suggestion-text"></p>
            </div>
            <p class="text-xs text-gray-400 leading-relaxed">
                Accepteer de herschrijving of dien je originele bericht in als anonieme melding.
            </p>
        </div>

        @* Block message — shown when no rewrite is possible *@
        <p id="moderation-block-message"
           class="hidden text-sm text-gray-600 leading-relaxed bg-red-50 border border-red-100
                  rounded-xl px-4 py-3">
            Je bericht kan niet worden ingediend. Pas de inhoud aan en probeer opnieuw.
        </p>

        @* Action buttons *@
        <div id="moderation-btn-row" class="flex gap-3">
            <button id="moderation-btn-decline"
                    type="button"
                    class="flex-1 py-3 rounded-xl border-2 border-gray-200
                           text-gray-600 text-sm font-medium
                           hover:border-gray-300 hover:bg-gray-50 active:scale-95
                           transition-all cursor-pointer">
                Toch insturen
            </button>
            <button id="moderation-btn-accept"
                    type="button"
                    class="flex-1 py-3 rounded-xl bg-emerald-500 shadow-sm
                           text-white text-sm font-semibold
                           hover:bg-emerald-600 active:scale-95
                           transition-all cursor-pointer">
                Herschrijving gebruiken
            </button>
            <button id="moderation-btn-close"
                    type="button"
                    class="hidden w-full py-3 rounded-xl border-2 border-gray-200
                           text-gray-600 text-sm font-medium
                           hover:border-gray-300 hover:bg-gray-50 active:scale-95
                           transition-all cursor-pointer">
                Sluiten en aanpassen
            </button>
        </div>

    </div>
</div>
