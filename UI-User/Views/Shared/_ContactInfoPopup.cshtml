@model IdeaIndexViewModel
@inject IViewLocalizer L
@{
    var projectId = Model.ProjectId;
    var categoryId = Model.CategoryId;
}

<div id="contactInfoPopup" class="fixed inset-0 z-50 flex items-end justify-center bg-black/40 backdrop-blur-sm">
    <div
        class="w-full max-w-sm bg-base-100 rounded-t-3xl p-6 pb-20 shadow-xl border-t border-base-300 animate-slide-up">

        <div class="text-center mb-6">
            <div class="text-4xl mb-3">🎉</div>
            <h2 class="font-heading text-xl font-semibold text-base-content">@L["ThankYouForIdeaHeading"]</h2>
            <p class="text-sm text-neutral mt-2 leading-relaxed">
                @L["StayInformedBody"]
            </p>
        </div>

        <form asp-action="SaveContactInfo" method="post" class="flex flex-col gap-3">
            <input type="hidden" name="projectId" value="@projectId" />
            <input type="hidden" name="categoryId" value="@categoryId" />

            <div>
                <label class="text-xs font-semibold text-neutral uppercase tracking-wide mb-1.5 block">
                    @L["EmailLabel"]
                </label>
                <input type="email" name="email" placeholder="@L["EmailPlaceholder"]" maxlength="200" class="w-full px-4 py-3 border border-base-300 rounded-field bg-base-100
                    text-base-content text-sm placeholder:text-neutral/50
                    focus:border-primary focus:outline-none transition-colors" />
            </div>

            <button type="submit" class="btn btn-primary w-full rounded-field font-heading font-semibold mt-1">
                @L["SaveButton"]
            </button>
        </form>

        <a asp-action="IdeaHub" asp-route-projectId="@projectId" asp-route-categoryId="@categoryId"
               class="block text-center mt-4 text-sm text-neutral/60 hover:text-neutral transition-colors">
            @L["SkipLink"]
        </a>

    </div>
</div>
