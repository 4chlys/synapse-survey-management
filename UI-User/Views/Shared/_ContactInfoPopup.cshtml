@{
    var projectId = ViewData["ProjectId"];
    var categoryId = ViewData["CategoryId"];
    var requestContactInfo = ViewData["RequestContactInfo"] is true;
}

<div id="contactInfoPopup"
     class="fixed inset-0 z-50 flex items-end justify-center bg-black/40 backdrop-blur-sm">
    <div class="w-full max-w-sm bg-white rounded-t-3xl p-6 pb-10 shadow-xl animate-slide-up">

        <div class="text-center mb-6">
            <div class="text-4xl mb-3">🎉</div>
            <h2 class="text-xl font-semibold text-gray-900">Bedankt voor jouw idee!</h2>
            @if (requestContactInfo)
            {
                <p class="text-sm text-gray-500 mt-2">
                    Wil je op de hoogte blijven? Laat optioneel je contactgegevens achter.
                </p>
            }
        </div>

        @if (requestContactInfo)
        {
            <form asp-action="SaveContactInfo" method="post" class="flex flex-col gap-3">
                <input type="hidden" name="projectId" value="@projectId"/>
                <input type="hidden" name="categoryId" value="@categoryId"/>

                <div>
                    <label class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1 block">
                        E-mailadres
                    </label>
                    <input type="email" name="email" placeholder="jouw@email.be"
                           class="w-full px-4 py-3 border-2 border-gray-100 rounded-xl
                                  focus:border-emerald-300 focus:outline-none text-sm"/>
                </div>

                <div>
                    <label class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1 block">
                        Telefoonnummer
                    </label>
                    <input type="tel" name="phoneNumber" placeholder="+32 ..."
                           class="w-full px-4 py-3 border-2 border-gray-100 rounded-xl
                                  focus:border-emerald-300 focus:outline-none text-sm"/>
                </div>

                <button type="submit"
                        class="mt-2 w-full py-3 bg-emerald-500 text-white font-semibold rounded-xl
                               hover:bg-emerald-600 transition-colors">
                    Opslaan
                </button>
            </form>
        }

        <a asp-action="Index" asp-route-projectId="@projectId" asp-route-categoryId="@categoryId"
           class="block text-center mt-3 text-sm text-gray-400 hover:text-gray-600 transition-colors">
            @(requestContactInfo ? "Overslaan" : "Sluiten")
        </a>

    </div>
</div>
