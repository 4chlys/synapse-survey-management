@inject IViewLocalizer L
@* AI Idea Support Chat Overlay
   Mobile  : bottom-sheet anchored to the viewport bottom.
   Desktop : centred modal with generous max-width and rounded corners.
   The loading indicator is rendered dynamically by ideasupportchat.ts
   so it always appears at the bottom of the chat instead of the top.
   The draft banner below is kept as a supplementary display only —
   the primary YES/NO confirmation is shown inline in the chat.
*@

<div id="idea-support-overlay"
     class="fixed inset-0 z-50 hidden items-end sm:items-center justify-center
            bg-black/50 backdrop-blur-sm p-0 sm:p-6">

    <div id="idea-support-panel"
         class="relative bg-base-100 flex flex-col shadow-2xl
                w-full max-w-full sm:max-w-xl md:max-w-2xl lg:max-w-3xl
                h-[88dvh] sm:h-[82dvh] md:h-[78dvh]
                rounded-t-[1.25rem] sm:rounded-[1.25rem]">

        @* Header *@
        <div class="flex items-center justify-between px-5 pt-5 pb-3 border-b border-base-300 flex-shrink-0">
            <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-full bg-primary/15 flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary" fill="none"
                         viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
                    </svg>
                </div>
                <div>
                    <p class="text-sm font-heading font-semibold text-base-content leading-none">@L["HeaderTitle"]</p>
                    <p class="text-xs text-primary mt-0.5">@L["HeaderSubtitle"]</p>
                </div>
            </div>
            <div class="flex items-center gap-1">
                @* Switch to traditional form *@
                <button id="idea-support-btn-switch"
                        type="button"
                        aria-label="@L["SwitchToForm"]"
                        title="@L["SwitchToFormTitle"]"
                        class="flex items-center gap-1.5 pl-2 pr-3 py-1.5 rounded-full text-xs
                               font-medium text-base-content/60 border border-base-300
                               hover:text-base-content hover:bg-base-200 transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 flex-shrink-0" fill="none"
                         viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5
                                 m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                    </svg>
                    <span>@L["SwitchToForm"]</span>
                </button>

                @* Close *@
                <button id="idea-support-btn-close"
                        type="button"
                        aria-label="@L["CloseAriaLabel"]"
                        class="w-8 h-8 flex items-center justify-center rounded-full text-base-content/40
                               hover:text-base-content hover:bg-base-200 transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none"
                         viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>
            </div>
        </div>

        @* Chat messages area — loading bubble is appended here dynamically by JS *@
        <div id="idea-support-messages"
             class="flex-1 overflow-y-auto px-4 py-4 flex flex-col gap-3 min-h-0">
        </div>

        @* External draft banner — supplementary; primary confirmation is inline in the chat *@
        <div id="idea-support-draft-banner"
             class="hidden mx-4 mb-3 rounded-2xl border-2 border-primary/30 bg-primary/10 p-4 flex-shrink-0">
            <p class="text-xs font-semibold text-primary uppercase tracking-wide mb-1.5">
                @L["DraftBannerHeading"]
            </p>
            <p id="idea-support-draft-text"
               class="text-sm text-base-content leading-relaxed"></p>
            <div class="flex gap-2 mt-3">
                <button id="idea-support-btn-use-draft"
                        type="button"
                        class="flex-1 py-2 rounded-xl bg-primary text-primary-content text-sm font-semibold
                               hover:bg-primary/90 active:scale-95 transition-all cursor-pointer">
                    @L["UseDraftButton"]
                </button>
                <button id="idea-support-btn-refine-draft"
                        type="button"
                        class="flex-1 py-2 rounded-xl border-2 border-base-300 text-base-content/70 text-sm font-medium
                               hover:bg-base-200 active:scale-95 transition-all cursor-pointer">
                    @L["RefineDraftButton"]
                </button>
            </div>
        </div>

        @* Input area *@
        <div class="px-4 pb-5 pt-2 flex-shrink-0 border-t border-base-300">
            <div class="flex gap-2 items-end">
                <textarea id="idea-support-input"
                          rows="1"
                          maxlength="1000"
                          placeholder="@L["InputPlaceholder"]"
                          class="flex-1 px-4 py-3 border-2 border-base-300 rounded-2xl bg-base-100
                                 text-base-content placeholder:text-base-content/40
                                 focus:border-primary focus:outline-none resize-none
                                 text-sm leading-relaxed transition-colors
                                 max-h-32 overflow-y-auto
                                 disabled:opacity-50 disabled:cursor-not-allowed"></textarea>
                <button id="idea-support-btn-send"
                        type="button"
                        aria-label="@L["SendAriaLabel"]"
                        class="w-11 h-11 rounded-2xl bg-primary flex items-center justify-center
                               text-primary-content hover:bg-primary/90 active:scale-95 transition-all
                               disabled:opacity-40 disabled:cursor-not-allowed flex-shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none"
                         viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
                    </svg>
                </button>
            </div>
            <p class="text-xs text-base-content/40 mt-2 text-center leading-relaxed">
                @L["FooterNote"]
            </p>
        </div>

    </div>
</div>
