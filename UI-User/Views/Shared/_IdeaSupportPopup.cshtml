@* AI Idea Support Chat Overlay
   Activated when a participant clicks the "add idea" button.
   The chat agent helps them articulate, refine, and submit an idea.
   Uses the same overlay pattern as _ModerationPopup.cshtml.
*@

<div id="idea-support-overlay"
     class="fixed inset-0 z-50 hidden items-end justify-center bg-black/50 backdrop-blur-sm">

    <div id="idea-support-panel"
         class="relative bg-white w-full max-w-sm flex flex-col shadow-2xl"
         style="height: 88dvh; border-radius: 1.25rem 1.25rem 0 0;">

        @* Header *@
        <div class="flex items-center justify-between px-5 pt-5 pb-3 border-b border-gray-100 flex-shrink-0">
            <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-full bg-emerald-100 flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-emerald-600" fill="none"
                         viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
                    </svg>
                </div>
                <div>
                    <p class="text-sm font-semibold text-gray-900 leading-none">Ideeënassistent</p>
                    <p class="text-xs text-emerald-600 mt-0.5">Stel je idee samen met AI</p>
                </div>
            </div>
            <button id="idea-support-btn-close"
                    type="button"
                    aria-label="Sluiten"
                    class="w-8 h-8 flex items-center justify-center rounded-full text-gray-400
                           hover:text-gray-600 hover:bg-gray-100 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none"
                     viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>
        </div>

        @* Chat messages area *@
        <div id="idea-support-messages"
             class="flex-1 overflow-y-auto px-4 py-4 flex flex-col gap-3 min-h-0">

            @* Skeleton / loading state shown on first open *@
            <div id="idea-support-loading"
                 class="flex gap-2 items-end hidden">
                <div class="w-7 h-7 rounded-full bg-emerald-100 flex items-center justify-center flex-shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-emerald-600" fill="none"
                         viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
                    </svg>
                </div>
                <div class="bg-gray-100 rounded-2xl rounded-bl-sm px-4 py-3 max-w-[80%]">
                    <div class="flex gap-1 items-center h-4">
                        <span class="w-1.5 h-1.5 bg-gray-400 rounded-full animate-bounce" style="animation-delay:0ms"></span>
                        <span class="w-1.5 h-1.5 bg-gray-400 rounded-full animate-bounce" style="animation-delay:150ms"></span>
                        <span class="w-1.5 h-1.5 bg-gray-400 rounded-full animate-bounce" style="animation-delay:300ms"></span>
                    </div>
                </div>
            </div>

        </div>

        @* Suggested draft banner *@
        <div id="idea-support-draft-banner"
             class="hidden mx-4 mb-3 rounded-2xl border-2 border-emerald-200 bg-emerald-50 p-4 flex-shrink-0">
            <p class="text-xs font-semibold text-emerald-700 uppercase tracking-wide mb-1.5">
                Jouw idee
            </p>
            <p id="idea-support-draft-text"
               class="text-sm text-gray-800 leading-relaxed"></p>
            <div class="flex gap-2 mt-3">
                <button id="idea-support-btn-use-draft"
                        type="button"
                        class="flex-1 py-2 rounded-xl bg-emerald-500 text-white text-sm font-semibold
                               hover:bg-emerald-600 active:scale-95 transition-all cursor-pointer">
                    Dit indienen
                </button>
                <button id="idea-support-btn-refine-draft"
                        type="button"
                        class="flex-1 py-2 rounded-xl border-2 border-gray-200 text-gray-600 text-sm font-medium
                               hover:border-gray-300 hover:bg-gray-50 active:scale-95 transition-all cursor-pointer">
                    Verfijnen
                </button>
            </div>
        </div>

        @* Input area *@
        <div class="px-4 pb-5 pt-2 flex-shrink-0 border-t border-gray-100">
            <div class="flex gap-2 items-end">
                <textarea id="idea-support-input"
                          rows="1"
                          maxlength="1000"
                          placeholder="Typ hier je bericht..."
                          class="flex-1 px-4 py-3 border-2 border-gray-100 rounded-2xl
                                 focus:border-emerald-300 focus:outline-none resize-none
                                 text-sm leading-relaxed transition-colors
                                 max-h-32 overflow-y-auto"></textarea>
                <button id="idea-support-btn-send"
                        type="button"
                        aria-label="Versturen"
                        class="w-11 h-11 rounded-2xl bg-emerald-500 flex items-center justify-center
                               text-white hover:bg-emerald-600 active:scale-95 transition-all
                               disabled:opacity-40 disabled:cursor-not-allowed flex-shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none"
                         viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
                    </svg>
                </button>
            </div>
            <p class="text-xs text-gray-400 mt-2 text-center leading-relaxed">
                De assistent helpt je om je idee te verwoorden — jij beslist wat er ingediend wordt.
            </p>
        </div>

    </div>
</div>
