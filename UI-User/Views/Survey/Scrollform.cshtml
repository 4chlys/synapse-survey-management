@using System.Text.Json
@using SynapseEnqueteManagement.UI.User.Helpers
@using SynapseEnqueteManagement.UI.User.Models
@using SynapseEnqueteManagement.UI.User.Models.Survey
@model SurveyViewModel
@inject IViewLocalizer L

@{
    ViewData["Title"] = L["Title"];
    ViewData["SurveyTitle"] = (ViewData["ProjectName"] as string) ?? Model.Title;
    ViewData["BgLogoCentered"] = true;
    var project = ViewData["Project"] as ProjectViewModel;
    var hasIntro = project is not null
                   && (!string.IsNullOrWhiteSpace(project.Introduction)
                       || !string.IsNullOrWhiteSpace(project.ProjectImage));
}

<div class="scroll-lock-marker hidden"></div>

@* Animated landing-style background logo shows on all sizes, cards lg+ only *@
@await Html.PartialAsync("_BackgroundAnimation")

<div id="survey-container" class="relative overflow-hidden page-enter z-10" style="height: var(--slide-h)" data-project-id="@Context.GetRouteValue("projectId")"
     data-has-session="@Model.HasSession.ToString().ToLower()">

    @* Progress bar *@
    <div class="absolute top-0 left-0 right-0 h-1 bg-base-300 z-10">
        <div id="survey-progress-bar" class="h-full bg-primary w-0 transition-[width] duration-500 ease-out"></div>
    </div>

    @* form for the survey — submit is hijacked by JS in survey/init.ts, which calls the SurveyApi controller *@
    <form id="survey-form" method="post" style="height: var(--slide-h)">

        @if (hasIntro)
        {
            <section class="survey-slide" data-format="Intro">
                <div class="w-full h-full flex items-center justify-center px-4 py-6">
                    <div class="survey-card w-full max-w-2xl bg-base-100 rounded-box shadow-xl border border-base-300
                        flex flex-col justify-between p-8 gap-4" style="max-height: calc(var(--slide-h) - 48px)">

                        <div class="flex-1 flex flex-col gap-5 overflow-y-auto min-h-0">
                            @if (!string.IsNullOrWhiteSpace(project!.ProjectImage))
                            {
                                <div class="shrink-0 relative">
                                    <img src="@project.ProjectImage" alt=""
                                         class="rounded-field max-h-64 w-full object-contain bg-base-200" />
                                    @if (project.IsAiGeneratedImage)
                                    {
                                        <span class="absolute bottom-2 right-2 bg-base-100/80 backdrop-blur-sm text-base-content/60 text-[10px] font-semibold px-2 py-0.5 rounded-full border border-base-300">
                                            AI
                                        </span>
                                    }
                                </div>
                            }

                            <h2 class="font-heading text-[22px] font-semibold text-base-content leading-snug shrink-0">
                                @(string.IsNullOrWhiteSpace(project.Name) ? project.OrganisationName : project.Name)
                            </h2>

                            @if (!string.IsNullOrWhiteSpace(project.Introduction))
                            {
                                @* Trust boundary: Introduction contains admin-authored Quill HTML.
                                   Html.Raw is intentional — Quill emits markup that must render as-is.
                                   The value is sanitized with HtmlSanitizer on ingest in
                                   ProjectsController.MapIntroductions, so script injection and
                                   dangerous attributes are stripped before the content reaches the DB. *@
                                <div class="prose prose-sm max-w-none text-base-content/80">
                                    @Html.Raw(project.Introduction)
                                </div>
                            }
                        </div>

                        <div class="flex items-center justify-end shrink-0">
                            <button type="button" aria-label="@L["NextQuestion"]"
                                    class="btn-next w-9 h-9 rounded-full bg-primary flex items-center justify-center shadow-md hover:opacity-90 active:scale-95 transition-all cursor-pointer">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary-content" fill="none"
                                     viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                                </svg>
                            </button>
                        </div>

                    </div>
                </div>
            </section>
        }

        @foreach (var question in Model.Questions)
        {
            @* Slide card for each question *@
            <section class="survey-slide" data-question-id="@question.QuestionId" data-format="@question.Format.ToString()"
                     data-mandatory="@question.IsMandatory.ToString().ToLower()" data-position="@question.Position">

                @* Centering container *@
                <div class="w-full h-full flex items-center justify-center px-4 py-6">

                    @* Floating card *@
                    <div class="survey-card w-full max-w-2xl bg-base-100 rounded-box shadow-xl border border-base-300
                        flex flex-col justify-between p-8 gap-4" style="max-height: calc(var(--slide-h) - 48px)">

                        @* Counter *@
                        <div class="flex items-center gap-2 shrink-0">
                            <span class="text-xs font-semibold text-base-content/60 tracking-widest uppercase">
                                @L["QuestionLabel"] <span class="q-number">@question.QuestionNumber</span>
                            </span>
                            @if (question.IsMandatory)
                            {
                                <span class="w-1.5 h-1.5 rounded-full bg-accent inline-block" title="@L["Mandatory"]"></span>
                            }
                        </div>

                        @* Question text + answer area (mc, sc, open and likert) *@
                        <div class="flex-1 flex flex-col gap-5 overflow-y-auto min-h-0">

                            @if (question.MediaType.HasValue)
                            {
                                <div class="question-media shrink-0">
                                    @if (question.MediaType == QuestionMediaType.Image)
                                    {
                                        <img src="@question.MediaUrl" alt=""
                                             class="rounded-field max-h-64 w-full object-contain bg-base-200" />
                                    }
                                    else if (question.MediaType == QuestionMediaType.Video && question.MediaIsEmbed)
                                    {
                                        @if (question.MediaUrl.Contains("youtube.com/embed") || question.MediaUrl.Contains("player.vimeo.com"))
                                        {
                                            <div class="aspect-video rounded-field overflow-hidden bg-black">
                                                <iframe src="@question.MediaUrl" class="w-full h-full"
                                                        title="Video"
                                                        sandbox="allow-scripts allow-same-origin allow-presentation"
                                                        allow="accelerometer; encrypted-media; picture-in-picture"
                                                        loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
                                            </div>
                                        }
                                        else
                                        {
                                            <video controls preload="metadata" class="rounded-field max-h-64 w-full bg-black"
                                                   src="@question.MediaUrl"></video>
                                        }
                                    }
                                    else if (question.MediaType == QuestionMediaType.Video)
                                    {
                                        <video controls preload="metadata" class="rounded-field max-h-64 w-full bg-black"
                                               src="@question.MediaUrl"></video>
                                    }
                                    else if (question.MediaType == QuestionMediaType.Audio)
                                    {
                                        <audio controls preload="metadata" class="w-full" src="@question.MediaUrl"></audio>
                                    }
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(question.MediaText))
                            {
                                <div class="prose prose-sm max-w-none text-base-content/80 shrink-0">
                                    @Html.Raw(MarkdownRenderer.Render(question.MediaText))
                                </div>
                            }

                            <h2 class="font-heading text-[22px] font-semibold text-base-content leading-snug shrink-0">
                                @question.Text
                            </h2>

                            <div class="slide-answer-area flex flex-col gap-2">

                                @* Multiple choice *@
                                @if (question.Format == QuestionFormat.MultipleChoice)
                                {
                                    foreach (var choice in question.AnswerChoices)
                                    {
                                        <label class="group flex items-center gap-4 px-6 py-5 rounded-field border border-base-300 bg-base-100 cursor-pointer transition-all duration-150
                                            hover:border-primary/50 hover:bg-primary/5
                                            has-[input:checked]:border-primary has-[input:checked]:bg-primary/15">
                                            <div class="relative shrink-0 w-5 h-5 group">
                                                <input type="checkbox" name="q_@question.QuestionId" value="@choice"
                                                       class="peer absolute inset-0 w-full h-full opacity-0 cursor-pointer m-0" />
                                                <div class="w-5 h-5 rounded-md border-2 border-base-300 bg-base-100
                                                    flex items-center justify-center pointer-events-none
                                                    peer-checked:bg-primary peer-checked:border-primary
                                                    transition-all duration-150">
                                                    <svg xmlns="http://www.w3.org/2000/svg"
                                                         class="h-3 w-3 text-white opacity-0 group-has-checked:opacity-100 transition-opacity"
                                                         fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3.5">
                                                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                                                    </svg>
                                                </div>
                                            </div>
                                            <span
                                            class="text-base-content text-[15px] font-medium leading-snug select-none">@choice</span>
                                        </label>
                                    }
                                }

                                @* Single choice *@
                                else if (question.Format == QuestionFormat.SingleChoice)
                                {
                                    foreach (var choice in question.AnswerChoices)
                                    {
                                        <label class="group flex items-center gap-4 px-6 py-5 rounded-field border border-base-300 bg-base-100 cursor-pointer transition-all duration-150
                                            hover:border-primary/50 hover:bg-primary/5
                                            has-[input:checked]:border-primary has-[input:checked]:bg-primary/15">
                                            <div class="relative shrink-0 w-5 h-5 group">
                                                <input type="radio" name="q_@question.QuestionId" value="@choice"
                                                       class="peer absolute inset-0 w-full h-full opacity-0 cursor-pointer m-0" />
                                                <div class="w-5 h-5 rounded-full border-2 border-base-300 bg-base-100
                                                    flex items-center justify-center pointer-events-none
                                                    peer-checked:bg-primary peer-checked:border-primary
                                                    transition-all duration-150">
                                                    <div
                                                        class="w-2 h-2 rounded-full bg-white opacity-0 group-has-checked:opacity-100 transition-opacity">
                                                    </div>
                                                </div>
                                            </div>
                                            <span
                                            class="text-base-content text-[15px] font-medium leading-snug select-none">@choice</span>
                                        </label>
                                    }
                                }

                                @* Likert *@
                                else if (question.Format == QuestionFormat.Likert)
                                {
                                    <div class="px-1">
                                        <div class="flex justify-between text-[13px] text-base-content/70 mb-4 font-medium">
                                            <span>@L["LikertDisagree"]</span>
                                            <span>@L["LikertAgree"]</span>
                                        </div>
                                        <input type="range" name="q_@question.QuestionId" min="1" max="10" value="5"
                                               class="w-full cursor-pointer h-2" style="accent-color: var(--color-primary);" />
                                        <div class="flex justify-between text-xs text-base-content/50 mt-3">
                                            @for (int i = 1; i <= 10; i++)
                                            {
                                                <span>@i</span>
                                            }
                                        </div>
                                    </div>
                                }

                                @* ── Open text *@
                                else if (question.Format == QuestionFormat.Open)
                                {
                                    <div>
                                        <textarea id="q_@question.QuestionId" name="q_@question.QuestionId" rows="5" maxlength="500"
                                                  placeholder="@L["AnswerPlaceholder"]" class="w-full border border-base-300 rounded-field px-5 py-4 text-[15px] text-base-content bg-base-100
                                        placeholder:text-base-content/35 focus:outline-none focus:border-primary
                                        resize-none transition-colors leading-relaxed"></textarea>
                                        <div class="flex items-center justify-between mt-1.5">
                                            <partial name="_MicButton"
                                                     model="@(new MicButtonModel(TargetSelector: $"#q_{question.QuestionId}", SizeClass: "w-9 h-9"))" />
                                            <p class="text-xs text-base-content/40 textarea-counter">0 / 500</p>
                                        </div>
                                    </div>
                                }

                            </div>
                        </div>

                        @* navigation *@
                        <div class="flex items-center justify-between shrink-0">
                            <p class="text-[13px] text-base-content/50">@L["SwipeHint"]</p>
                            <div class="flex gap-2">
                                <button type="button" aria-label="@L["PrevQuestion"]"
                                        class="btn-prev w-9 h-9 rounded-full bg-base-200 border border-base-300 flex items-center justify-center shadow-sm hover:border-primary hover:text-primary active:scale-95 transition-all disabled:opacity-25 disabled:cursor-not-allowed cursor-pointer">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-base-content" fill="none"
                                         viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7" />
                                    </svg>
                                </button>
                                <button type="button" aria-label="@L["NextQuestion"]"
                                        class="btn-next w-9 h-9 rounded-full bg-primary flex items-center justify-center shadow-md hover:opacity-90 active:scale-95 transition-all cursor-pointer">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary-content" fill="none"
                                         viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                                    </svg>
                                </button>
                            </div>
                        </div>

                    </div>
                </div>
            </section>
        }

        @* Submit slide *@
        <section class="survey-slide" data-format="Submit">
            <div class="w-full h-full flex items-center justify-center px-4 py-6">
                <div class="survey-card w-full max-w-2xl bg-base-100 rounded-box shadow-xl border border-base-300
                    flex flex-col items-center justify-center gap-8 p-10">

                    <div class="flex flex-col items-center gap-4 text-center">
                        <div class="flex items-center gap-1.5 text-xs font-semibold tracking-widest uppercase text-primary/70 mb-1">
                            <span class="w-5 h-[2px] rounded bg-primary/40"></span>
                            @L["StepIndicator"]
                            <span class="w-5 h-[2px] rounded bg-primary/40"></span>
                        </div>
                        <div class="w-20 h-20 rounded-box bg-primary/10 flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-primary" fill="none"
                                 viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                      d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                            </svg>
                        </div>
                        <div>
                            <h2 class="font-heading text-2xl font-bold text-base-content mb-2">@L["SubmitSlideHeading"]</h2>
                            <p class="text-base-content/75 text-sm leading-relaxed max-w-55">
                                @L["SubmitSlideDescription"]
                            </p>
                        </div>
                    </div>

                    <button type="submit"
                            class="btn btn-primary w-full max-w-xs rounded-field font-heading font-semibold py-4 h-auto text-base gap-2">
                        @L["SubmitAnswers"]
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24"
                             stroke="currentColor" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                        </svg>
                    </button>

                </div>
            </div>
        </section>

    </form>

</div>

@* Existing responses for resume support *@
@if (Model.ExistingResponses.Count > 0)
{
    <script type="application/json" id="existing-responses">@Html.Raw(JsonSerializer.Serialize(Model.ExistingResponses))</script>
}

@{ ViewData["ThankYouRedirectUrl"] = Url.Action("CategoryList", "Category", new { projectId = Context.GetRouteValue("projectId") }); }
@await Html.PartialAsync("_FinalThankYouPopup")
