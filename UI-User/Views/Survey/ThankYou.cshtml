@model ThankYouViewModel
@inject IViewLocalizer L
@{
    ViewData["Title"] = "Bedankt";
}

<div class="flex flex-col items-center justify-center min-h-[calc(100dvh-64px)] page-enter px-6 py-12">
    <div class="w-full max-w-xs">

        <div class="bg-base-100 rounded-2xl border border-base-300 shadow-sm overflow-hidden">

            @* Accent strip *@
            <div class="h-1 accent-strip w-full"></div>

            <div class="px-8 pt-10 pb-8 flex flex-col items-center text-center gap-6">

                @* Success icon *@
                <div class="w-20 h-20 rounded-2xl bg-secondary/25 flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-11 w-11 text-secondary" fill="none"
                         viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                </div>

                <div>
                    <h2 class="font-heading text-2xl font-bold text-base-content mb-2 leading-tight">
                        @L["ThankYouHeading"]
                    </h2>
                    <p class="text-[15px] text-base-content/75 leading-relaxed">
                        @L["ThankYouBody"]
                    </p>
                </div>

                <a asp-controller="Category" asp-action="CategoryList" asp-route-projectId="@Model.ProjectId"
                       class="btn btn-primary w-full rounded-xl font-heading font-semibold text-base py-4 h-auto gap-2">
                    @L["ViewIdeasButton"]
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24"
                         stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                    </svg>
                </a>

                @if (!string.IsNullOrEmpty(Model.OrganisationLogoUrl))
                {
                    <img src="@Model.OrganisationLogoUrl" alt="@Model.OrganisationName"
                         class="h-7 object-contain opacity-40" />
                }

            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.OrganisationWebsiteUrl))
        {
            <div class="text-center mt-5">
                <a href="@Model.OrganisationWebsiteUrl" target="_blank" rel="noopener noreferrer"
                       class="text-xs text-neutral/50 hover:text-primary transition-colors">
                    @Model.OrganisationWebsiteUrl
                </a>
            </div>
        }

    </div>
</div>
