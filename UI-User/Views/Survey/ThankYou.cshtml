@model ThankYouViewModel
@{
    ViewData["Title"] = "Bedankt";
}

<div class="flex flex-col items-center justify-center min-h-[calc(100dvh-64px)] px-6 text-center">

    <div class="w-full max-w-sm flex flex-col items-center gap-6">

        <div class="w-16 h-16 rounded-2xl bg-secondary/10 border border-secondary/20 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
        </div>

        <div>
            <h2 class="font-heading text-2xl font-semibold text-base-content mb-2">Bedankt voor je antwoorden!</h2>
            <p class="text-neutral text-sm leading-relaxed max-w-xs">
                Jouw bijdrage helpt ons het mentaal welzijn op school te verbeteren.
            </p>
        </div>

        @if (!string.IsNullOrEmpty(Model.OrganisationLogoUrl))
        {
            <img src="@Model.OrganisationLogoUrl" alt="@Model.OrganisationName" class="h-10 object-contain" />
        }

        @if (!string.IsNullOrEmpty(Model.OrganisationWebsiteUrl))
        {
            <a href="@Model.OrganisationWebsiteUrl" target="_blank" rel="noopener noreferrer"
               class="text-xs text-neutral/60 hover:text-primary transition-colors">
                @Model.OrganisationWebsiteUrl
            </a>
        }

        <a asp-controller="Category" asp-action="Index" asp-route-projectId="@Model.ProjectId"
           class="btn btn-primary w-full rounded-xl font-heading font-semibold">
            Ga naar ideation
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
            </svg>
        </a>

    </div>
</div>
