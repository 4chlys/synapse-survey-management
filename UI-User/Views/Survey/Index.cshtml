@model SynapseEnqueteManagement.UI.User.Models.SurveyViewModel

@{
    ViewData["Title"] = "Enquête";
    ViewData["SurveyTitle"] = Model.Title;
}

<div id="survey-container" class="relative overflow-hidden" style="height: var(--slide-h)">

    @* Progress bar *@
    <div class="absolute top-0 left-0 right-0 h-0.5 bg-gray-200 z-10">
        <div id="survey-progress-bar"
             class="h-full bg-emerald-500 w-0 transition-[width] duration-500 ease-out"></div>
    </div>

    @* Floating nav buttons *@
    <div class="absolute right-4 bottom-8 z-20 flex flex-col gap-3">
        <button id="btn-prev"
                aria-label="Vorige vraag"
                class="w-11 h-11 rounded-full bg-white shadow-lg border border-gray-200 flex items-center justify-center text-gray-600 hover:bg-gray-50 active:scale-95 transition-all disabled:opacity-30 disabled:cursor-not-allowed">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7" />
            </svg>
        </button>
        <button id="btn-next"
                aria-label="Volgende vraag"
                class="w-11 h-11 rounded-full bg-emerald-500 shadow-lg flex items-center justify-center text-white hover:bg-emerald-600 active:scale-95 transition-all">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
        </button>
    </div>

    @* Form wraps the entire track so all inputs are submitted together *@
    <form id="survey-form" method="post" asp-controller="Survey" asp-action="Submit" asp-route-projectId="@Context.GetRouteValue("projectId")">

        <div id="survey-track" class="flex flex-col" style="transform: translateY(0)">

            @foreach (var question in Model.Questions)
            {
                <section class="survey-slide flex flex-col justify-between px-6 pt-8 pb-10 bg-white"
                         style="height: var(--slide-h)"
                         data-question-id="@question.QuestionId"
                         data-format="@question.Format.ToString()">

                    @* Question counter *@
                    <p class="text-xs font-semibold tracking-widest uppercase text-gray-400">
                        Vraag @question.QuestionNumber van @question.TotalQuestions
                    </p>

                    @* Question body *@
                    <div class="flex-1 flex flex-col justify-center">
                        <h2 class="text-gray-900 text-xl font-semibold leading-snug mb-6">
                            @question.Text
                        </h2>

                        <div class="slide-answer-area">

                            @if (question.Format == QuestionFormat.MultipleChoice)
                            {
                                foreach (var choice in question.AnswerChoices)
                                {
                                    <label class="flex items-center gap-4 px-5 py-3.5 rounded-2xl border-2 border-gray-100 cursor-pointer transition-colors duration-150 mb-2 hover:border-emerald-200 has-[input:checked]:border-emerald-500 has-[input:checked]:bg-emerald-50">
                                        <input type="checkbox"
                                               name="q_@question.QuestionId"
                                               value="@choice"
                                               class="w-4 h-4 accent-emerald-600 cursor-pointer flex-shrink-0" />
                                        <span class="text-gray-800 text-sm font-medium">@choice</span>
                                    </label>
                                }
                            }
                            else if (question.Format == QuestionFormat.SingleChoice)
                            {
                                foreach (var choice in question.AnswerChoices)
                                {
                                    <label class="flex items-center gap-4 px-5 py-3.5 rounded-2xl border-2 border-gray-100 cursor-pointer transition-colors duration-150 mb-2 hover:border-emerald-200 has-[input:checked]:border-emerald-500 has-[input:checked]:bg-emerald-50">
                                        <input type="radio"
                                               name="q_@question.QuestionId"
                                               value="@choice"
                                               class="w-4 h-4 accent-emerald-600 cursor-pointer flex-shrink-0" />
                                        <span class="text-gray-800 text-sm font-medium">@choice</span>
                                    </label>
                                }
                            }
                            else if (question.Format == QuestionFormat.Likert)
                            {
                                <div class="pt-2">
                                    <div class="flex justify-between text-xs text-gray-400 mb-3 px-1">
                                        <span>1 — Helemaal oneens</span>
                                        <span>10 — Helemaal eens</span>
                                    </div>
                                    <input type="range"
                                           name="q_@question.QuestionId"
                                           min="1" max="10" value="5"
                                           class="w-full accent-emerald-600 cursor-pointer h-2" />
                                    <div class="flex justify-between text-xs text-gray-400 mt-2 px-1">
                                        @for (int i = 1; i <= 10; i++)
                                        {
                                            <span>@i</span>
                                        }
                                    </div>
                                </div>
                            }
                            else if (question.Format == QuestionFormat.Open)
                            {
                                <textarea name="q_@question.QuestionId"
                                          rows="4"
                                          placeholder="Typ hier je antwoord..."
                                          class="w-full border-2 border-gray-100 rounded-2xl p-4 text-sm text-gray-800 placeholder-gray-400 focus:outline-none focus:border-emerald-400 resize-none transition-colors"></textarea>
                            }

                        </div>
                    </div>

                    @* Bottom hint *@
                    <p class="text-xs text-gray-400 text-center">
                        Swipe omhoog of druk ↓ voor de volgende vraag
                    </p>

                </section>
            }

            @* Submit slide *@
            <section class="survey-slide flex flex-col items-center justify-center gap-6 px-8 bg-white"
                     style="height: var(--slide-h)"
                     data-format="Submit">

                <div class="w-20 h-20 bg-emerald-100 rounded-full flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                </div>

                <div class="text-center">
                    <h2 class="text-2xl font-semibold text-gray-900 mb-2">Klaar!</h2>
                    <p class="text-gray-500 text-sm">Controleer je antwoorden en stuur ze in.</p>
                </div>

                <button type="submit"
                        class="w-full max-w-xs bg-emerald-500 hover:bg-emerald-600 active:bg-emerald-700 text-white font-semibold py-4 rounded-2xl text-sm tracking-wide transition-colors shadow-lg">
                    Antwoorden versturen
                </button>

            </section>

        </div>
    </form>

</div>
