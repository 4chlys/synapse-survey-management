@using System.Text.Json
@model SurveyViewModel

@{
    ViewData["Title"] = "Enquête";
    ViewData["SurveyTitle"] = Model.Title;
}

<div id="survey-container" class="relative overflow-hidden page-enter" style="height: var(--slide-h)" data-project-id="@Context.GetRouteValue("projectId")"
     data-has-session="@Model.HasSession.ToString().ToLower()">

    @* Progress bar *@
    <div class="absolute top-0 left-0 right-0 h-1 bg-base-300 z-10">
        <div id="survey-progress-bar" class="h-full bg-primary w-0 transition-[width] duration-500 ease-out"></div>
    </div>

    @* form for the survey *@
    <form id="survey-form" method="post" asp-controller="Survey" asp-action="Submit"
          asp-route-projectId="@Context.GetRouteValue("projectId")" style="height: var(--slide-h)">

        @foreach (var question in Model.Questions)
        {
            @* Slide card for each question *@
            <section class="survey-slide" data-question-id="@question.QuestionId" data-format="@question.Format.ToString()"
                     data-mandatory="@question.IsMandatory.ToString().ToLower()" data-position="@question.Position">

                @* Centering container *@
                <div class="w-full h-full flex items-center justify-center px-4 py-6">

                    @* Floating card *@
                    <div class="w-full max-w-2xl bg-base-100 rounded-2xl shadow-xl border border-base-300
                        flex flex-col justify-between p-8 gap-4" style="max-height: calc(var(--slide-h) - 48px)">

                        @* Counter *@
                        <div class="flex items-center gap-2 shrink-0">
                            <span class="text-xs font-semibold text-base-content/60 tracking-widest uppercase">
                                @question.QuestionNumber / @question.TotalQuestions
                            </span>
                            @if (question.IsMandatory)
                            {
                                <span class="w-1.5 h-1.5 rounded-full bg-accent inline-block" title="Verplicht"></span>
                            }
                        </div>

                        @* Question text + answer area (mc, sc, open,...) *@
                        <div class="flex-1 flex flex-col gap-5 overflow-y-auto min-h-0">

                            <h2 class="font-heading text-[22px] font-semibold text-base-content leading-snug shrink-0">
                                @question.Text
                            </h2>

                            <div class="slide-answer-area flex flex-col gap-2">

                                @* Multiple choice *@
                                @if (question.Format == QuestionFormat.MultipleChoice)
                                {
                                    foreach (var choice in question.AnswerChoices)
                                    {
                                        <label class="group flex items-center gap-4 px-6 py-5 rounded-xl border border-base-300 bg-base-100 cursor-pointer transition-all duration-150
                                            hover:border-primary/50 hover:bg-primary/5
                                            has-[input:checked]:border-primary has-[input:checked]:bg-primary/15">
                                            <div class="relative shrink-0 w-5 h-5 group">
                                                <input type="checkbox" name="q_@question.QuestionId" value="@choice"
                                                       class="peer absolute inset-0 w-full h-full opacity-0 cursor-pointer m-0" />
                                                <div class="w-5 h-5 rounded-md border-2 border-base-300 bg-base-100
                                                    flex items-center justify-center pointer-events-none
                                                    peer-checked:bg-primary peer-checked:border-primary
                                                    transition-all duration-150">
                                                    <svg xmlns="http://www.w3.org/2000/svg"
                                                         class="h-3 w-3 text-white opacity-0 group-has-checked:opacity-100 transition-opacity"
                                                         fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3.5">
                                                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                                                    </svg>
                                                </div>
                                            </div>
                                            <span
                                            class="text-base-content text-[15px] font-medium leading-snug select-none">@choice</span>
                                        </label>
                                    }
                                }

                                @* Single choice *@
                                else if (question.Format == QuestionFormat.SingleChoice)
                                {
                                    foreach (var choice in question.AnswerChoices)
                                    {
                                        <label class="group flex items-center gap-4 px-6 py-5 rounded-xl border border-base-300 bg-base-100 cursor-pointer transition-all duration-150
                                            hover:border-primary/50 hover:bg-primary/5
                                            has-[input:checked]:border-primary has-[input:checked]:bg-primary/15">
                                            <div class="relative shrink-0 w-5 h-5 group">
                                                <input type="radio" name="q_@question.QuestionId" value="@choice"
                                                       class="peer absolute inset-0 w-full h-full opacity-0 cursor-pointer m-0" />
                                                <div class="w-5 h-5 rounded-full border-2 border-base-300 bg-base-100
                                                    flex items-center justify-center pointer-events-none
                                                    peer-checked:bg-primary peer-checked:border-primary
                                                    transition-all duration-150">
                                                    <div
                                                        class="w-2 h-2 rounded-full bg-white opacity-0 group-has-checked:opacity-100 transition-opacity">
                                                    </div>
                                                </div>
                                            </div>
                                            <span
                                            class="text-base-content text-[15px] font-medium leading-snug select-none">@choice</span>
                                        </label>
                                    }
                                }

                                @* Likert *@
                                else if (question.Format == QuestionFormat.Likert)
                                {
                                    <div class="px-1">
                                        <div class="flex justify-between text-[13px] text-base-content/70 mb-4 font-medium">
                                            <span>Helemaal oneens</span>
                                            <span>Helemaal eens</span>
                                        </div>
                                        <input type="range" name="q_@question.QuestionId" min="1" max="10" value="5"
                                               class="w-full accent-[oklch(52%_0.22_277)] cursor-pointer h-2" />
                                        <div class="flex justify-between text-xs text-base-content/50 mt-3">
                                            @for (int i = 1; i <= 10; i++)
                                            {
                                                <span>@i</span>
                                            }
                                        </div>
                                    </div>
                                }

                                @* ── Open text *@
                                else if (question.Format == QuestionFormat.Open)
                                {
                                    <div>
                                        <textarea name="q_@question.QuestionId" rows="5" maxlength="500"
                                                  placeholder="Typ hier je antwoord..." class="w-full border border-base-300 rounded-xl px-5 py-4 text-[15px] text-base-content bg-base-100
                                        placeholder:text-base-content/35 focus:outline-none focus:border-primary
                                        resize-none transition-colors leading-relaxed"></textarea>
                                        <p class="text-xs text-base-content/40 text-right mt-1.5 textarea-counter">0 / 500</p>
                                    </div>
                                }

                            </div>
                        </div>

                        @* navigation *@
                        <div class="flex items-center justify-between shrink-0">
                            <p class="text-[13px] text-base-content/50">Swipe of druk ↓ voor volgende</p>
                            <div class="flex gap-2">
                                <button type="button" aria-label="Vorige vraag"
                                        class="btn-prev w-9 h-9 rounded-full bg-base-200 border border-base-300 flex items-center justify-center shadow-sm hover:border-primary hover:text-primary active:scale-95 transition-all disabled:opacity-25 disabled:cursor-not-allowed cursor-pointer">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-base-content" fill="none"
                                         viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7" />
                                    </svg>
                                </button>
                                <button type="button" aria-label="Volgende vraag"
                                        class="btn-next w-9 h-9 rounded-full bg-primary flex items-center justify-center shadow-md hover:opacity-90 active:scale-95 transition-all cursor-pointer">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-base-content" fill="none"
                                         viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                                    </svg>
                                </button>
                            </div>
                        </div>

                    </div>
                </div>
            </section>
        }

        @* Submit slide *@
        <section class="survey-slide" data-format="Submit">
            <div class="w-full h-full flex items-center justify-center px-4 py-6">
                <div class="w-full max-w-2xl bg-base-100 rounded-2xl shadow-xl border border-base-300
                    flex flex-col items-center justify-center gap-8 p-10">

                    <div class="flex flex-col items-center gap-4 text-center">
                        <div class="w-20 h-20 rounded-2xl bg-secondary/25 flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-secondary" fill="none"
                                 viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                            </svg>
                        </div>
                        <div>
                            <h2 class="font-heading text-2xl font-bold text-base-content mb-2">Klaar!</h2>
                            <p class="text-base-content/75 text-sm leading-relaxed max-w-55">
                                Controleer je antwoorden en stuur ze in.
                            </p>
                        </div>
                    </div>

                    <button type="submit"
                            class="btn btn-primary w-full max-w-xs rounded-xl font-heading font-semibold py-4 h-auto text-base">
                        Antwoorden versturen
                    </button>

                </div>
            </div>
        </section>

    </form>

</div>

@* Existing responses for resume support *@
@if (Model.ExistingResponses.Count > 0)
{
    <script type="application/json" id="existing-responses">@Html.Raw(JsonSerializer.Serialize(Model.ExistingResponses))</script>
}
