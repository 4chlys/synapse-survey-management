@model SurveyViewModel

@{
    ViewData["Title"] = "Enquête";
    ViewData["SurveyTitle"] = Model.Title;
}

<div id="survey-container" class="relative overflow-hidden" style="height: var(--slide-h)">

    @* Progress bar *@
    <div class="absolute top-0 left-0 right-0 h-0.5 bg-base-300 z-10">
        <div id="survey-progress-bar"
             class="h-full bg-primary w-0 transition-[width] duration-500 ease-out"></div>
    </div>

    @* Floating nav buttons *@
    <div class="absolute right-4 bottom-8 z-20 flex flex-col gap-2">
        <button id="btn-prev"
                aria-label="Vorige vraag"
                class="w-11 h-11 rounded-full bg-base-100 border border-base-300 flex items-center justify-center text-neutral shadow-sm hover:border-primary hover:text-primary active:scale-95 transition-all disabled:opacity-25 disabled:cursor-not-allowed cursor-pointer">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7" />
            </svg>
        </button>
        <button id="btn-next"
                aria-label="Volgende vraag"
                class="w-11 h-11 rounded-full bg-primary flex items-center justify-center text-primary-content shadow-md hover:opacity-90 active:scale-95 transition-all cursor-pointer">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
        </button>
    </div>

    @* Form wraps the entire track so all inputs are submitted together *@
    <form id="survey-form" method="post" asp-controller="Survey" asp-action="Submit" asp-route-projectId="@Context.GetRouteValue("projectId")">

        <div id="survey-track" class="flex flex-col" style="transform: translateY(0)">

            @foreach (var question in Model.Questions)
            {
                <section class="survey-slide flex flex-col justify-between px-6 pt-10 pb-10 bg-base-100"
                         style="height: var(--slide-h)"
                         data-question-id="@question.QuestionId"
                         data-format="@question.Format.ToString()"
                         data-mandatory="@question.IsMandatory.ToString().ToLower()">

                    @* Question counter badge *@
                    <div>
                        <span class="inline-flex items-center gap-1.5 text-xs font-semibold tracking-widest uppercase text-neutral">
                            <span class="w-5 h-5 rounded-full bg-primary/10 text-primary flex items-center justify-center text-[10px] font-bold">
                                @question.QuestionNumber
                            </span>
                            van @question.TotalQuestions
                            @if (question.IsMandatory)
                            {
                                <span class="w-1.5 h-1.5 rounded-full bg-accent inline-block"></span>
                            }
                        </span>
                    </div>

                    @* Question body *@
                    <div class="flex-1 flex flex-col justify-center gap-6">
                        <h2 class="font-heading text-base-content text-2xl font-semibold leading-snug">
                            @question.Text
                        </h2>

                        <div class="slide-answer-area">

                            @if (question.Format == QuestionFormat.MultipleChoice)
                            {
                                foreach (var choice in question.AnswerChoices)
                                {
                                    <label class="flex items-center gap-4 px-5 py-4 rounded-xl border border-base-300 bg-base-100 cursor-pointer transition-all duration-150 mb-2
                                                  hover:border-primary/40 hover:bg-primary/5
                                                  has-[input:checked]:border-primary has-[input:checked]:bg-primary/8">
                                        <input type="checkbox"
                                               name="q_@question.QuestionId"
                                               value="@choice"
                                               class="w-4 h-4 accent-[oklch(52%_0.22_277)] cursor-pointer flex-shrink-0" />
                                        <span class="text-base-content text-sm font-medium">@choice</span>
                                    </label>
                                }
                            }
                            else if (question.Format == QuestionFormat.SingleChoice)
                            {
                                foreach (var choice in question.AnswerChoices)
                                {
                                    <label class="flex items-center gap-4 px-5 py-4 rounded-xl border border-base-300 bg-base-100 cursor-pointer transition-all duration-150 mb-2
                                                  hover:border-primary/40 hover:bg-primary/5
                                                  has-[input:checked]:border-primary has-[input:checked]:bg-primary/8">
                                        <input type="radio"
                                               name="q_@question.QuestionId"
                                               value="@choice"
                                               class="w-4 h-4 accent-[oklch(52%_0.22_277)] cursor-pointer flex-shrink-0" />
                                        <span class="text-base-content text-sm font-medium">@choice</span>
                                    </label>
                                }
                            }
                            else if (question.Format == QuestionFormat.Likert)
                            {
                                <div>
                                    <div class="flex justify-between text-xs text-neutral mb-4 px-1">
                                        <span>Helemaal oneens</span>
                                        <span>Helemaal eens</span>
                                    </div>
                                    <input type="range"
                                           name="q_@question.QuestionId"
                                           min="1" max="10" value="5"
                                           class="w-full accent-[oklch(52%_0.22_277)] cursor-pointer h-2" />
                                    <div class="flex justify-between text-xs text-neutral mt-3 px-0.5">
                                        @for (int i = 1; i <= 10; i++)
                                        {
                                            <span>@i</span>
                                        }
                                    </div>
                                </div>
                            }
                            else if (question.Format == QuestionFormat.Open)
                            {
                                <div>
                                    <textarea name="q_@question.QuestionId"
                                              rows="4"
                                              maxlength="500"
                                              placeholder="Typ hier je antwoord..."
                                              class="w-full border border-base-300 rounded-xl p-4 text-sm text-base-content bg-base-100 placeholder:text-neutral/50 focus:outline-none focus:border-primary resize-none transition-colors"></textarea>
                                    <p class="text-xs text-neutral/60 text-right mt-1 textarea-counter">0 / 500</p>
                                </div>
                            }

                        </div>
                    </div>

                    @* Bottom hint *@
                    <p class="text-xs text-neutral/50 text-center">
                        Swipe omhoog of druk ↓ voor de volgende vraag
                    </p>

                </section>
            }

            @* Submit slide *@
            <section class="survey-slide flex flex-col items-center justify-center gap-8 px-8 bg-base-100"
                     style="height: var(--slide-h)"
                     data-format="Submit">

                <div class="flex flex-col items-center gap-4 text-center">
                    <div class="w-20 h-20 rounded-2xl bg-secondary/10 border border-secondary/20 flex items-center justify-center">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                        </svg>
                    </div>
                    <div>
                        <h2 class="font-heading text-2xl font-semibold text-base-content mb-1">Klaar!</h2>
                        <p class="text-neutral text-sm">Controleer je antwoorden en stuur ze in.</p>
                    </div>
                </div>

                <button type="submit"
                        class="btn btn-primary w-full max-w-xs rounded-xl font-heading font-semibold">
                    Antwoorden versturen
                </button>

            </section>

        </div>
    </form>

</div>
