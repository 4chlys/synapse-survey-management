@inject IViewLocalizer L
@{
    ViewData["Title"] = L["Title"].Value;
}

<div class="flex flex-col items-center justify-center min-h-content page-enter px-6">
    <div class="w-full max-w-sm text-center">

        <div class="w-16 h-16 mx-auto mb-6 rounded-box bg-warning/10 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-warning" fill="none" viewBox="0 0 24 24"
                 stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
            </svg>
        </div>

        <h1 class="font-heading text-2xl font-semibold text-base-content mb-2">
            @L["ProjectInactiveHeading"]
        </h1>
        <p class="text-sm text-neutral leading-relaxed">
            @L["SurveyUnavailableBody"]
        </p>

    </div>
</div>
