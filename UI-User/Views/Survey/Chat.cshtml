@using System.Text.Json
@model SurveyViewModel

@{
    ViewData["Title"] = "Enquête — Chat";
    ViewData["SurveyTitle"] = Model.Title;
    var jsonOpts = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
}

@Html.AntiForgeryToken()

<div id="chat-root" class="flex flex-col max-w-2xl mx-auto"
     style="height: calc(100dvh - var(--header-h, 64px))"
     data-project-id="@Context.GetRouteValue("projectId")"
     data-has-session="@Model.HasSession.ToString().ToLower()"
     data-questions="@Html.Raw(System.Net.WebUtility.HtmlEncode(JsonSerializer.Serialize(Model.Questions, jsonOpts)))"
     data-existing-responses="@Html.Raw(System.Net.WebUtility.HtmlEncode(JsonSerializer.Serialize(Model.ExistingResponses, jsonOpts)))"
     aria-label="Chat formulier">

    <div class="shrink-0 flex items-center justify-between gap-2 px-4 py-2 border-b border-base-300 bg-base-100">
        <button id="chat-back" type="button" aria-label="Vorige vraag"
                class="w-9 h-9 rounded-full bg-base-200 flex items-center justify-center
                       hover:bg-base-300 active:scale-95 transition-all cursor-pointer
                       disabled:opacity-30 disabled:cursor-not-allowed" disabled>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none"
                 viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
            </svg>
        </button>
        <button id="chat-restart" type="button" aria-label="Herstart enquête"
                class="w-9 h-9 rounded-full bg-base-200 flex items-center justify-center
                       hover:bg-base-300 active:scale-95 transition-all cursor-pointer">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none"
                 viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M4 4v6h6M20 20v-6h-6M4 10a8 8 0 0114-4M20 14a8 8 0 01-14 4" />
            </svg>
        </button>
    </div>

    <div id="chat-messages"
         class="flex-1 overflow-y-auto px-4 py-6 flex flex-col gap-3"
         aria-live="polite" aria-label="Gespreksgeschiedenis"></div>

    <div id="chat-input-row" class="shrink-0 border-t border-base-300 bg-base-100 px-4 py-3">
        <div class="flex items-end gap-3">
            <textarea id="chat-input" rows="1" maxlength="1000"
                      placeholder="Typ hier..."
                      aria-label="Typ je antwoord"
                      class="flex-1 resize-none rounded-2xl border border-base-300 bg-base-100
                             px-4 py-3 text-sm focus:outline-none focus:border-primary
                             transition-colors max-h-32 overflow-y-auto"></textarea>
            <button id="chat-send" type="button" aria-label="Verstuur"
                    class="shrink-0 w-10 h-10 rounded-full bg-primary flex items-center justify-center
                           hover:opacity-90 active:scale-95 transition-all cursor-pointer
                           disabled:opacity-40 disabled:cursor-not-allowed">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-white" fill="none"
                     viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 5l7 7-7 7" />
                </svg>
            </button>
        </div>
    </div>
</div>
