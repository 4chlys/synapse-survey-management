@using System.Text.Json
@model SurveyViewModel

@{
    ViewData["Title"] = "Enquête — Chat";
    ViewData["SurveyTitle"] = Model.Title;
    var jsonOpts = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
}

@Html.AntiForgeryToken()

@* Ambient blobs — mirrors landing page depth *@
<div class="fixed inset-0 pointer-events-none overflow-hidden z-0" aria-hidden="true">
    <div class="absolute -top-40 -left-32 w-96 h-96 rounded-full bg-primary/5 blur-3xl"></div>
    <div class="absolute -bottom-20 -right-24 w-[28rem] h-[28rem] rounded-full bg-secondary/5 blur-3xl"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-64 h-64 rounded-full bg-accent/3 blur-3xl"></div>
</div>

<div id="chat-root" class="flex flex-col max-w-2xl mx-auto relative z-10 bg-base-100"
     style="height: calc(100dvh - var(--header-h, 64px))"
     data-project-id="@Context.GetRouteValue("projectId")"
     data-has-session="@Model.HasSession.ToString().ToLower()"
     data-questions="@Html.Raw(System.Net.WebUtility.HtmlEncode(JsonSerializer.Serialize(Model.Questions, jsonOpts)))"
     data-existing-responses="@Html.Raw(System.Net.WebUtility.HtmlEncode(JsonSerializer.Serialize(Model.ExistingResponses, jsonOpts)))"
     aria-label="Chat formulier">

    @* Toolbar — glassmorphism, matches landing page header aesthetic *@
    <div class="shrink-0 flex items-center gap-3 px-4 py-3
                bg-base-100 border-b border-base-300">

        <button id="chat-back" type="button" aria-label="Vorige vraag"
                class="shrink-0 w-8 h-8 rounded-full border border-base-300/80 bg-base-200/60
                       flex items-center justify-center
                       hover:border-primary/50 hover:bg-primary/10 hover:scale-105
                       active:scale-90 transition-all cursor-pointer
                       disabled:opacity-25 disabled:cursor-not-allowed disabled:scale-100 disabled:hover:bg-base-200/60 disabled:hover:border-base-300/80"
                disabled>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none"
                 viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
            </svg>
        </button>

        @* Title + progress bar — left-accent pillar mirrors landing hero heading *@
        <div class="flex-1 flex flex-col gap-1.5 min-w-0">
            <div class="flex items-center gap-2">
                <span class="w-0.5 h-4 rounded-full bg-primary shrink-0" aria-hidden="true"></span>
                <span class="text-xs font-heading font-semibold text-base-content/65 truncate tracking-wide">
                    @(Model.Title ?? "Enquête")
                </span>
            </div>
            <div class="h-0.5 w-full rounded-full bg-base-300/60 overflow-hidden ml-2.5">
                <div id="chat-progress-fill"
                     class="h-full rounded-full bg-primary transition-[width] duration-500 ease-out"
                     style="width: 0%"></div>
            </div>
        </div>

        <button id="chat-restart" type="button" aria-label="Herstart enquête"
                class="shrink-0 w-8 h-8 rounded-full border border-base-300/80 bg-base-200/60
                       flex items-center justify-center
                       hover:border-primary/50 hover:bg-primary/10 hover:scale-105
                       active:scale-90 transition-all cursor-pointer">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none"
                 viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M4 4v6h6M20 20v-6h-6M4 10a8 8 0 0114-4M20 14a8 8 0 01-14 4" />
            </svg>
        </button>
    </div>

    @* Messages area *@
    <div id="chat-messages"
         class="flex-1 overflow-y-auto px-4 py-6 flex flex-col gap-3 bg-base-200"
         aria-live="polite" aria-label="Gespreksgeschiedenis"></div>

    @* Input area — glassmorphism bottom bar *@
    <div id="chat-input-row" class="shrink-0 border-t border-base-300 bg-base-100 px-4 py-3">
        <div class="flex items-end gap-3">
            <textarea id="chat-input" rows="1" maxlength="1000"
                      placeholder="Typ hier..."
                      aria-label="Typ je antwoord"
                      class="flex-1 resize-none rounded-2xl border border-base-300 bg-base-200
                             px-4 py-3 text-sm focus:outline-none focus:border-primary/60
                             focus:ring-2 focus:ring-primary/10
                             transition-all max-h-32 overflow-y-auto
                             placeholder:text-base-content/30"></textarea>
            <button id="chat-send" type="button" aria-label="Verstuur"
                    class="shrink-0 w-10 h-10 rounded-full bg-primary
                           flex items-center justify-center
                           hover:shadow-lg hover:shadow-primary/30 hover:scale-110
                           active:scale-95 transition-all cursor-pointer
                           disabled:opacity-40 disabled:cursor-not-allowed
                           disabled:shadow-none disabled:scale-100">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary-content" fill="none"
                     viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 5l7 7-7 7" />
                </svg>
            </button>
        </div>
    </div>
</div>
