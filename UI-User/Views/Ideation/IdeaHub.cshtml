@model IdeaIndexViewModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer L
@{
    ViewData["Title"] = Model.Category.Name;
    // Active page culture — used to mark idea text whose language differs from it (WCAG 3.1.2).
    var pageLang = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
}

@* Idea Support chat overlay *@
@await Html.PartialAsync("_IdeaSupportPopup")

@* Mode-selection sheet *@
<div id="mode-select-overlay"
     class="fixed inset-0 z-50 hidden items-center justify-center
            bg-black/40 backdrop-blur-sm p-6">
    <div id="mode-select-panel"
         role="dialog" aria-modal="true" aria-labelledby="mode-select-heading"
         class="bg-base-100 w-full max-w-sm rounded-[1.25rem]
                px-5 pt-5 pb-5 shadow-2xl">

        <p id="mode-select-heading" class="text-sm font-semibold text-base-content/50 uppercase tracking-wide mb-4">
            @L["ModeSelectHeading"]
        </p>

        <div class="flex flex-col gap-3">

            @* AI chat option *@
            <button type="button" data-action="show-ai-form" class="btn-mode-option">
                <div class="w-10 h-10 rounded-field bg-primary/15 flex items-center justify-center flex-shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary"
                         fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3
                                 m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0
                                 l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0
                                 v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
                    </svg>
                </div>
                <div>
                    <p class="font-semibold text-base-content text-sm">@L["AiOptionTitle"]</p>
                    <p class="text-xs text-base-content/40 mt-0.5">@L["AiOptionSubtitle"]</p>
                </div>
            </button>

            @* Classic form option *@
            <button type="button" data-action="show-manual-form" class="btn-mode-option-ghost">
                <div class="w-10 h-10 rounded-field bg-base-200 flex items-center justify-center flex-shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-base-content/50"
                         fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5
                                 m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                    </svg>
                </div>
                <div>
                    <p class="font-semibold text-base-content text-sm">@L["ManualOptionTitle"]</p>
                    <p class="text-xs text-base-content/40 mt-0.5">@L["ManualOptionSubtitle"]</p>
                </div>
            </button>

        </div>
    </div>
</div>

<div id="ideation-page"
     class="max-w-2xl mx-auto px-6 pt-10 pb-10 min-h-content page-enter"
     data-category-id="@Model.CategoryId"
     data-category-name="@Model.Category.Name"
     data-category-description="@Model.Category.Description">

    @* Top bar — back left, MyIdeas + exit right *@
    <nav class="w-full flex items-center justify-between gap-4 mb-6">
        <a asp-controller="Category" asp-action="CategoryList" asp-route-projectId="@Model.ProjectId"
           class="btn-back">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24"
                 stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
            </svg>
            @L["BackToCategoriesLabel"]
        </a>
        <div class="flex items-center gap-2">
            <a asp-controller="Ideation" asp-action="MyIdeas"
               asp-route-projectId="@Model.ProjectId" asp-route-categoryId="@Model.Category.CategoryId"
               class="nav-link-pill">
                @L["MyIdeasNavLabel"]
            </a>
            <button type="button" data-action="show-thank-you"
               aria-label="@L["CloseNavLabel"]"
               class="btn-exit">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24"
                     stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                </svg>
            </button>
        </div>
    </nav>

    @* Page header *@
    <div class="w-full mb-8">
        <div class="accent-strip h-0.5 w-12 rounded-full mb-3"></div>
        <h1 class="font-heading text-2xl font-bold text-base-content leading-snug">
            @Model.Category.Name
        </h1>
        <p class="text-sm text-base-content/75 mt-2 leading-relaxed">
            @Model.Category.Description
        </p>
    </div>

    @* CTA Nieuw idee *@
    <button type="button" data-action="show-create-form"
            class="w-full btn btn-primary rounded-field font-heading font-semibold text-base py-4 h-auto gap-2 mb-6 shadow-md cursor-pointer">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24"
             stroke="currentColor"
             stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
        </svg>
        @L["NewIdeaButton"]
    </button>

    @* Create form *@
    <div id="createForm" class="w-full mb-6 hidden">
        <form asp-route-projectId="@Model.ProjectId" asp-action="CreateIdea" method="post"
              class="bg-base-100 rounded-field border border-base-300 p-5">
            <input type="hidden" name="categoryId" value="@Model.Category.CategoryId"/>
            <input type="hidden" name="moderationToken" value=""/>
            <input type="hidden" name="imageUrl" value=""/>
            <input type="hidden" name="imageModerationToken" value=""/>
            <div class="mb-4">
                <label class="text-xs font-semibold text-base-content/60 uppercase tracking-wide mb-2 block">
                    @L["YourIdeaLabel"]
                </label>
                <textarea id="idea-description-input" name="description" required maxlength="1000" rows="4"
                          class="input-field" placeholder="@L["IdeaPlaceholder"]"></textarea>
                <div class="mt-2 flex justify-end">
                    <partial name="_MicButton"
                             model='new MicButtonModel(TargetSelector: "#idea-description-input", SizeClass: "w-9 h-9")' />
                </div>
            </div>

            @if (Model.AllowCrossLanguageIdeas)
            {
                <div class="mb-4">
                    <label class="text-xs font-semibold text-base-content/60 uppercase tracking-wide mb-2 block">@L["SubmissionLanguageLabel"]</label>
                    <select name="languageCode" class="select-field">
                        @foreach (var languageCode in Model.SupportedLanguageCodes)
                        {
                            var displayName = LanguageHelpers.DisplayName(languageCode);
                            <option value="@languageCode" selected="@(languageCode == Model.ParticipantLanguageCode)">@displayName</option>
                        }
                    </select>
                </div>
            }

            @* Image upload *@
            <div class="mb-4" data-image-upload>
                <input type="file" name="ideaImage" accept="image/jpeg,image/png,image/webp,image/gif" class="hidden" />
                <div class="flex items-center gap-2">
                    <button type="button" data-action="browse-image"
                            class="btn btn-ghost btn-sm rounded-field border border-base-300 text-xs font-semibold">
                        @L["AddImageButton"]
                    </button>
                    <button type="button" data-action="describe-image"
                            class="hidden btn btn-ghost btn-sm rounded-field border border-primary/30 text-xs font-semibold text-primary">
                        @L["DescribeImageButton"]
                    </button>
                    <span data-image-filename class="text-xs text-base-content/50 truncate max-w-[140px]"></span>
                    <button type="button" data-action="remove-image" class="hidden text-xs text-error font-medium">✕</button>
                </div>
                <div data-image-preview class="mt-2 hidden">
                    <img src="" alt="" class="rounded-field max-h-40 w-full object-cover border border-base-300" />
                </div>
                <p data-image-error class="hidden text-red-500 text-xs mt-1 font-medium"></p>
            </div>

            <div class="flex gap-2">
                <button type="submit" class="btn btn-primary flex-1 rounded-field font-heading font-semibold text-sm">
                    @L["PostButton"]
                </button>
                <button type="button" data-action="hide-create-form"
                        class="btn btn-ghost flex-1 rounded-field font-heading font-semibold text-sm border border-base-300">
                    @L["CancelButton"]
                </button>
            </div>
        </form>
    </div>

    @* Sort filter — only after user posted first idea *@
    @if (Model.HasOwnIdeas)
    {
        var currentSortLabel = Model.CurrentSort switch
        {
            "similar" => L["SortSimilar"].Value,
            "different" => L["SortDifferent"].Value,
            _ => L["SortDiverse"].Value
        };
        <div class="w-full flex justify-end mb-5">
            <details class="dropdown dropdown-end">
                <summary class="list-none cursor-pointer inline-flex items-center gap-2 py-2 px-3 rounded-field text-xs font-semibold border bg-base-100 border-base-300 text-base-content/80 hover:border-primary/40 transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24"
                         stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 4h18M6 12h12M10 20h4"/>
                    </svg>
                    <span>@currentSortLabel</span>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24"
                         stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                    </svg>
                </summary>
                <ul class="dropdown-content menu bg-base-100 rounded-field border border-base-300 shadow-md mt-2 w-44 p-1 z-10 text-xs font-semibold">
                    <li>
                        <a asp-controller="Ideation" asp-action="IdeaHub"
                           asp-route-projectId="@Model.ProjectId" asp-route-categoryId="@Model.CategoryId"
                           asp-route-sort="diverse"
                           class="@(Model.CurrentSort == "diverse" ? "bg-primary/10 text-primary" : "")">
                            @L["SortDiverse"]
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Ideation" asp-action="IdeaHub"
                           asp-route-projectId="@Model.ProjectId" asp-route-categoryId="@Model.CategoryId"
                           asp-route-sort="similar"
                           class="@(Model.CurrentSort == "similar" ? "bg-primary/10 text-primary" : "")">
                            @L["SortSimilar"]
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Ideation" asp-action="IdeaHub"
                           asp-route-projectId="@Model.ProjectId" asp-route-categoryId="@Model.CategoryId"
                           asp-route-sort="different"
                           class="@(Model.CurrentSort == "different" ? "bg-primary/10 text-primary" : "")">
                            @L["SortDifferent"]
                        </a>
                    </li>
                </ul>
            </details>
        </div>
    }

    @* Language filter toggle — only rendered when project allows cross-language ideas *@
    @if (Model.AllowCrossLanguageIdeas)
    {
        <div class="w-full flex items-center gap-3 mb-4">
            <input type="checkbox" id="show-all-languages-toggle" class="toggle toggle-primary toggle-sm" />
            <label for="show-all-languages-toggle" class="text-sm text-base-content/70 cursor-pointer">@L["ShowAllLanguages"]</label>
        </div>
    }

    @if (Model.Ideas.Any())
    {
        <p class="text-xs text-base-content/40 italic mb-3">
            @L["AiDisclaimer"]
        </p>
    }

    @* Ideas list *@
    <ul id="ideas-list" class="w-full flex flex-col gap-3 mb-4"
         data-project-id="@Model.ProjectId"
         data-category-id="@Model.CategoryId"
         data-sort="@Model.CurrentSort"
         data-replace="@Model.ExtraIdeasReplaceExisting.ToString().ToLower()"
         data-max-extra="@Model.MaxExtraIdeaRequests"
         data-current-page="@(Model.MaxExtraIdeaRequests - Model.RemainingExtraRequests + 1)"
         data-empty-label="@L["EmptyState"]">
        @if (!Model.Ideas.Any())
        {
            <li class="text-center py-16 flex flex-col items-center gap-3">
                <div class="w-14 h-14 rounded-field bg-primary/10 flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-primary/70" fill="none"
                         viewBox="0 0 24 24"
                         stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m1.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
                    </svg>
                </div>
                <p class="text-base-content/70 text-sm font-medium">@L["EmptyState"]</p>
            </li>
        }
        else
        {
            @foreach (var idea in Model.Ideas)
            {
                <li class="group relative rounded-field border p-5 transition-all duration-150 active:scale-[0.99] cursor-pointer
                     @(idea.IsFlagged ? "bg-warning/5 border-warning/30 hover:border-warning/50" : idea.IsOwnedByCurrentUser ? "bg-primary/5 border-primary/20 hover:border-primary/40" : "bg-base-100 border-base-300 hover:border-primary/30 hover:shadow-sm")">

                    @* Comment count badge *@
                    <div class="absolute -top-3 -right-3 bg-base-100 border border-base-300
                        rounded-full px-2.5 py-1 flex items-center gap-1.5 shadow-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-neutral/70" fill="none"
                             viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                        </svg>
                        <span class="text-xs font-bold text-base-content tabular-nums">@idea.CommentsCount</span>
                    </div>

                    @* Status label *@
                    @if (idea.IsFlagged)
                    {
                        <span class="inline-flex items-center gap-1 text-xs text-warning font-medium mb-2">
                            <span class="w-1.5 h-1.5 rounded-full bg-warning inline-block"></span>
                            @L["FlaggedBadge"]
                        </span>
                    }
                    else if (idea.IsOwnedByCurrentUser)
                    {
                        <span class="inline-flex items-center gap-1 text-xs text-primary font-medium mb-2">
                            <span class="w-1.5 h-1.5 rounded-full bg-primary inline-block"></span>
                            @L["YourIdeaLabel"]
                        </span>
                    }

                    <p class="text-base-content text-sm leading-relaxed pr-8"
                       lang="@(string.Equals(idea.LanguageCode, pageLang, StringComparison.OrdinalIgnoreCase) ? null : idea.LanguageCode)">@idea.Description</p>

                    @if (!string.IsNullOrEmpty(idea.ImageUrl))
                    {
                        <img src="@idea.ImageUrl" alt="" class="mt-3 rounded-field max-h-64 w-full object-cover" />
                    }

                    @* Copy idea button *@
                    <div class="mt-3 relative z-[2]">
                        <button type="button" data-action="copy-idea"
                                data-idea-description="@idea.Description"
                                class="inline-flex items-center gap-1.5 text-xs text-base-content/50 hover:text-primary transition-colors cursor-pointer">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                            </svg>
                            @L["CopyIdeaButton"]
                        </button>
                    </div>

                    @* Emoji reactions *@
                    <div class="flex gap-2 mt-4 items-center flex-wrap relative z-[2]" data-emoji-container
                         data-project-id="@Model.ProjectId"
                         data-category-id="@Model.Category.CategoryId" data-idea-id="@idea.IdeaId"
                         data-return-page="IdeaHub"
                         data-picker-id="picker-@idea.IdeaId"
                         data-add-url="/@Model.ProjectId/Ideation/AddIconComment"
                         data-remove-url="/@Model.ProjectId/Ideation/RemoveIconComment">

                        <div id="emoji-reactions-@idea.IdeaId" class="contents">
                            @foreach (var emoji in idea.Emojis)
                            {
                                <form asp-action="@(emoji.PostedByCurrentUser ? "RemoveIconComment" : "AddIconComment")"
                                    method="post" data-emoji-form>
                                    <input type="hidden" name="projectId" value="@Model.ProjectId"/>
                                    <input type="hidden" name="categoryId" value="@Model.Category.CategoryId"/>
                                    <input type="hidden" name="ideaId" value="@idea.IdeaId"/>
                                    <input type="hidden" name="emojiId" value="@emoji.EmojiId"/>
                                    <input type="hidden" name="returnPage" value="IdeaHub"/>
                                    <button type="submit"
                                            class="inline-flex items-center gap-1.5 px-3 py-2 rounded-full text-xs font-semibold transition-colors cursor-pointer min-h-8
                                        @(emoji.PostedByCurrentUser ? "bg-primary/10 border border-primary/30 text-primary hover:bg-primary/20" : "bg-base-200 border border-base-300 text-base-content/70 hover:bg-base-300")">
                                        <span class="text-base leading-none">@emoji.Symbol</span>
                                        <span class="leading-none font-semibold">@emoji.Count</span>
                                    </button>
                                </form>
                            }
                        </div>

                        @if (Model.Emojis.Any())
                        {
                            <button type="button" data-action="toggle-emoji-picker" data-target="picker-@idea.IdeaId"
                                    aria-label="@L["AddEmojiAriaLabel"]"
                                    class="w-7 h-7 rounded-full border border-dashed border-base-300
                            flex items-center justify-center text-base-content/40
                            hover:border-primary hover:text-primary transition-colors cursor-pointer">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24"
                                     stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
                                </svg>
                            </button>
                        }
                    </div>

                    @if (Model.Emojis.Any())
                    {
                        @* Emoji picker *@
                        <div id="picker-@idea.IdeaId" class="hidden mt-3 p-3 bg-base-200 rounded-field border border-base-300 relative z-[2]">
                            <form asp-action="AddIconComment" method="post" data-emoji-form data-idea-id="@idea.IdeaId">
                                <input type="hidden" name="projectId" value="@Model.ProjectId"/>
                                <input type="hidden" name="categoryId" value="@Model.Category.CategoryId"/>
                                <input type="hidden" name="ideaId" value="@idea.IdeaId"/>
                                <input type="hidden" name="returnPage" value="IdeaHub"/>
                                <div class="flex gap-3 flex-wrap">
                                    @foreach (var emoji in Model.Emojis)
                                    {
                                        <button type="submit" name="emojiId" value="@emoji.EmojiId"
                                                class="text-2xl hover:scale-125 transition-transform cursor-pointer">
                                            @emoji.Symbol
                                        </button>
                                    }
                                </div>
                            </form>
                        </div>
                    }

                    <a asp-controller="Ideation" asp-action="Detail" asp-route-projectId="@Model.ProjectId"
                       asp-route-categoryId="@Model.Category.CategoryId" asp-route-ideaId="@idea.IdeaId"
                       class="absolute inset-0 rounded-field z-[1] focus-visible:ring-2 focus-visible:ring-primary/50 focus-visible:outline-none"
                       aria-label="@idea.Description"></a>
                </li>
            }
        }
    </ul>

    @* Refresh ideas button *@
    @if (Model.MaxExtraIdeaRequests > 0 && Model.Ideas.Any())
    {
        <button id="refresh-ideas-btn" type="button" data-action="refresh-ideas"
                class="w-full btn btn-outline btn-sm rounded-field font-heading font-semibold text-sm py-3 h-auto gap-2 mb-4 cursor-pointer @(Model.RemainingExtraRequests <= 0 ? "btn-disabled" : "")"
                @(Model.RemainingExtraRequests <= 0 ? "disabled" : "")>
            <svg id="refresh-ideas-spinner" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 hidden animate-spin" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
            </svg>
            <svg id="refresh-ideas-icon" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24"
                 stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
            </svg>
            <span id="refresh-ideas-label">@L["RefreshIdeasButton"]</span>
            <span id="refresh-ideas-counter" class="badge badge-sm">@Model.RemainingExtraRequests/@Model.MaxExtraIdeaRequests</span>
        </button>
    }

    @* Contact info popup *@
    @if (Model.ShowContactInfoPopup)
    {
        await Html.RenderPartialAsync("_ContactInfoPopup", Model);
    }

</div>

@await Html.PartialAsync("_FinalThankYouPopup")

