@model IdeaIndexViewModel
@{
    ViewData["Title"] = Model.Category.Name;
}

@* Idea Support chat overlay *@
@await Html.PartialAsync("_IdeaSupportPopup")

@* Mode-selection sheet — shown when the + button is tapped *@
<div id="mode-select-overlay"
     class="fixed inset-0 z-40 hidden items-end sm:items-center justify-center
            bg-black/40 backdrop-blur-sm p-0 sm:p-6">
    <div id="mode-select-panel"
         class="bg-white w-full max-w-sm sm:rounded-[1.25rem] rounded-t-[1.25rem]
                px-5 pt-5 pb-8 shadow-2xl">

        @* Drag handle (mobile only) *@
        <div class="w-10 h-1 bg-gray-200 rounded-full mx-auto mb-5 sm:hidden"></div>

        <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-4">
            Hoe wil je jouw idee toevoegen?
        </p>

        <div class="flex flex-col gap-3">

            @* AI chat option *@
            <button type="button" data-action="show-ai-form"
                    class="flex items-center gap-4 p-4 rounded-2xl border-2 border-emerald-100
                           bg-emerald-50 hover:border-emerald-300 transition-colors text-left w-full">
                <div class="w-10 h-10 rounded-xl bg-emerald-100 flex items-center justify-center flex-shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-emerald-600"
                         fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3
                                 m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0
                                 l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0
                                 v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
                    </svg>
                </div>
                <div>
                    <p class="font-semibold text-gray-900 text-sm">Met AI-assistent</p>
                    <p class="text-xs text-gray-400 mt-0.5">Wij helpen je idee te formuleren</p>
                </div>
            </button>

            @* Classic form option *@
            <button type="button" data-action="show-manual-form"
                    class="flex items-center gap-4 p-4 rounded-2xl border-2 border-gray-100
                           hover:border-gray-200 bg-white transition-colors text-left w-full">
                <div class="w-10 h-10 rounded-xl bg-gray-100 flex items-center justify-center flex-shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-500"
                         fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5
                                 m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                    </svg>
                </div>
                <div>
                    <p class="font-semibold text-gray-900 text-sm">Zelf schrijven</p>
                    <p class="text-xs text-gray-400 mt-0.5">Typ je idee direct in het formulier</p>
                </div>
            </button>

        </div>
    </div>
</div>

<div id="ideation-page"
     class="min-h-screen bg-gray-50 flex flex-col items-center px-6 pt-12 pb-20"
     data-category-id="@Model.CategoryId"
     data-category-name="@Model.Category.Name">

    @* Header *@
    <div class="w-full max-w-sm mb-10">
        <h1 class="text-2xl font-semibold text-gray-900 leading-snug">
            @Model.Category.Name
        </h1>
        <p class="text-sm text-gray-400 mt-2 font-normal">
            @Model.Category.Description
        </p>
    </div>

    @* Hidden create-idea form — submitted programmatically after AI chat confirms a draft *@
    <div id="createForm" class="w-full max-w-sm mb-6 hidden">
        <form asp-route-projectId="@Model.ProjectId" asp-action="CreateIdea" method="post"
              class="bg-white rounded-2xl border-2 border-gray-100 p-5">
            <input type="hidden" name="categoryId" value="@Model.Category.CategoryId"/>
            <input type="hidden" name="moderationToken" value=""/>
            <div class="mb-4">
                <label class="text-sm font-semibold text-gray-700 mb-2 block">Idee</label>
                <textarea name="description" required rows="4"
                          class="w-full px-4 py-3 border-2 border-gray-100 rounded-xl
                                 focus:border-emerald-300 focus:outline-none resize-none"
                          placeholder="Leg jouw idee uit..."></textarea>
            </div>
            <div class="flex gap-3">
                <button type="submit"
                        class="flex-1 py-2.5 bg-emerald-500 text-white font-semibold rounded-xl
                               hover:bg-emerald-600 transition-colors">
                    Plaatsen
                </button>
                <button type="button" data-action="hide-create-form"
                        class="flex-1 py-2.5 bg-gray-100 text-gray-700 font-semibold rounded-xl
                               hover:bg-gray-200 transition-colors">
                    Annuleren
                </button>
            </div>
        </form>
    </div>

    @* IdeaViewModels list *@
    <div class="w-full max-w-sm flex flex-col gap-4 mb-24">
        @if (!Model.Ideas.Any())
        {
            <div class="text-center py-12">
                <p class="text-gray-400">Nog geen ideeën, wees de eerste! 💡</p>
            </div>
        }
        else
        {
            @foreach (var idea in Model.Ideas)
            {
                <a asp-controller="Ideation" asp-action="Detail"
                   asp-route-projectId="@Model.ProjectId"
                   asp-route-categoryId="@Model.Category.CategoryId"
                   asp-route-ideaId="@idea.IdeaId"
                   class="block relative rounded-2xl border-2 p-5 cursor-pointer transition-colors
                          @(idea.IsFlagged
                              ? "bg-amber-50 border-amber-200 hover:border-amber-300"
                              : idea.IsOwnedByCurrentUser
                                  ? "bg-white border-emerald-100 hover:border-emerald-300"
                                  : "bg-white border-gray-100 hover:border-emerald-200")">

                    @* Comment count badge (top right) *@
                    <div class="absolute -top-3 -right-3 bg-white border-2 border-gray-100
                                rounded-full w-10 h-10 flex items-center justify-center shadow-sm">
                        <span class="text-sm font-semibold text-gray-700">@idea.CommentsCount</span>
                    </div>

                    @if (idea.IsFlagged)
                    {
                        <span class="inline-block text-xs text-amber-600 font-medium mb-2">
                            In behandeling
                        </span>
                    }
                    else if (idea.IsOwnedByCurrentUser)
                    {
                        <span class="inline-block text-xs text-emerald-500 font-medium mb-2">
                            Jouw idee
                        </span>
                    }

                    <p class="text-gray-900 text-sm leading-relaxed pr-8">@idea.Description</p>

                    @* Emoji reactions row *@
                    <div class="flex gap-2 mt-4 items-center flex-wrap"
                         data-emoji-container
                         data-project-id="@Model.ProjectId"
                         data-category-id="@Model.Category.CategoryId"
                         data-idea-id="@idea.IdeaId"
                         data-return-page="Index"
                         data-picker-id="picker-@idea.IdeaId"
                         data-add-url="/@Model.ProjectId/Ideation/AddIconComment"
                         data-remove-url="/@Model.ProjectId/Ideation/RemoveIconComment">

                        <div id="emoji-reactions-@idea.IdeaId" class="contents">
                            @foreach (var emoji in idea.Emojis)
                            {
                                <form asp-action="@(emoji.PostedByCurrentUser ? "RemoveIconComment" : "AddIconComment")" method="post" data-emoji-form>
                                    <input type="hidden" name="projectId" value="@Model.ProjectId" />
                                    <input type="hidden" name="categoryId" value="@Model.Category.CategoryId" />
                                    <input type="hidden" name="ideaId" value="@idea.IdeaId" />
                                    <input type="hidden" name="emojiId" value="@emoji.EmojiId" />
                                    <input type="hidden" name="returnPage" value="Index" />
                                    <button type="submit"
                                            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs min-w-[3rem] leading-none transition-colors
                                                   @(emoji.PostedByCurrentUser
                                                       ? "bg-emerald-100 border-2 border-emerald-400 hover:bg-emerald-200"
                                                       : "bg-gray-100 border border-gray-200 hover:bg-gray-200")">
                                        <span class="text-lg leading-none">@emoji.Symbol</span>
                                        <span class="font-semibold @(emoji.PostedByCurrentUser ? "text-emerald-700" : "text-gray-700") text-sm leading-none">@emoji.Count</span>
                                    </button>
                                </form>
                            }
                        </div>

                        @if (Model.Emojis.Any())
                        {
                            <button type="button"
                                    data-action="toggle-emoji-picker"
                                    data-target="picker-@idea.IdeaId"
                                    class="w-8 h-8 rounded-full border-2 border-dashed border-gray-300
                                           flex items-center justify-center text-gray-400
                                           hover:border-emerald-400 hover:text-emerald-600 transition-colors">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24"
                                     stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
                                </svg>
                            </button>
                        }
                    </div>

                    @if (Model.Emojis.Any())
                    {
                        @* Emoji picker *@
                        <div id="picker-@idea.IdeaId" class="hidden mt-3 p-3 bg-gray-50 rounded-xl border border-gray-200">
                            <form asp-action="AddIconComment" method="post" data-emoji-form data-idea-id="@idea.IdeaId">
                                <input type="hidden" name="projectId" value="@Model.ProjectId"/>
                                <input type="hidden" name="categoryId" value="@Model.Category.CategoryId"/>
                                <input type="hidden" name="ideaId" value="@idea.IdeaId"/>
                                <input type="hidden" name="returnPage" value="Index"/>
                                <div class="flex gap-2 flex-wrap">
                                    @foreach (var emoji in Model.Emojis)
                                    {
                                        <button type="submit" name="emojiId" value="@emoji.EmojiId"
                                                class="text-2xl hover:scale-125 transition-transform">
                                            @emoji.Symbol
                                        </button>
                                    }
                                </div>
                            </form>
                        </div>
                    }

                </a>
            }
        }
    </div>

    @* Contact info popup — shown after posting first idea when project requests contact info *@
    @if (Model.ShowContactInfoPopup)
    {
        await Html.RenderPartialAsync("_ContactInfoPopup", Model);
    }

    @* Bottom Navigation *@
    <div class="fixed bottom-0 left-0 right-0 bg-white border-t border-gray-200 pb-safe">
        <div class="max-w-sm mx-auto px-6 py-4 flex justify-around items-center">

            <a asp-route-projectId="@Model.ProjectId" asp-controller="Category" asp-action="Index"
               class="flex flex-col items-center gap-1 text-gray-400 hover:text-emerald-600 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24"
                     stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M11 17l-5-5m0 0l5-5m-5 5h12"/>
                </svg>
            </a>

            @* ADD IDEA button — now opens the AI chat overlay *@
            <button type="button" data-action="show-create-form"
                    class="flex flex-col items-center gap-1 text-emerald-500 hover:text-emerald-600 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24"
                     stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
                </svg>
            </button>

            <a asp-controller="Ideation" asp-action="MyIdeas"
               asp-route-projectId="@Model.ProjectId" asp-route-categoryId="@Model.Category.CategoryId"
               class="flex flex-col items-center gap-1 text-gray-400 hover:text-emerald-600 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24"
                     stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                </svg>
            </a>

            <a asp-controller="Category" asp-action="FinalThankYou" asp-route-projectId="@Model.ProjectId"
               class="flex flex-col items-center gap-1 text-gray-400 hover:text-red-500 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24"
                     stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                </svg>
            </a>
        </div>
    </div>

</div>
