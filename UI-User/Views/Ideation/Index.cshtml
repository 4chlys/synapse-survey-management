@model IdeaIndexViewModel
@{
    ViewData["Title"] = Model.Category.Name;
}

<div class="max-w-2xl mx-auto px-6 pt-10 pb-28 min-h-[calc(100dvh-64px)] page-enter">

    @* Page header *@
    <div class="w-full mb-8">
        <div class="accent-strip h-0.5 w-12 rounded-full mb-3"></div>
        <h1 class="font-heading text-2xl font-bold text-base-content leading-snug">
            @Model.Category.Name
        </h1>
        <p class="text-sm text-base-content/75 mt-2 leading-relaxed">
            @Model.Category.Description
        </p>
    </div>

    @* Create form — hidden by default *@
    <div id="createForm" class="w-full mb-6 hidden">
        <form asp-route-projectId="@Model.ProjectId" asp-action="CreateIdea" method="post"
              class="bg-base-100 rounded-xl border border-base-300 p-5">
            <input type="hidden" name="categoryId" value="@Model.Category.CategoryId" />
            <input type="hidden" name="moderationToken" value="" />
            <div class="mb-4">
                <label class="text-xs font-semibold text-base-content/60 uppercase tracking-wide mb-2 block">
                    Jouw idee
                </label>
                <textarea name="description" required rows="4" class="w-full px-4 py-3 border border-base-300 rounded-xl bg-base-100
                text-base-content text-sm placeholder:text-base-content/40
                focus:border-primary focus:outline-none resize-none transition-colors"
                          placeholder="Leg jouw idee uit..."></textarea>
            </div>
            <div class="flex gap-2">
                <button type="submit" class="btn btn-primary flex-1 rounded-xl font-heading font-semibold text-sm">
                    Plaatsen
                </button>
                <button type="button" data-action="hide-create-form"
                        class="btn btn-ghost flex-1 rounded-xl font-heading font-semibold text-sm border border-base-300">
                    Annuleren
                </button>
            </div>
        </form>
    </div>

    @* Ideas list *@
    <div class="w-full flex flex-col gap-3 mb-4">
        @if (!Model.Ideas.Any())
        {
            <div class="text-center py-16 flex flex-col items-center gap-3">
                <div class="w-14 h-14 rounded-xl bg-primary/10 flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-primary/70" fill="none" viewBox="0 0 24 24"
                         stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m1.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                    </svg>
                </div>
                <p class="text-base-content/70 text-sm font-medium">Nog geen ideeën — wees de eerste!</p>
            </div>
        }
        else
        {
            @foreach (var idea in Model.Ideas)
            {
                <a asp-controller="Ideation" asp-action="Detail" asp-route-projectId="@Model.ProjectId"
                       asp-route-categoryId="@Model.Category.CategoryId" asp-route-ideaId="@idea.IdeaId"
                       class="block relative rounded-xl border p-5 transition-all duration-150 active:scale-[0.99]
                    @(idea.IsFlagged
                                                                                                                                         ? "bg-warning/5 border-warning/30 hover:border-warning/50"
                                                                                                                                         : idea.IsOwnedByCurrentUser
                                                                                                                                             ? "bg-primary/5 border-primary/20 hover:border-primary/40"
                                                                                                                                             : "bg-base-100 border-base-300 hover:border-primary/30 hover:shadow-sm")">

                    @* Comment count badge *@
                    <div class="absolute -top-3 -right-3 bg-base-100 border border-base-300
                        rounded-full px-2.5 py-1 flex items-center gap-1.5 shadow-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-neutral/70" fill="none"
                             viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                        </svg>
                        <span class="text-xs font-bold text-base-content tabular-nums">@idea.CommentsCount</span>
                    </div>

                    @* Status label *@
                    @if (idea.IsFlagged)
                    {
                        <span class="inline-flex items-center gap-1 text-xs text-warning font-medium mb-2">
                            <span class="w-1.5 h-1.5 rounded-full bg-warning inline-block"></span>
                            In behandeling
                        </span>
                    }
                    else if (idea.IsOwnedByCurrentUser)
                    {
                        <span class="inline-flex items-center gap-1 text-xs text-primary font-medium mb-2">
                            <span class="w-1.5 h-1.5 rounded-full bg-primary inline-block"></span>
                            Jouw idee
                        </span>
                    }

                    <p class="text-base-content text-sm leading-relaxed pr-8">@idea.Description</p>

                    @* Emoji reactions — taller pills for easier tapping *@
                    <div class="flex gap-2 mt-4 items-center flex-wrap" data-emoji-container data-project-id="@Model.ProjectId"
                         data-category-id="@Model.Category.CategoryId" data-idea-id="@idea.IdeaId" data-return-page="Index"
                         data-picker-id="picker-@idea.IdeaId" data-add-url="/@Model.ProjectId/Ideation/AddIconComment"
                         data-remove-url="/@Model.ProjectId/Ideation/RemoveIconComment">

                        <div id="emoji-reactions-@idea.IdeaId" class="contents">
                            @foreach (var emoji in idea.Emojis)
                            {
                                <form asp-action="@(emoji.PostedByCurrentUser ? "RemoveIconComment" : "AddIconComment")"
                                      method="post" data-emoji-form>
                                    <input type="hidden" name="projectId" value="@Model.ProjectId" />
                                    <input type="hidden" name="categoryId" value="@Model.Category.CategoryId" />
                                    <input type="hidden" name="ideaId" value="@idea.IdeaId" />
                                    <input type="hidden" name="emojiId" value="@emoji.EmojiId" />
                                    <input type="hidden" name="returnPage" value="Index" />
                                    <button type="submit"
                                            class="inline-flex items-center gap-1.5 px-3 py-2 rounded-full text-xs font-semibold transition-colors cursor-pointer min-h-[32px]
                                        @(emoji.PostedByCurrentUser
                                                                                                                                    ? "bg-primary/10 border border-primary/30 text-primary hover:bg-primary/20"
                                                                                                                                    : "bg-base-200 border border-base-300 text-base-content/70 hover:bg-base-300")">
                                        <span class="text-base leading-none">@emoji.Symbol</span>
                                        <span class="leading-none font-semibold">@emoji.Count</span>
                                    </button>
                                </form>
                            }
                        </div>

                        <button type="button" data-action="toggle-emoji-picker" data-target="picker-@idea.IdeaId" class="w-7 h-7 rounded-full border border-dashed border-base-300
                            flex items-center justify-center text-base-content/40
                            hover:border-primary hover:text-primary transition-colors cursor-pointer">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24"
                                 stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                            </svg>
                        </button>
                    </div>

                    @* Emoji picker *@
                    <div id="picker-@idea.IdeaId" class="hidden mt-3 p-3 bg-base-200 rounded-xl border border-base-300">
                        <form asp-action="AddIconComment" method="post" data-emoji-form data-idea-id="@idea.IdeaId">
                            <input type="hidden" name="projectId" value="@Model.ProjectId" />
                            <input type="hidden" name="categoryId" value="@Model.Category.CategoryId" />
                            <input type="hidden" name="ideaId" value="@idea.IdeaId" />
                            <input type="hidden" name="returnPage" value="Index" />
                            <div class="flex gap-3 flex-wrap">
                                @foreach (var emoji in Model.Emojis)
                                {
                                    <button type="submit" name="emojiId" value="@emoji.EmojiId"
                                            class="text-2xl hover:scale-125 transition-transform cursor-pointer">
                                        @emoji.Symbol
                                    </button>
                                }
                            </div>
                        </form>
                    </div>

                </a>
            }
        }
    </div>

    @* Contact info popup *@
    @if (Model.ShowContactInfoPopup)
    {
        await Html.RenderPartialAsync("_ContactInfoPopup", Model);
    }

</div>

@* Bottom navigation *@
<div class="fixed bottom-0 left-0 right-0 bg-base-100 border-t border-base-300 z-50">
    <div class="max-w-2xl mx-auto grid grid-cols-4 py-2">

        <a asp-route-projectId="@Model.ProjectId" asp-controller="Category" asp-action="Index"
               class="flex flex-col items-center justify-center gap-1.5 py-1 min-h-[52px] text-base-content/65 hover:text-primary transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24"
                 stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M11 17l-5-5m0 0l5-5m-5 5h12" />
            </svg>
            <span class="text-[11px] font-medium">Terug</span>
        </a>

        <button type="button" data-action="show-create-form" class="flex flex-col items-center justify-center gap-1.5 py-1 min-h-[52px]
            text-primary hover:opacity-75 transition-opacity cursor-pointer
            bg-transparent border-0 outline-none appearance-none">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24"
                 stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
            </svg>
            <span class="text-[11px] font-semibold">Nieuw idee</span>
        </button>

        <a asp-controller="Ideation" asp-action="MyIdeas" asp-route-projectId="@Model.ProjectId"
               asp-route-categoryId="@Model.Category.CategoryId"
               class="flex flex-col items-center justify-center gap-1.5 py-1 min-h-[52px] text-base-content/65 hover:text-primary transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24"
                 stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
            <span class="text-[11px] font-medium">Mijn ideeën</span>
        </a>

        <a asp-controller="Category" asp-action="FinalThankYou" asp-route-projectId="@Model.ProjectId"
               class="flex flex-col items-center justify-center gap-1.5 py-1 min-h-[52px] text-base-content/65 hover:text-error transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24"
                 stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
            </svg>
            <span class="text-[11px] font-medium">Afsluiten</span>
        </a>

    </div>
</div>
