@model MyIdeasViewModel
@inject IViewLocalizer L
@{
    ViewData["Title"] = L["Heading"];
}

<div class="max-w-2xl mx-auto px-6 pt-10 pb-10 min-h-[calc(100dvh-64px)] page-enter">

    @* Top bar — back left, exit right *@
    <div class="w-full flex items-center justify-between gap-4 mb-6">
        <a asp-controller="Ideation" asp-action="IdeaHub"
           asp-route-projectId="@Model.ProjectId" asp-route-categoryId="@Model.CategoryId"
           class="inline-flex items-center gap-1.5 text-sm font-medium text-base-content/70 hover:text-primary transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24"
                 stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
            </svg>
            @L["BackToIdeasLabel"]
        </a>
        <a asp-controller="Category" asp-action="FinalThankYou" asp-route-projectId="@Model.ProjectId"
           aria-label="@L["CloseNavLabel"]"
           class="w-9 h-9 rounded-full flex items-center justify-center text-base-content/65 hover:text-error hover:bg-error/10 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24"
                 stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
            </svg>
        </a>
    </div>

    @* Header *@
    <div class="w-full mb-8">
        <div class="accent-strip h-0.5 w-12 rounded-full mb-3"></div>
        <h1 class="font-heading text-2xl font-semibold text-base-content leading-snug">@L["Heading"]</h1>
        <p class="text-sm text-neutral mt-1">@Model.Category?.Name</p>
    </div>

    @* Ideas list *@
    <div class="w-full flex flex-col gap-3">
        @if (!Model.Ideas.Any())
        {
            <div class="text-center py-16 flex flex-col items-center gap-3">
                <div class="w-12 h-12 rounded-xl bg-base-200 border border-base-300 flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-neutral" fill="none" viewBox="0 0 24 24"
                         stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m1.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                    </svg>
                </div>
                <p class="text-neutral text-sm">@L["EmptyState"]</p>
            </div>
        }
        else
        {
            @foreach (var idea in Model.Ideas)
            {
                <a asp-controller="Ideation" asp-action="Detail" asp-route-projectId="@Model.ProjectId"
                       asp-route-categoryId="@Model.CategoryId" asp-route-ideaId="@idea.IdeaId"
                       class="block relative rounded-xl border p-5 transition-all duration-150 active:scale-[0.99]
                    @(idea.IsFlagged
                                                                                                                                ? "bg-warning/5 border-warning/30 hover:border-warning/50"
                                                                                                                                : "bg-primary/5 border-primary/20 hover:border-primary/40")">

                    @* Comment count badge *@
                    <div class="absolute -top-2.5 -right-2.5 bg-base-100 border border-base-300
                        rounded-full w-8 h-8 flex items-center justify-center shadow-sm">
                        <span class="text-xs font-bold text-base-content">@idea.CommentsCount</span>
                    </div>

                    @if (idea.IsFlagged)
                    {
                        <span class="inline-flex items-center gap-1 text-xs text-warning font-medium mb-2">
                            <span class="w-1.5 h-1.5 rounded-full bg-warning inline-block"></span>
                            @L["FlaggedBadge"]
                        </span>
                    }

                    <p class="text-base-content text-sm leading-relaxed pr-6">@idea.Description</p>

                    @if (!string.IsNullOrEmpty(idea.ImageUrl))
                    {
                        <img src="@idea.ImageUrl" alt="" class="mt-3 rounded-xl max-h-64 w-full object-cover" />
                    }

                    @if (idea.Emojis.Any())
                    {
                        <div class="flex gap-2 mt-4 items-center flex-wrap">
                            @foreach (var emoji in idea.Emojis)
                            {
                                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold
                                    bg-base-200 border border-base-300 text-neutral">
                                    <span class="text-base leading-none">@emoji.Symbol</span>
                                    <span class="leading-none">@emoji.Count</span>
                                </span>
                            }
                        </div>
                    }
                </a>
            }
        }
    </div>

</div>

