@model SynapseEnqueteManagement.UI.User.Models.IdeaViewModel
@{
    var category = ViewBag.Category as SynapseEnqueteManagement.UI.User.Models.Category;
    var projectId = ViewBag.ProjectId ?? 1;
    var categoryId = ViewBag.CategoryId ?? 1;
    var comments = ViewBag.Comments as List<SynapseEnqueteManagement.UI.User.Models.CommentViewModel>
                   ?? new List<SynapseEnqueteManagement.UI.User.Models.CommentViewModel>();
    var emojis = ViewBag.Emojis as List<SynapseEnqueteManagement.UI.User.Models.EmojiViewModel>
                 ?? new List<SynapseEnqueteManagement.UI.User.Models.EmojiViewModel>();
    ViewData["Title"] = "Idee";
}

<div class="min-h-screen bg-gray-50 flex flex-col items-center px-6 pt-12 pb-32">

    @* IdeaViewModel card *@
    <div class="w-full max-w-sm mb-8">
        <div class="bg-white rounded-2xl border-2 border-gray-100 p-5">
            <p class="text-xs font-semibold text-emerald-500 uppercase tracking-wide mb-2">
                @category?.Name
            </p>
            <p class="text-gray-900 text-base leading-relaxed">@Model.Description</p>

            @* EmojiViewModel reactions on idea *@
            <div class="flex gap-2 mt-4 items-center flex-wrap">
                @foreach (var emoji in Model.Emojis)
                {
                    <span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-gray-100
                                 border border-gray-200 rounded-full text-xs min-w-[3rem] leading-none">
                        <span class="text-lg leading-none">@emoji.Symbol</span>
                        <span class="font-semibold text-gray-700 text-sm leading-none">@emoji.Count</span>
                    </span>
                }
                @* Plus button to open emoji picker for idea *@
                <button onclick="showEmojiPicker('idea-@Model.IdeaId')"
                        class="w-8 h-8 rounded-full border-2 border-dashed border-gray-300
                               flex items-center justify-center text-gray-400
                               hover:border-emerald-400 hover:text-emerald-600 transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                    </svg>
                </button>
            </div>

            @* EmojiViewModel picker for idea *@
            <div id="picker-idea-@Model.IdeaId" class="hidden mt-3 p-3 bg-gray-50 rounded-xl border border-gray-200">
                <form asp-action="AddIconComment" method="post">
                    <input type="hidden" name="projectId" value="@projectId" />
                    <input type="hidden" name="categoryId" value="@categoryId" />
                    <input type="hidden" name="ideaId" value="@Model.IdeaId" />
                    <input type="hidden" name="returnPage" value="Detail" />
                    <div class="flex gap-2 flex-wrap">
                        @foreach (var emoji in emojis)
                        {
                            <button type="submit" name="emojiId" value="@emoji.EmojiId"
                                    class="text-2xl hover:scale-125 transition-transform">
                                @emoji.Symbol
                            </button>
                        }
                    </div>
                </form>
            </div>

            <div class="flex gap-4 mt-4 text-sm text-gray-400">
                <span>💬 @Model.CommentsCount reacties</span>
            </div>
        </div>
    </div>

    @* CommentViewModels section *@
    <div class="w-full max-w-sm">
        <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-4">
            Reacties (@comments.Count)
        </h2>

        @if (!comments.Any())
        {
            <div class="text-center py-8">
                <p class="text-gray-400 text-sm">Nog geen reacties. Wees de eerste!</p>
            </div>
        }
        else
        {
            <div class="flex flex-col gap-3">
                @foreach (var comment in comments)
                {
                    <div class="bg-white rounded-2xl border-2 border-gray-100 p-4">
                        <p class="text-gray-900 text-sm leading-relaxed">@comment.Text</p>

                        @* EmojiViewModel reactions on comment *@
                        <div class="flex gap-2 mt-3 items-center flex-wrap">
                            @foreach (var commentEmoji in comment.Emojis)
                            {
                                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-gray-100
                                             border border-gray-200 rounded-full text-xs min-w-[3rem] leading-none">
                                    <span class="text-lg leading-none">@commentEmoji.Symbol</span>
                                    <span class="font-semibold text-gray-700 text-sm leading-none">@commentEmoji.Count</span>
                                </span>
                            }
                            @* Plus button to open emoji picker *@
                            <button onclick="showEmojiPicker('comment-@comment.CommentId')"
                                    class="w-7 h-7 rounded-full border-2 border-dashed border-gray-300
                                           flex items-center justify-center text-gray-400
                                           hover:border-emerald-400 hover:text-emerald-600 transition-colors">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                                </svg>
                            </button>
                        </div>

                        @* EmojiViewModel picker for comment *@
                        <div id="picker-comment-@comment.CommentId" class="hidden mt-3 p-3 bg-gray-50 rounded-xl border border-gray-200">
                            <form asp-action="AddCommentEmoji" method="post">
                                <input type="hidden" name="projectId" value="@projectId" />
                                <input type="hidden" name="categoryId" value="@categoryId" />
                                <input type="hidden" name="ideaId" value="@Model.IdeaId" />
                                <input type="hidden" name="commentId" value="@comment.CommentId" />
                                <div class="flex gap-2 flex-wrap">
                                    @foreach (var emoji in emojis)
                                    {
                                        <button type="submit" name="emojiId" value="@emoji.EmojiId"
                                                class="text-2xl hover:scale-125 transition-transform">
                                            @emoji.Symbol
                                        </button>
                                    }
                                </div>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

</div>

@* Fixed bottom navigation *@
<div class="fixed bottom-0 left-0 right-0 bg-white border-t border-gray-200">
    <div class="max-w-sm mx-auto px-6 py-4 flex justify-around items-center">

        @* Back to ideas list *@
        <a asp-controller="Ideation" asp-action="Index"
           asp-route-projectId="@projectId" asp-route-categoryId="@categoryId"
           class="flex flex-col items-center gap-1 text-gray-400 hover:text-emerald-600 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M11 17l-5-5m0 0l5-5m-5 5h12" />
            </svg>
        </a>

        @* Add comment button *@
        <button onclick="showCommentViewModelForm()"
                class="flex items-center gap-2 px-6 py-2.5 bg-emerald-500 text-white
                       font-semibold rounded-xl hover:bg-emerald-600 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
            </svg>
            Reageer
        </button>

        @* Profile *@
        <button class="flex flex-col items-center gap-1 text-gray-400 hover:text-emerald-600 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
        </button>
    </div>
</div>

@* CommentViewModel form (hidden, slides up when Reageer button is clicked) *@
<div id="commentForm" class="hidden fixed bottom-0 left-0 right-0 bg-white border-t border-gray-200 shadow-lg">
    <div class="max-w-sm mx-auto px-6 py-4">
        <form asp-action="AddComment" method="post">
            <input type="hidden" name="projectId" value="@projectId" />
            <input type="hidden" name="categoryId" value="@categoryId" />
            <input type="hidden" name="ideaId" value="@Model.IdeaId" />
            <div class="flex gap-3 items-end">
                <textarea name="text" rows="2" required
                          class="flex-1 px-4 py-3 border-2 border-gray-100 rounded-xl
                                 focus:border-emerald-300 focus:outline-none resize-none text-sm"
                          placeholder="Schrijf een reactie..."></textarea>
                <div class="flex flex-col gap-2">
                    <button type="submit"
                            class="px-4 py-2.5 bg-emerald-500 text-white text-sm
                                   font-semibold rounded-xl hover:bg-emerald-600 transition-colors">
                        Plaatsen
                    </button>
                    <button type="button" onclick="hideCommentViewModelForm()"
                            class="px-4 py-2.5 bg-gray-100 text-gray-700 text-sm
                                   font-semibold rounded-xl hover:bg-gray-200 transition-colors">
                        Annuleren
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>