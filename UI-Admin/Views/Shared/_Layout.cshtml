<!DOCTYPE html>
<html lang="nl" data-theme="synapse-light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Synapse Admin</title>
    <script>
        (function(){var t=localStorage.getItem('admin-theme');if(t)document.documentElement.setAttribute('data-theme',t);})();
    </script>
    <script type="module" vite-src="~/main.ts"></script>
    <environment include="Development">
        <link rel="stylesheet" vite-href="~/main.css" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" vite-href="~/main.ts" />
    </environment>
</head>
<body class="bg-base-200 min-h-screen">

@{
    var projectId    = ViewData["ProjectId"] as int?;
    var projectName  = ViewData["ProjectName"] as string;
    var platformName = ViewData["PlatformName"] as string;
    var projectState = ViewData["ProjectState"] as string;
    var activeSection = ViewData["ActiveSection"] as string ?? ViewData["Title"] as string ?? "";
    var hideSidebar  = ViewData["HideSidebar"] is true;
    var isSystemAdmin = User.IsInRole("SystemAdmin");

    string StateClass(string s) => s switch {
        "Active"   => "badge-success",
        "Draft"    => "badge-warning",
        "Archived" => "badge-ghost",
        _          => "badge-ghost"
    };
    string StateLabel(string s) => s switch {
        "Active"   => "Actief",
        "Draft"    => "Concept",
        "Archived" => "Gearchiveerd",
        _          => s
    };
    string NavAction(string section) => section switch {
        "Dashboard"   => "Dashboard",
        "Ideeën"      => "Ideas",
        "Categorieën" => "Ideation",
        "Vragen"      => "Questions",
        "Instellingen"=> "Create",
        _             => "Dashboard"
    };
    string NavIcon(string section) => section switch {
        "Dashboard"    => """<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/>""",
        "Ideeën"       => """<path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/>""",
        "Categorieën"  => """<path d="M4 6h16M4 12h16M4 18h8"/>""",
        "Vragen"       => """<circle cx="12" cy="12" r="9"/><path d="M12 8v4l3 3"/>""",
        "Instellingen" => """<circle cx="12" cy="12" r="3"/><path d="M19.07 4.93a10 10 0 010 14.14M4.93 4.93a10 10 0 000 14.14"/>""",
        _              => ""
    };
    bool IsNavActive(string section) => activeSection == section
        || (section == "Projecten" && projectId.HasValue);
}

@if (User.Identity?.IsAuthenticated == true)
{
    <!-- ── Top bar ── -->
    <header class="fixed top-0 left-0 right-0 h-14 z-40 bg-base-100 border-b border-base-300 flex items-center px-4 gap-3">

        <!-- Logo mark -->
        <div class="w-8 h-8 bg-primary rounded-lg flex-shrink-0 flex items-center justify-center">
            <svg class="text-primary-content" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
            </svg>
        </div>
        <div class="w-px h-6 bg-base-300 flex-shrink-0"></div>

        <!-- Breadcrumb -->
        <nav class="flex items-center gap-1.5 text-xs min-w-0">
            @if (projectId.HasValue)
            {
                <a asp-controller="Project" asp-action="Index"
                   class="text-base-content/40 hover:text-base-content transition truncate">Projecten</a>
                <span class="text-base-content/20">/</span>
                <span class="text-base-content/60 truncate max-w-32">@projectName</span>
                <span class="text-base-content/20">/</span>
                <span class="text-primary font-semibold truncate">@activeSection</span>
            }
            else
            {
                <span class="font-semibold text-base-content">@activeSection</span>
            }
        </nav>

        <div class="flex-1"></div>

        <!-- Theme toggle -->
        <button id="theme-toggle" type="button"
                class="w-9 h-5 rounded-full bg-base-300 flex items-center px-0.5 transition relative"
                aria-label="Schakel thema">
            <span id="theme-icon" class="text-xs leading-none select-none">🌙</span>
        </button>

        <!-- User dropdown -->
        <div class="dropdown dropdown-end">
            <div tabindex="0" role="button"
                 class="w-8 h-8 rounded-full bg-primary/10 text-primary font-bold text-sm flex items-center justify-center cursor-pointer select-none">
                @(User.Identity!.Name?.FirstOrDefault().ToString().ToUpper() ?? "U")
            </div>
            <ul tabindex="0" class="dropdown-content menu bg-base-100 border border-base-300 rounded-xl shadow-lg w-52 p-1 mt-2 z-50">
                <li class="px-3 py-1.5 pointer-events-none">
                    <span class="text-xs text-base-content/50 truncate block">@User.Identity.Name</span>
                </li>
                <li class="divider my-0.5"></li>
                <li><a asp-controller="Auth" asp-action="ChangePassword" class="text-sm">Wachtwoord wijzigen</a></li>
                <li>
                    <form asp-controller="Auth" asp-action="Logout" method="post" class="p-0">
                        <button type="submit" class="w-full text-left text-sm text-error px-4 py-2 hover:bg-error/10 rounded-lg">Uitloggen</button>
                    </form>
                </li>
            </ul>
        </div>
    </header>

    <!-- ── Below top bar ── -->
    <div class="flex pt-14 min-h-[calc(100vh-3.5rem)]">

        <!-- Icon sidebar -->
        <nav aria-label="Hoofdnavigatie" class="fixed left-0 top-14 bottom-0 w-[52px] z-30 bg-base-100 border-r border-base-300 flex flex-col items-center py-3 gap-1">
            <!-- Projects -->
            <a asp-controller="Project" asp-action="Index"
               class="w-9 h-9 rounded-xl flex items-center justify-center tooltip tooltip-right transition @(IsNavActive("Projecten") ? "bg-primary text-primary-content" : "text-base-content/40 hover:bg-base-200")"
               data-tip="Projecten">
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/>
                    <rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>
                </svg>
            </a>

            @if (isSystemAdmin)
            {
                <!-- Platform -->
                <a asp-controller="Platform" asp-action="Index"
                   class="w-9 h-9 rounded-xl flex items-center justify-center tooltip tooltip-right transition @(IsNavActive("Platform") ? "bg-primary text-primary-content" : "text-base-content/40 hover:bg-base-200")"
                   data-tip="Platform">
                    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
                    </svg>
                </a>

                <!-- Admins -->
                <a asp-controller="Admin" asp-action="Add"
                   class="w-9 h-9 rounded-xl flex items-center justify-center tooltip tooltip-right transition @(IsNavActive("Beheerders") ? "bg-primary text-primary-content" : "text-base-content/40 hover:bg-base-200")"
                   data-tip="Beheerders">
                    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/>
                        <path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/>
                    </svg>
                </a>
            }
        </nav>

        <!-- Content pushed right of icon sidebar -->
        <div class="flex flex-1 pl-[52px]">

            @if (projectId.HasValue && !hideSidebar)
            {
                <!-- Inner project sidebar -->
                <aside class="fixed left-[52px] top-14 bottom-0 w-52 z-20 bg-base-100 border-r border-base-300 overflow-y-auto">
                    <div class="p-4">
                        <p class="text-[10px] font-bold text-primary uppercase tracking-widest mb-0.5 truncate">@(platformName ?? "Synapse")</p>
                        <p class="font-heading font-bold text-base-content text-sm mb-4 leading-snug">@projectName</p>

                        <ul class="menu menu-sm gap-0.5 -mx-2 w-[calc(100%+1rem)]">
                            @foreach (var section in new[]{"Dashboard","Ideeën","Categorieën","Vragen","Instellingen"})
                            {
                                var active = activeSection == section;
                                <li>
                                    <a asp-controller="Project"
                                       asp-action="@NavAction(section)"
                                       asp-route-projectId="@projectId"
                                       class="@(active ? "bg-primary/10 text-primary font-semibold" : "text-base-content/60") rounded-xl gap-2.5">
                                        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                            @Html.Raw(NavIcon(section))
                                        </svg>
                                        @(section)
                                    </a>
                                </li>
                            }
                        </ul>

                        @if (!string.IsNullOrEmpty(projectState))
                        {
                            <div class="mt-5">
                                <span class="badge @StateClass(projectState) badge-sm gap-1">
                                    <span class="w-1.5 h-1.5 rounded-full bg-current inline-block"></span>
                                    @StateLabel(projectState)
                                </span>
                            </div>
                        }
                    </div>
                </aside>

                <main class="flex-1 @(hideSidebar ? "" : "ml-52") p-6 min-h-[calc(100vh-3.5rem)]">
                    @RenderBody()
                </main>
            }
            else
            {
                <main class="flex-1 p-6 min-h-[calc(100vh-3.5rem)]">
                    @RenderBody()
                </main>
            }

        </div>
    </div>
}
else
{
    @RenderBody()
}

@if (TempData["Error"] is string errorMsg)
{
    <div id="tempdata-error" class="alert alert-error fixed bottom-4 right-4 z-50 max-w-sm shadow-lg flex gap-2">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" class="flex-shrink-0"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
        <span>@errorMsg</span>
    </div>
    <script>setTimeout(() => document.getElementById('tempdata-error')?.remove(), 5000);</script>
}

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
