<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Synapse Admin</title>

    <script type="module" vite-src="~/main.ts"></script>
    <environment include="Development">
        <link rel="stylesheet" vite-href="~/main.css" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" vite-href="~/main.ts" />
    </environment>
</head>
<body class="bg-gray-100 min-h-screen">

@if (User.Identity?.IsAuthenticated == true)
{
    <nav class="bg-gray-900 border-b border-gray-700 px-6 py-3 flex items-center justify-between">
        <span class="text-white text-sm font-semibold tracking-wide">Synapse Admin</span>
        <div class="flex items-center gap-4">
            <span class="text-gray-300 text-xs">@User.Identity.Name</span>
            <form asp-controller="Auth" asp-action="Logout" method="post" class="inline">
                <button type="submit"
                        class="text-xs text-gray-400 hover:text-white border border-gray-600 px-3 py-1 hover:border-gray-400 transition">
                    Uitloggen
                </button>
            </form>
        </div>
    </nav>
}

<main>
    @RenderBody()
</main>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
