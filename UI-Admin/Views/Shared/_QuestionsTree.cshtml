@using SynapseEnqueteManagement.UI.Admin.Models.Question
@model List<QuestionViewModel>
@{
    var topLevel = Model.Where(q => q.ParentQuestionId is null)
        .OrderBy(q => q.Position).ToList();
    var all = Model.ToList();
}

@if (!topLevel.Any())
{
    <p class="text-gray-500 mb-4">Nog geen vragen toegevoegd.</p>
}

@foreach (var q in topLevel)
{
    <partial name="_QuestionNode" model="new QuestionNodeViewModel { Question = q, AllQuestions = all, Depth = 0 }" />
}

<div class="drop-zone promote-zone border border-dashed border-gray-500 text-gray-400 text-center py-3 my-3 text-xs"
     data-parent-id=""
     data-parent-trigger="">
    Sleep een subvraag hierheen om er een hoofdvraag van te maken
</div>
