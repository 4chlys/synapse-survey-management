@using Microsoft.AspNetCore.Localization
@using Microsoft.Extensions.Options
@using System.Globalization
@inject IHtmlLocalizer<SharedResource> Shared
@inject IOptions<RequestLocalizationOptions> LocalizationOptions
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName" data-theme="synapse-light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — @Shared["AppName"]</title>
    <script>
        (function(){let t=localStorage.getItem('admin-theme');if(t!=='synapse-light'&&t!=='synapse-dark')t=
            matchMedia('(prefers-color-scheme: dark)').matches?'synapse-dark':'synapse-light';
            document.documentElement.setAttribute('data-theme',t);})();
    </script>

    <script>
      window.__i18n = {
        culture: @Json.Serialize(CultureInfo.CurrentUICulture.Name),
        strings: @Json.Serialize(new {
          submit  = Shared["Common_Submit"].Value,
          cancel  = Shared["Common_Cancel"].Value,
          save    = Shared["Common_Save"].Value,
          delete  = Shared["Common_Delete"].Value,
          edit    = Shared["Common_Edit"].Value,
          add     = Shared["Common_Add"].Value,
          back    = Shared["Common_Back"].Value,
          search  = Shared["Common_Search"].Value,
          yes     = Shared["Common_Yes"].Value,
          no      = Shared["Common_No"].Value,
          confirm = Shared["Common_Confirm"].Value,
          loading = Shared["Common_Loading"].Value,
          close   = Shared["Common_Close"].Value,
          all     = Shared["Common_All"].Value,
          none    = Shared["Common_None"].Value
        })
      };
    </script>

    <script type="module" vite-src="~/main.ts"></script>
    <environment include="Development">
        <link rel="stylesheet" vite-href="~/main.css" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" vite-href="~/main.ts" />
    </environment>
</head>
<body class="bg-base-100 min-h-screen">

    <div class="min-h-screen grid lg:grid-cols-[1.1fr_1fr]">

        @* ─── Left brand panel (hidden on small screens) ───────────────────── *@
        <aside class="relative hidden lg:flex flex-col justify-between overflow-hidden bg-primary text-primary-content p-12 xl:p-16">
            @* Layered gradient + decorative synapse graph *@
            <div class="absolute inset-0 pointer-events-none"
                 style="background:
                    radial-gradient(circle at 18% 22%, oklch(72% 0.20 277 / 0.55), transparent 55%),
                    radial-gradient(circle at 82% 78%, oklch(48% 0.22 300 / 0.45), transparent 60%),
                    linear-gradient(135deg, oklch(38% 0.18 278) 0%, oklch(52% 0.22 277) 100%);">
            </div>

            <svg class="absolute inset-0 w-full h-full opacity-[0.18] pointer-events-none" viewBox="0 0 600 800" fill="none" aria-hidden="true">
                <g stroke="currentColor" stroke-width="1">
                    <line x1="80"  y1="120" x2="240" y2="200" />
                    <line x1="240" y1="200" x2="180" y2="380" />
                    <line x1="240" y1="200" x2="430" y2="160" />
                    <line x1="430" y1="160" x2="520" y2="320" />
                    <line x1="180" y1="380" x2="340" y2="460" />
                    <line x1="340" y1="460" x2="520" y2="320" />
                    <line x1="340" y1="460" x2="280" y2="640" />
                    <line x1="280" y1="640" x2="480" y2="680" />
                    <line x1="180" y1="380" x2="80"  y2="560" />
                    <line x1="80"  y1="560" x2="280" y2="640" />
                </g>
                <g fill="currentColor">
                    <circle cx="80"  cy="120" r="4" />
                    <circle cx="240" cy="200" r="6" />
                    <circle cx="430" cy="160" r="4" />
                    <circle cx="520" cy="320" r="5" />
                    <circle cx="180" cy="380" r="5" />
                    <circle cx="340" cy="460" r="7" />
                    <circle cx="80"  cy="560" r="4" />
                    <circle cx="280" cy="640" r="5" />
                    <circle cx="480" cy="680" r="4" />
                </g>
            </svg>

            <div class="relative">
                <span class="font-heading font-bold text-2xl tracking-tight">@Shared["AppName"]</span>
            </div>

            <div class="relative max-w-md">
                <h2 class="font-heading font-bold text-3xl xl:text-4xl leading-tight mb-4">
                    @Shared["Login_Tagline"]
                </h2>
                <p class="text-primary-content/80 text-base leading-relaxed">
                    @Shared["Login_Subtagline"]
                </p>
            </div>

            <div class="relative flex flex-col gap-1 text-xs text-primary-content/60">
                <span>© @DateTime.UtcNow.Year SynapseIP</span>
                <a asp-controller="Privacy" asp-action="Index"
                   class="w-fit hover:text-primary-content underline underline-offset-2 transition-colors">
                    Privacy
                </a>
            </div>
        </aside>

        @* ─── Right form panel ───────────────────────────────────────────── *@
        <main class="relative flex flex-col">

            @* Top controls: language + theme *@
            <div class="flex items-center justify-end gap-3 p-4 lg:p-6">
                @{ var _activeCulture = CultureInfo.CurrentUICulture.Name; }
                <form asp-controller="Culture" asp-action="SetCulture" method="post"
                      class="inline-flex rounded-full border border-base-content/15 bg-base-200/60 backdrop-blur overflow-hidden"
                      aria-label="@Shared["LanguageMenu_Switch"]">
                    <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                    @foreach (var c in LocalizationOptions.Value.SupportedUICultures ?? [])
                    {
                        var isActive = string.Equals(c.Name, _activeCulture, StringComparison.OrdinalIgnoreCase);
                        <button type="submit" name="culture" value="@c.Name"
                                class="px-3 py-1.5 text-xs font-semibold uppercase tracking-wide transition-colors cursor-pointer @(isActive ? "bg-primary text-primary-content" : "text-base-content/60 hover:text-primary")"
                                aria-current="@(isActive ? "true" : "false")">
                            @c.TwoLetterISOLanguageName
                        </button>
                    }
                </form>

                <button id="theme-toggle" type="button" aria-label="@Shared["ThemeToggleLabel"]"
                        class="relative inline-flex items-center w-14 h-7 rounded-full border border-base-content/20 bg-base-200 transition-colors cursor-pointer focus:outline-none shrink-0">
                    <span class="sr-only">@Shared["ThemeToggleLabel"]</span>
                    <svg id="icon-sun" xmlns="http://www.w3.org/2000/svg"
                         class="absolute left-1.5 top-1/2 -translate-y-1/2 h-3.5 w-3.5 text-warning hidden pointer-events-none" fill="none"
                         viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707M17.657 17.657l-.707-.707M6.343 6.343l-.707-.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
                    </svg>
                    <svg id="icon-moon" xmlns="http://www.w3.org/2000/svg"
                         class="absolute right-1.5 top-1/2 -translate-y-1/2 h-3.5 w-3.5 text-base-content/50 pointer-events-none" fill="none"
                         viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
                    </svg>
                    <span id="toggle-knob"
                          class="absolute left-1 h-5 w-5 rounded-full bg-base-content/70 shadow-sm transition-transform duration-200 pointer-events-none translate-x-0">
                    </span>
                </button>
            </div>

            <div class="flex-1 flex items-center justify-center px-6 pb-12">
                @RenderBody()
            </div>

            <footer class="lg:hidden px-6 pb-4 flex items-center justify-between text-xs text-base-content/50">
                <a asp-controller="Privacy" asp-action="Index" class="hover:text-base-content/80 underline transition-colors">
                    Privacy
                </a>
                <span>© @DateTime.UtcNow.Year SynapseIP</span>
            </footer>
        </main>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
