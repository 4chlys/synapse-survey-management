@using SynapseEnqueteManagement.UI.Admin.Models.Question
@model QuestionNodeViewModel
@{
    var q = Model.Question;
    var all = Model.AllQuestions;
    var depth = Model.Depth;
    var hasAnswerChoices = q.QuestionFormat is "SingleChoice" or "MultipleChoice";
    var isLikert = q.QuestionFormat == "Likert";
    var canBranch = hasAnswerChoices || isLikert;
    var triggerValues = hasAnswerChoices
        ? q.AnswerChoices.ToList()
        : isLikert ? Enumerable.Range(1, 10).Select(i => i.ToString()).ToList() : new List<string>();
}

<div class="question-card border border-gray-500 bg-gray-900 mb-2"
     draggable="true"
     data-question-id="@q.QuestionId"
     data-format="@q.QuestionFormat"
     data-parent-id="@(q.ParentQuestionId?.ToString() ?? "")"
     data-parent-trigger="@(q.ParentTriggerValue ?? "")"
     data-position="@q.Position"
     style="margin-left:@(depth * 16)px">

    <div class="flex items-stretch">
        <span class="question-grip px-2 py-3 cursor-move text-gray-400 select-none" title="Versleep om te verplaatsen">⠿</span>
        <button type="button"
                class="question-toggle flex-1 px-3 py-3 text-left flex justify-between items-center hover:bg-gray-800 transition"
                data-question-id="@q.QuestionId">
            <span>@q.Text <span class="text-gray-500 ml-2">[@q.QuestionFormat]</span></span>
            <span id="arrow-@q.QuestionId" class="text-gray-300 ml-2">@(canBranch ? "v" : "")</span>
        </button>
        <button type="button"
                class="question-edit-btn border-l border-gray-500 px-3 text-gray-400 hover:text-white hover:bg-gray-700 transition"
                data-question-id="@q.QuestionId"
                data-text="@q.Text"
                data-format="@q.QuestionFormat"
                data-answers="@System.Text.Json.JsonSerializer.Serialize(q.AnswerChoices)"
                data-section-id="@(q.SectionId?.ToString() ?? "")">✎</button>
        <form method="post" asp-controller="Question" asp-action="Delete"
              asp-route-projectId="@ViewData["ProjectId"]"
              asp-route-questionId="@q.QuestionId"
              asp-route-aiAssistance="@(ViewData["AiAssistance"]?.ToString() ?? "ProActive")">
            <button type="submit"
                    class="border-l border-gray-500 px-3 text-gray-400 hover:text-white hover:bg-red-800 transition h-full">✕</button>
        </form>
    </div>

    @if (canBranch)
    {
        <div id="answers-@q.QuestionId" class="@(depth == 0 ? "" : "hidden")">
            @foreach (var trigger in triggerValues)
            {
                var children = all
                    .Where(x => x.ParentQuestionId == q.QuestionId && x.ParentTriggerValue == trigger)
                    .OrderBy(x => x.Position)
                    .ToList();
                var endsSurvey = q.EndingAnswers.Contains(trigger);

                <div class="answer-group pl-4 border-l border-gray-700 ml-2 mt-2">
                    <div class="flex items-center gap-2 py-1 text-gray-300">
                        <span class="flex-1">↳ @trigger</span>
                        <label class="text-xs text-gray-400 flex items-center gap-1">
                            <input type="checkbox"
                                   class="ending-answer-toggle"
                                   data-question-id="@q.QuestionId"
                                   data-trigger-value="@trigger"
                                   @(endsSurvey ? "checked" : "") />
                            Beëindig enquête
                        </label>
                    </div>

                    @foreach (var child in children)
                    {
                        <partial name="_QuestionNode" model="new QuestionNodeViewModel { Question = child, AllQuestions = all, Depth = depth + 1 }" />
                    }

                    <div class="drop-zone border border-dashed border-gray-600 text-gray-500 text-center py-2 my-1 text-xs"
                         data-parent-id="@q.QuestionId"
                         data-parent-trigger="@trigger">
                        Sleep hier om een subvraag aan dit antwoord toe te voegen
                    </div>
                </div>
            }
        </div>
    }
</div>
