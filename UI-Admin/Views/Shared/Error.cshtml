@model SynapseEnqueteManagement.UI.Admin.Models.ErrorViewModel
@inject IViewLocalizer L
@{
    ViewData["Title"] = L["PageTitle"].Value;
}

<h1 class="text-danger">@L["Heading"]</h1>
<h2 class="text-danger">@L["Subheading"]</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>@L["RequestIdLabel"]</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>@L["DevModeHeading"]</h3>
<p>
    @L["DevModeP1"]
</p>
<p>
    <strong>@L["DevModeP2Warning"]</strong>
    @L["DevModeP2Body"]
</p>
