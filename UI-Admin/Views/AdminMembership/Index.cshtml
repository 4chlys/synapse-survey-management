@using SynapseEnqueteManagement.UI.Admin.Models.Platform
@model PlatformAdminsViewModel
@inject IViewLocalizer L
@{
    ViewData["Title"] = L["PageTitle"].Value;
    ViewData["ActiveSection"] = "Admins";
    Layout = "_Layout";
    var isSystemAdmin = User.IsInRole("SystemAdmin");
    var isLastAdmin = Model.Admins.Count == 1;
}

<div class="max-w-2xl">
    <h1 class="font-heading font-bold text-2xl text-base-content mb-6">@L["Heading"]</h1>

    @* Admins table *@
    <div class="card bg-base-100 shadow-sm mb-6">
        <div class="card-body p-0 overflow-x-auto">
            @if (!Model.Admins.Any())
            {
                <p class="text-sm text-base-content/60 italic p-4">@L["NoAdmins"]</p>
            }
            else
            {
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>@L["TableUsername"]</th>
                            <th>@L["TableEmail"]</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var admin in Model.Admins)
                        {
                            <tr class="hover">
                                <td class="text-base-content">@admin.UserName</td>
                                <td class="text-base-content/60">@admin.Email</td>
                                <td>
                                    @if (isSystemAdmin || !isLastAdmin)
                                    {
                                        var confirmMsg = isLastAdmin
                                            ? string.Format(L["RemoveConfirmLastAdmin"].Value, admin.Email)
                                            : string.Format(L["RemoveConfirm"].Value, admin.Email);
                                        <form asp-action="RemoveAdmin" asp-route-id="@Model.ProjectPlatformId"
                                              method="post" class="inline"
                                              onsubmit="return confirm('@confirmMsg')">
                                            <input type="hidden" name="userId" value="@admin.UserId" />
                                            <button type="submit" class="btn btn-ghost btn-xs text-error">@L["RemoveButton"]</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    @if (TempData["EmailFailed"] is true)
    {
        <div class="alert alert-warning mb-6">
            <p class="text-sm">@L["EmailFailedNotice"]</p>
        </div>
    }

    @if (TempData["InviteLink"] is string inviteLink)
    {
        <div class="alert alert-success flex flex-col items-start gap-2 mb-6">
            <p class="text-sm font-medium">@L["InviteLinkNotice"]</p>
            <div class="flex items-center gap-2 w-full">
                <input id="invite-link" type="text" readonly value="@inviteLink"
                       class="input input-bordered input-sm w-full font-mono text-xs bg-base-100 text-base-content" />
                <button type="button" onclick="navigator.clipboard.writeText(document.getElementById('invite-link').value)"
                        class="btn btn-sm btn-ghost">@L["CopyButton"]</button>
            </div>
        </div>
    }

    @* Add admin inline form *@
    <div class="card bg-base-100 shadow-sm">
        <div class="card-body gap-4">
            <h2 class="font-semibold text-base-content">@L["AddHeading"]</h2>

            <div asp-validation-summary="ModelOnly"
                 class="text-sm text-error border border-error bg-error/10 px-4 py-3 rounded"></div>

            <form asp-action="AddAdmin" asp-route-id="@Model.ProjectPlatformId"
                  method="post" class="flex flex-col gap-4">

                <label class="form-control">
                    <div class="label"><span class="label-text text-xs font-medium">@L["EmailLabel"]</span></div>
                    <input type="email" name="Email" class="input input-bordered w-full"
                           placeholder="@L["EmailPlaceholder"]" required />
                </label>

                <label class="label cursor-pointer justify-start gap-2">
                    <input type="checkbox" name="SendEmail" value="true" checked class="checkbox checkbox-sm" />
                    <input type="hidden" name="SendEmail" value="false" />
                    <span class="label-text text-xs">@L["SendEmailLabel"]</span>
                </label>

                <div>
                    <button type="submit" class="btn btn-primary btn-sm">@L["AddButton"]</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
