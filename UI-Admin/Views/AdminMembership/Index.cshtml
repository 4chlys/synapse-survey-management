@using SynapseEnqueteManagement.UI.Admin.Models.Platform
@model PlatformAdminsViewModel
@inject IViewLocalizer L
@inject IHtmlLocalizer<SharedResource> Shared
@{
    ViewData["Title"] = L["PageTitle"].Value;
    ViewData["ActiveSection"] = "Admins";
    Layout = "_Layout";
    var isSystemAdmin = User.IsInRole("SystemAdmin");
    var isLastAdmin = Model.Admins.Count == 1;
}

<div>
    <div class="mb-8">
        <h1 class="font-heading font-bold text-2xl text-base-content">@L["Heading"]</h1>
        <p class="text-sm text-base-content/50 mt-1">@Model.Admins.Count @L["TableUsername"].Value.ToLower() @(Model.Admins.Count == 1 ? "member" : "members")</p>
    </div>

    @* ── Invite link banner (full width, shown after successful invite) ── *@
    @if (TempData["InviteLink"] is string inviteLink)
    {
        <div class="settings-card settings-card--invite-banner mb-5" style="border-left-color: var(--color-success);">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-xl flex items-center justify-center shrink-0"
                     style="background: color-mix(in oklch, var(--color-success) 10%, transparent); color: var(--color-success);">
                    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
                    </svg>
                </div>
                <div class="flex-1 min-w-0">
                    <p class="text-sm font-semibold text-base-content">@L["InviteLinkNotice"]</p>
                    @if (TempData["EmailFailed"] is true)
                    {
                        <p class="text-xs text-warning mt-0.5">@L["EmailFailedNotice"]</p>
                    }
                </div>
            </div>
            <div class="flex items-center gap-2 mt-3">
                <input id="invite-link" type="text" readonly value="@inviteLink"
                       class="input input-bordered input-sm w-full font-mono text-xs bg-base-200/50 text-base-content" />
                <button type="button" data-copy-from="#invite-link"
                        class="btn btn-sm btn-ghost shrink-0">@L["CopyButton"]</button>
            </div>
        </div>
    }
    else if (TempData["EmailFailed"] is true)
    {
        <div class="settings-card mb-5" style="border-left-color: var(--color-warning);">
            <p class="text-sm text-warning">@L["EmailFailedNotice"]</p>
        </div>
    }

    <div class="settings-grid">

        @* ── Left: Admin roster ── *@
        <div class="settings-card settings-card--general" style="min-height: 0;">
            <div class="settings-card-header">
                <div class="settings-card-icon settings-card-icon--general">
                    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/>
                        <path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/>
                    </svg>
                </div>
                <div>
                    <h2 class="font-heading font-semibold text-base text-base-content">@L["TableUsername"]</h2>
                    <p class="text-xs text-base-content/40 mt-0.5">@Model.Admins.Count @(Model.Admins.Count == 1 ? "admin" : "admins")</p>
                </div>
            </div>

            @if (!Model.Admins.Any())
            {
                <div class="flex flex-col items-center justify-center py-10 gap-3">
                    <div class="w-14 h-14 rounded-2xl flex items-center justify-center bg-base-200 text-base-content/20">
                        <svg width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                            <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/>
                            <path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/>
                        </svg>
                    </div>
                    <p class="text-sm text-base-content/40">@L["NoAdmins"]</p>
                </div>
            }
            else
            {
                <div class="flex flex-col gap-2">
                    @{ var idx = 0; }
                    @foreach (var admin in Model.Admins)
                    {
                        var initial = (admin.UserName?.FirstOrDefault().ToString() ?? admin.Email?.FirstOrDefault().ToString() ?? "?").ToUpper();
                        var hue = (admin.Email?.GetHashCode() ?? 0) % 360;
                        if (hue < 0) hue += 360;
                        <div class="admin-roster-row" style="animation-delay: @(idx * 0.04)s;">
                            <div class="admin-avatar" style="--avatar-hue: @hue;">@initial</div>
                            <div class="min-w-0 flex-1">
                                <p class="text-sm font-semibold text-base-content truncate">@admin.UserName</p>
                                <p class="text-xs text-base-content/40 truncate">@admin.Email</p>
                            </div>
                            @if (isSystemAdmin || !isLastAdmin)
                            {
                                var confirmMsg = isLastAdmin
                                    ? string.Format(L["RemoveConfirmLastAdmin"].Value, admin.Email)
                                    : string.Format(L["RemoveConfirm"].Value, admin.Email);
                                <form asp-action="RemoveAdmin" asp-route-id="@Model.ProjectPlatformId"
                                      method="post" class="shrink-0"
                                      data-confirm-submit="@confirmMsg">
                                    <input type="hidden" name="userId" value="@admin.UserId" />
                                    <button type="submit" class="admin-remove-btn">
                                        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                            <path d="M18 6L6 18M6 6l12 12"/>
                                        </svg>
                                    </button>
                                </form>
                            }
                        </div>
                        idx++;
                    }
                </div>
            }
        </div>

        @* ── Right: Invite form ── *@
        <div class="settings-card settings-card--ai">
            <div class="settings-card-header">
                <div class="settings-card-icon settings-card-icon--ai">
                    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M16 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="8.5" cy="7" r="4"/>
                        <line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/>
                    </svg>
                </div>
                <div>
                    <h2 class="font-heading font-semibold text-base text-base-content">@L["AddHeading"]</h2>
                    <p class="text-xs text-base-content/40 mt-0.5">@L["EmailPlaceholder"]</p>
                </div>
            </div>

            <div asp-validation-summary="ModelOnly"
                 class="text-sm text-error border border-error/30 bg-error/5 px-4 py-3 rounded-lg mb-4 empty:hidden"></div>

            <form asp-action="AddAdmin" asp-route-id="@Model.ProjectPlatformId"
                  method="post" class="flex flex-col gap-4 flex-1">

                <label class="form-control">
                    <div class="label"><span class="label-text text-xs font-medium">@L["EmailLabel"]</span></div>
                    <input type="email" name="Email" class="input input-bordered w-full input-sm"
                           placeholder="@L["EmailPlaceholder"]" required />
                </label>

                <label class="label cursor-pointer justify-start gap-2">
                    <input type="checkbox" name="SendEmail" value="true" checked class="checkbox checkbox-sm checkbox-primary" />
                    <input type="hidden" name="SendEmail" value="false" />
                    <span class="label-text text-xs">@L["SendEmailLabel"]</span>
                </label>

                <div class="flex justify-end mt-auto pt-3">
                    <button type="submit" class="btn btn-primary btn-sm gap-1.5">
                        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                        </svg>
                        @L["AddButton"]
                    </button>
                </div>
            </form>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
