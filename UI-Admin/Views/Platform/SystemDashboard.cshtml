@using SynapseEnqueteManagement.UI.Admin.Models.Platform
@model SystemDashboardViewModel
@inject IViewLocalizer L
@inject IHtmlLocalizer<SharedResource> Shared
@{
    ViewData["Title"] = L["PageTitle"].Value;
    ViewData["ActiveSection"] = "SystemDashboard";
    Layout = "_Layout";

    var totalPlatforms = Model.Platforms.Count;
    var totalActive = Model.Platforms.Sum(p => p.ActiveProjectCount);
    var totalDraft = Model.Platforms.Sum(p => p.DraftProjectCount);
    var totalArchived = Model.Platforms.Sum(p => p.ArchivedProjectCount);
    var totalAdmins = Model.Platforms.Sum(p => p.AdminCount);
    var totalParticipants = Model.Platforms.Sum(p => p.ParticipantCount);
    Func<double, string> FormatSeconds = (seconds) =>
    {
        if (seconds <= 0) return "—";
        var ts = TimeSpan.FromSeconds(seconds);
        return ts.TotalMinutes >= 1
            ? $"{(int)ts.TotalMinutes}m {ts.Seconds}s"
            : $"{ts.Seconds}s";
    };
}

<div class="w-full">
    <div class="flex items-center justify-between mb-8">
        <div>
            <h1 class="font-heading font-bold text-2xl text-base-content">@L["Heading"]</h1>
            <p class="text-sm text-base-content/40 mt-0.5">@totalPlatforms @L["StatPlatforms"].Value.ToLower()</p>
        </div>
        <button type="button" class="btn-action-outline"
                data-open-modal="system-export-modal">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path d="M12 3v12m0 0l-4-4m4 4l4-4M4 17v2a2 2 0 002 2h12a2 2 0 002-2v-2"/>
            </svg>
            @L["ExportButton"]
        </button>
    </div>

    @* ── KPI stats ── *@
    <div class="grid grid-cols-2 sm:grid-cols-4 xl:grid-cols-8 gap-3 mb-10">

        <div class="card bg-base-100 shadow-sm" style="border-left: 3px solid var(--color-primary);">
            <div class="card-body gap-2 py-4 px-4">
                <div class="w-8 h-8 rounded-lg flex items-center justify-center"
                     style="background: color-mix(in oklch, var(--color-primary) 10%, transparent); color: var(--color-primary);">
                    <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2"/>
                    </svg>
                </div>
                <p class="text-2xl font-bold text-base-content leading-none">@totalPlatforms</p>
                <p class="text-xs text-base-content/50 leading-tight">@L["StatPlatforms"]</p>
            </div>
        </div>

        <div class="card bg-base-100 shadow-sm" style="border-left: 3px solid var(--color-success);">
            <div class="card-body gap-2 py-4 px-4">
                <div class="w-8 h-8 rounded-lg flex items-center justify-center"
                     style="background: color-mix(in oklch, var(--color-success) 10%, transparent); color: var(--color-success);">
                    <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <circle cx="12" cy="12" r="10"/><polyline points="9 12 11 14 15 10"/>
                    </svg>
                </div>
                <p class="text-2xl font-bold text-base-content leading-none">@totalActive</p>
                <p class="text-xs text-success font-semibold uppercase tracking-wide leading-tight">@L["StatActive"]</p>
                <p class="text-xs text-base-content/50 -mt-1">@L["StatProjects"]</p>
            </div>
        </div>

        <div class="card bg-base-100 shadow-sm" style="border-left: 3px solid var(--color-warning);">
            <div class="card-body gap-2 py-4 px-4">
                <div class="w-8 h-8 rounded-lg flex items-center justify-center"
                     style="background: color-mix(in oklch, var(--color-warning) 10%, transparent); color: var(--color-warning);">
                    <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/>
                        <path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/>
                    </svg>
                </div>
                <p class="text-2xl font-bold text-base-content leading-none">@totalDraft</p>
                <p class="text-xs text-warning font-semibold uppercase tracking-wide leading-tight">@L["StatDraft"]</p>
                <p class="text-xs text-base-content/50 -mt-1">@L["StatProjects"]</p>
            </div>
        </div>

        <div class="card bg-base-100 shadow-sm" style="border-left: 3px solid color-mix(in oklch, var(--color-base-content) 20%, transparent);">
            <div class="card-body gap-2 py-4 px-4">
                <div class="w-8 h-8 rounded-lg flex items-center justify-center bg-base-200 text-base-content/40">
                    <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <polyline points="21 8 21 21 3 21 3 8"/><rect x="1" y="3" width="22" height="5"/>
                        <line x1="10" y1="12" x2="14" y2="12"/>
                    </svg>
                </div>
                <p class="text-2xl font-bold text-base-content leading-none">@totalArchived</p>
                <p class="text-xs text-base-content/40 font-semibold uppercase tracking-wide leading-tight">@L["StatArchived"]</p>
                <p class="text-xs text-base-content/50 -mt-1">@L["StatProjects"]</p>
            </div>
        </div>

        <div class="card bg-base-100 shadow-sm" style="border-left: 3px solid var(--color-info);">
            <div class="card-body gap-2 py-4 px-4">
                <div class="w-8 h-8 rounded-lg flex items-center justify-center"
                     style="background: color-mix(in oklch, var(--color-info) 10%, transparent); color: var(--color-info);">
                    <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/>
                        <path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/>
                    </svg>
                </div>
                <p class="text-2xl font-bold text-base-content leading-none">@totalAdmins</p>
                <p class="text-xs text-base-content/50 leading-tight">@L["StatAdmins"]</p>
            </div>
        </div>

        <div class="card bg-base-100 shadow-sm" style="border-left: 3px solid var(--color-secondary);">
            <div class="card-body gap-2 py-4 px-4">
                <div class="w-8 h-8 rounded-lg flex items-center justify-center"
                     style="background: color-mix(in oklch, var(--color-secondary) 10%, transparent); color: var(--color-secondary);">
                    <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/>
                    </svg>
                </div>
                <p class="text-2xl font-bold text-base-content leading-none">@totalParticipants</p>
                <p class="text-xs text-base-content/50 leading-tight">@L["StatParticipants"]</p>
            </div>
        </div>

        <div class="card bg-base-100 shadow-sm" style="border-left: 3px solid var(--color-accent);">
            <div class="card-body gap-2 py-4 px-4">
                <div class="w-8 h-8 rounded-lg flex items-center justify-center"
                     style="background: color-mix(in oklch, var(--color-accent) 10%, transparent); color: var(--color-accent);">
                    <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                    </svg>
                </div>
                <p class="text-xl font-bold text-base-content leading-none">@FormatSeconds(Model.AvgCompletionSeconds)</p>
                <p class="text-xs text-base-content/50 leading-tight">@L["StatAvgTime"]</p>
            </div>
        </div>

        <div class="card bg-base-100 shadow-sm" style="border-left: 3px solid var(--color-accent);">
            <div class="card-body gap-2 py-4 px-4">
                <div class="w-8 h-8 rounded-lg flex items-center justify-center"
                     style="background: color-mix(in oklch, var(--color-accent) 10%, transparent); color: var(--color-accent);">
                    <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/>
                        <line x1="6" y1="20" x2="6" y2="14"/>
                    </svg>
                </div>
                <p class="text-xl font-bold text-base-content leading-none">@FormatSeconds(Model.MedianCompletionSeconds)</p>
                <p class="text-xs text-base-content/50 leading-tight">@L["StatMedianTime"]</p>
            </div>
        </div>
    </div>

    @* ── Per-platform cards ── *@
    <div class="flex items-center gap-2.5 mb-5">
        <div class="w-8 h-8 rounded-xl flex items-center justify-center shrink-0"
             style="background: color-mix(in oklch, var(--color-primary) 10%, transparent); color: var(--color-primary);">
            <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2"/>
            </svg>
        </div>
        <h2 class="font-heading font-semibold text-base-content">@L["PlatformsHeading"]</h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-10">
        @{ var pIdx = 0; }
        @foreach (var platform in Model.Platforms)
        {
            var platformAiRows = Model.AiUsageByPlatform
                .Where(a => a.PlatformId == platform.ProjectPlatformId)
                .ToList();
            var accentColor = pIdx % 4 == 0 ? "var(--color-primary)"
                            : pIdx % 4 == 1 ? "var(--color-info)"
                            : pIdx % 4 == 2 ? "var(--color-secondary)"
                            : "var(--color-warning)";
            var iconBg = $"color-mix(in oklch, {accentColor} 10%, transparent)";

            <div class="settings-card" style="border-left-color: @accentColor; animation-delay: @(pIdx * 0.05)s;">
                <div class="settings-card-header">
                    <div class="settings-card-icon" style="background: @iconBg; color: @accentColor;">
                        @if (!string.IsNullOrEmpty(platform.LogoUrl))
                        {
                            <img src="@platform.LogoUrl" alt="@platform.Name"
                                 class="h-5 w-5 object-contain" />
                        }
                        else
                        {
                            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2"/>
                            </svg>
                        }
                    </div>
                    <div class="min-w-0 flex-1">
                        <h3 class="font-heading font-semibold text-sm text-base-content truncate">@platform.Name</h3>
                        </div>
                </div>

                <div class="grid grid-cols-4 gap-2 text-center mb-3">
                    <div>
                        <p class="text-lg font-bold text-base-content">@platform.ActiveProjectCount</p>
                        <p class="text-xs text-success font-semibold uppercase tracking-wide">@L["StatActive"]</p>
                    </div>
                    <div>
                        <p class="text-lg font-bold text-base-content">@platform.DraftProjectCount</p>
                        <p class="text-xs text-warning font-semibold uppercase tracking-wide">@L["StatDraft"]</p>
                    </div>
                    <div>
                        <p class="text-lg font-bold text-base-content">@platform.ArchivedProjectCount</p>
                        <p class="text-xs text-base-content/40 font-semibold uppercase tracking-wide">@L["StatArchived"]</p>
                    </div>
                    <div>
                        <p class="text-lg font-bold text-base-content">@platform.ParticipantCount</p>
                        <p class="text-xs text-base-content/50">@L["StatParticipants"]</p>
                    </div>
                </div>

                @if (platformAiRows.Count > 0)
                {
                    <details class="text-xs mb-3">
                        <summary class="cursor-pointer text-base-content/40 hover:text-base-content select-none transition-colors">
                            @L["AiBreakdownHeading"]
                        </summary>
                        <div class="overflow-x-auto mt-2">
                            <table class="table table-xs">
                                <thead>
                                    <tr>
                                        <th>@Shared["AiCol_Service"]</th>
                                        <th>@Shared["AiCol_Model"]</th>
                                        <th class="text-right">@Shared["AiCol_Requests"]</th>
                                        <th class="text-right">@Shared["AiCol_Cost"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var aiRow in platformAiRows)
                                    {
                                        <tr>
                                            <td>@aiRow.Service</td>
                                            <td>@aiRow.Model</td>
                                            <td class="text-right">@aiRow.RequestCount</td>
                                            <td class="text-right">@aiRow.CostEur.ToString("F4")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </details>
                }

                <div class="flex items-center gap-1.5 mt-auto pt-2">
                    <a asp-controller="Platform" asp-action="Dashboard"
                       asp-route-id="@platform.ProjectPlatformId"
                       class="btn btn-primary btn-xs flex-1">@L["OpenAction"]</a>
                    <a asp-controller="AdminMembership" asp-action="Index"
                       asp-route-id="@platform.ProjectPlatformId"
                       class="btn btn-ghost btn-xs">
                        <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/>
                            <path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/>
                        </svg>
                        @platform.AdminCount
                    </a>
                </div>
            </div>
            pIdx++;
        }
    </div>

    @* ── Charts ── *@
    <div class="flex items-center gap-2.5 mb-5">
        <div class="w-8 h-8 rounded-xl flex items-center justify-center shrink-0"
             style="background: color-mix(in oklch, var(--color-info) 10%, transparent); color: var(--color-info);">
            <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/>
                <line x1="6" y1="20" x2="6" y2="14"/>
            </svg>
        </div>
        <h2 class="font-heading font-semibold text-base-content">@L["ChartsHeading"]</h2>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-10">
        <div class="card bg-base-100 shadow-sm">
            <div class="card-body">
                <p class="text-sm font-medium text-base-content/60 mb-2">@L["Chart_ParticipantsTitle"]</p>
                <div data-widget="SystemParticipants"
                     data-i18n-series-participants="@L["Series_Participants"]"
                     class="relative" style="height:300px;"></div>
            </div>
        </div>
        <div class="card bg-base-100 shadow-sm">
            <div class="card-body">
                <p class="text-sm font-medium text-base-content/60 mb-2">@L["Chart_ProjectStatesTitle"]</p>
                <div data-widget="SystemProjectStates"
                     data-i18n-active="@L["StatActive"]"
                     data-i18n-draft="@L["StatDraft"]"
                     data-i18n-archived="@L["StatArchived"]"
                     class="relative" style="height:300px;"></div>
            </div>
        </div>
        <div class="card bg-base-100 shadow-sm">
            <div class="card-body">
                <p class="text-sm font-medium text-base-content/60 mb-2">@Shared["Chart_AiCostTitle"]</p>
                <div data-widget="SystemAiCost"
                     data-i18n-series-cost="@Shared["AiCol_Cost"]"
                     class="relative" style="height:300px;"></div>
            </div>
        </div>
        <div class="card bg-base-100 shadow-sm">
            <div class="card-body">
                <p class="text-sm font-medium text-base-content/60 mb-2">@L["Chart_CompletionTimeTitle"]</p>
                <div data-widget="SystemCompletionBoxplot"
                     data-i18n-series-completion-time="@L["Series_CompletionTime"]"
                     class="relative" style="height:300px;"></div>
            </div>
        </div>
    </div>

    @* ── Projects table ── *@
    <div class="flex items-center gap-2.5 mb-5">
        <div class="w-8 h-8 rounded-xl flex items-center justify-center shrink-0"
             style="background: color-mix(in oklch, var(--color-secondary) 10%, transparent); color: var(--color-secondary);">
            <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/>
                <line x1="3" y1="15" x2="21" y2="15"/><line x1="9" y1="3" x2="9" y2="21"/>
            </svg>
        </div>
        <h2 class="font-heading font-semibold text-base-content">@L["ProjectsTableHeading"]</h2>
    </div>

    <div class="card bg-base-100 shadow-sm mb-10">
        <div class="card-body p-0 overflow-x-auto">
            <table class="table table-zebra table-sm">
                <thead>
                    <tr>
                        <th>@L["Col_Platform"]</th>
                        <th>@L["Col_Project"]</th>
                        <th>@L["Col_State"]</th>
                        <th class="text-right">@L["Col_Participants"]</th>
                        <th class="text-right">@L["Col_AvgTime"]</th>
                        <th class="text-right">@L["Col_MedianTime"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Projects)
                    {
                        <tr>
                            <td class="text-base-content/60 text-xs">@row.PlatformName</td>
                            <td class="font-medium">@row.ProjectName</td>
                            <td>
                                @{
                                    var stateClass = row.State?.ToLower() switch {
                                        "active"   => "badge-success",
                                        "draft"    => "badge-warning",
                                        "archived" => "badge-ghost",
                                        _          => "badge-ghost"
                                    };
                                }
                                <span class="badge badge-xs @stateClass">@row.State</span>
                            </td>
                            <td class="text-right">@row.ParticipantCount</td>
                            <td class="text-right text-base-content/60">@FormatSeconds(row.AvgCompletionSeconds)</td>
                            <td class="text-right text-base-content/60">@FormatSeconds(row.MedianCompletionSeconds)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @* ── AI usage ── *@
    <div class="flex items-center gap-2.5 mb-5">
        <div class="w-8 h-8 rounded-xl flex items-center justify-center shrink-0"
             style="background: color-mix(in oklch, var(--color-warning) 10%, transparent); color: var(--color-warning);">
            <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
            </svg>
        </div>
        <h2 class="font-heading font-semibold text-base-content">@L["AiBreakdownHeading"]</h2>
    </div>

    <div class="card bg-base-100 shadow-sm mb-6">
        <div class="card-body p-0 overflow-x-auto">
            <table class="table table-zebra table-sm">
                <thead>
                    <tr>
                        <th>@Shared["AiCol_Service"]</th>
                        <th>@Shared["AiCol_Model"]</th>
                        <th class="text-right">@Shared["AiCol_InputTokens"]</th>
                        <th class="text-right">@Shared["AiCol_OutputTokens"]</th>
                        <th class="text-right">@Shared["AiCol_Requests"]</th>
                        <th class="text-right">@Shared["AiCol_Cost"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.AiUsageBySystem)
                    {
                        <tr>
                            <td>@row.Service</td>
                            <td class="text-base-content/60">@row.Model</td>
                            <td class="text-right font-mono text-xs">@row.InputTokens</td>
                            <td class="text-right font-mono text-xs">@row.OutputTokens</td>
                            <td class="text-right">@row.RequestCount</td>
                            <td class="text-right font-mono text-xs">€@row.CostEur.ToString("F4")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @* ── Export modal ── *@
    <dialog id="system-export-modal" class="modal"
            data-export-url="/api/system-stats/export">
        <div class="modal-box">
            <h3 class="font-bold text-lg mb-4">@L["ExportModalTitle"]</h3>

            <p class="text-sm font-medium mb-2">@L["ExportGroupHeading_Stats"]</p>
            <div class="form-control gap-2 mb-3">
                <label class="label cursor-pointer justify-start gap-3">
                    <input type="checkbox" class="checkbox checkbox-sm" data-system-section="platforms" checked />
                    <span class="label-text">@L["Section_Platforms"]</span>
                </label>
                <label class="label cursor-pointer justify-start gap-3">
                    <input type="checkbox" class="checkbox checkbox-sm" data-system-section="projects" checked />
                    <span class="label-text">@L["Section_Projects"]</span>
                </label>
                <label class="label cursor-pointer justify-start gap-3">
                    <input type="checkbox" class="checkbox checkbox-sm" data-system-section="summary" checked />
                    <span class="label-text">@L["Section_Summary"]</span>
                </label>
            </div>

            <p class="text-sm font-medium mb-2">@L["ExportGroupHeading_Ai"]</p>
            <div class="form-control gap-2 mb-4">
                <label class="label cursor-pointer justify-start gap-3">
                    <input type="checkbox" class="checkbox checkbox-sm" data-system-section="ai-system" checked />
                    <span class="label-text">@L["Section_AiSystem"]</span>
                </label>
                <label class="label cursor-pointer justify-start gap-3">
                    <input type="checkbox" class="checkbox checkbox-sm" data-system-section="ai-platforms" checked />
                    <span class="label-text">@L["Section_AiPlatforms"]</span>
                </label>
                <label class="label cursor-pointer justify-start gap-3">
                    <input type="checkbox" class="checkbox checkbox-sm" data-system-section="ai-projects" checked />
                    <span class="label-text">@L["Section_AiProjects"]</span>
                </label>
            </div>

            <div class="flex items-center gap-2 mb-3">
                <span class="text-sm font-medium">@L["FormatLabel"]</span>
                <select id="system-export-format" class="select select-bordered select-sm w-40">
                    <option value="xlsx">Excel (.xlsx)</option>
                    <option value="csv">CSV (.zip)</option>
                    <option value="png-zip">@L["FormatPngZip"]</option>
                </select>
            </div>

            <label class="label cursor-pointer justify-start gap-3 mb-4">
                <input type="checkbox" class="checkbox checkbox-sm" id="system-export-graphics" data-system-graphics checked />
                <span class="label-text">@L["IncludeGraphicsLabel"]</span>
            </label>

            <div class="modal-action">
                <form method="dialog">
                    <button class="btn-cancel">@L["CancelButton"]</button>
                </form>
                <button type="button" class="btn-save" id="system-export-download">@L["ExportButton"]</button>
            </div>
        </div>
        <form method="dialog" class="modal-backdrop"><button>close</button></form>
    </dialog>
