@using SynapseEnqueteManagement.UI.Admin.Models.Platform
@model PlatformDashboardViewModel
@inject IViewLocalizer L
@{
    ViewData["Title"] = Model.Name;
    ViewData["ActiveSection"] = "Dashboard";
    Layout = "_Layout";
}

<div class="w-full">
    <div class="flex items-center justify-between mb-6">
        <h1 class="font-heading font-bold text-2xl text-base-content">@Model.Name</h1>
        <a asp-action="Settings" asp-route-id="@Model.ProjectPlatformId"
           class="btn btn-ghost btn-sm gap-1.5">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="3"/><path d="M19.07 4.93a10 10 0 010 14.14M4.93 4.93a10 10 0 000 14.14"/>
            </svg>
            @L["SettingsLink"]
        </a>
    </div>

    @* Platform info card *@
    <div class="card bg-base-100 shadow-sm mb-6">
        <div class="card-body">
            <div class="flex items-center gap-4">
                @if (!string.IsNullOrEmpty(Model.LogoUrl))
                {
                    <img src="@Model.LogoUrl" alt="@Model.Name @L["LogoAltSuffix"]" class="h-14 w-auto object-contain" />
                }
                <div>
                    <p class="font-semibold text-base-content">@Model.Name</p>
                    @if (!string.IsNullOrEmpty(Model.WebsiteUrl))
                    {
                        <a href="@Model.WebsiteUrl" target="_blank" rel="noopener noreferrer"
                           class="text-sm text-base-content/60 hover:text-base-content transition underline underline-offset-2">
                            @Model.WebsiteUrl
                        </a>
                    }
                    else
                    {
                        <span class="text-sm text-base-content/40 italic">@L["NoWebsite"]</span>
                    }
                    <p class="text-xs text-base-content/40 mt-1">
                        @string.Format(L["CreatedAt"].Value, Model.CreatedAt.ToString("d MMMM yyyy"))
                    </p>
                </div>
            </div>
        </div>
    </div>

    @* Stats row *@
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6">
        <div class="card bg-base-100 shadow-sm">
            <div class="card-body items-center text-center gap-1">
                <p class="text-3xl font-bold text-base-content">@Model.ActiveProjectCount</p>
                <p class="text-xs font-semibold text-success uppercase tracking-wide">@L["StatActive"]</p>
                <p class="text-sm text-base-content/60">@L["StatProjects"]</p>
            </div>
        </div>
        <div class="card bg-base-100 shadow-sm">
            <div class="card-body items-center text-center gap-1">
                <p class="text-3xl font-bold text-base-content">@Model.DraftProjectCount</p>
                <p class="text-xs font-semibold text-warning uppercase tracking-wide">@L["StatDraft"]</p>
                <p class="text-sm text-base-content/60">@L["StatProjects"]</p>
            </div>
        </div>
        <div class="card bg-base-100 shadow-sm">
            <div class="card-body items-center text-center gap-1">
                <p class="text-3xl font-bold text-base-content">@Model.ArchivedProjectCount</p>
                <p class="text-xs font-semibold text-base-content/40 uppercase tracking-wide">@L["StatArchived"]</p>
                <p class="text-sm text-base-content/60">@L["StatProjects"]</p>
            </div>
        </div>
        <div class="card bg-base-100 shadow-sm">
            <div class="card-body items-center text-center gap-1">
                <p class="text-3xl font-bold text-base-content">@Model.ParticipantCount</p>
                <p class="text-sm text-base-content/60">@L["StatParticipants"]</p>
                <a asp-action="Admins" asp-route-id="@Model.ProjectPlatformId"
                   class="btn btn-ghost btn-xs mt-2">@L["AdminsLink"] →</a>
            </div>
        </div>
    </div>

    @* AI model info *@
    @if (!string.IsNullOrEmpty(Model.AiModelName))
    {
        <div class="card bg-base-100 shadow-sm mb-6">
            <div class="card-body py-3">
                <p class="text-sm text-base-content/60">
                    <span class="font-medium text-base-content">@L["AiModel"]:</span> @Model.AiModelName
                </p>
            </div>
        </div>
    }

    @* Live AI cost card *@
    <h2 class="font-semibold text-base-content mb-4">@L["LiveAiCostHeading"]</h2>
    <div class="card bg-base-100 shadow-sm mb-6" data-ai-cost-container data-platform-id="@Model.ProjectPlatformId" data-empty-label="@L["AiCost_Empty"]">
        <div class="card-body">
            <div class="overflow-x-auto">
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>@L["AiCost_Project"]</th>
                            <th class="text-right">@L["AiCost_InputTokens"]</th>
                            <th class="text-right">@L["AiCost_OutputTokens"]</th>
                            <th class="text-right">@L["AiCost_Cost"]</th>
                        </tr>
                    </thead>
                    <tbody data-ai-usage>
                        <tr><td colspan="4" class="text-center text-base-content/40 text-sm py-4">@L["AiCost_Loading"]</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @* Cost dashboard *@
    <h2 class="font-semibold text-base-content mb-4">@L["CostMonitoringHeading"]</h2>
    @if (!string.IsNullOrEmpty(Model.CostDashboardUrl))
    {
        <div class="card bg-base-100 shadow-sm">
            <div class="card-body p-0">
                <iframe src="@Model.CostDashboardUrl"
                        class="w-full rounded-2xl"
                        style="height:600px;border:none;"
                        title="@string.Format(L["CostIframeTitle"].Value, Model.Name)"
                        loading="lazy">
                </iframe>
            </div>
        </div>
    }
    else
    {
        <div class="card bg-base-100 shadow-sm">
            <div class="card-body text-center gap-2">
                <p class="text-sm text-base-content/60">@L["NoCostDashboard"]</p>
                <p class="text-xs text-base-content/40">
                    @Html.Raw(string.Format(L["AddCostDashboardHint"].Value,
                        $"<a href=\"{Url.Action("Settings", "Platform", new { id = Model.ProjectPlatformId })}\" class=\"underline hover:text-base-content transition\">{L["SettingsLink"].Value}</a>"))
                </p>
            </div>
        </div>
    }
</div>
