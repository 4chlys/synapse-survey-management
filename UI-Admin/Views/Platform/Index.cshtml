@using SynapseEnqueteManagement.UI.Admin.Models.Platform
@model IEnumerable<PlatformViewModel>
@{
    ViewData["Title"] = "Platform";
    ViewData["ActiveSection"] = "Platform";
    Layout = "_Layout";
}

<h1 class="font-heading font-bold text-2xl text-base-content mb-6">Platform</h1>

<div class="flex items-center justify-between mb-6">
    <div></div>
    <a asp-controller="Platform" asp-action="Create" class="btn btn-primary btn-sm">
        + Nieuw platform
    </a>
</div>

@if (!Model.Any())
{
    <div class="card bg-base-100 shadow-sm">
        <div class="card-body text-center text-base-content/60 text-sm">
            Geen platformen gevonden.
        </div>
    </div>
}
else
{
    <div class="card bg-base-100 shadow-sm">
        <div class="card-body p-0 overflow-x-auto">
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Naam</th>
                        <th>Logo</th>
                        <th>Website</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var platform in Model)
                    {
                        <tr class="hover">
                            <td class="text-base-content">@platform.Name</td>
                            <td>
                                @if (!string.IsNullOrEmpty(platform.LogoUrl))
                                {
                                    <img src="@platform.LogoUrl" alt="@platform.Name logo"
                                         class="h-8 w-auto object-contain" />
                                }
                                else
                                {
                                    <span class="text-base-content/60 text-xs italic">—</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(platform.WebsiteUrl))
                                {
                                    <a href="@platform.WebsiteUrl" target="_blank"
                                       class="text-base-content/60 hover:text-base-content transition underline underline-offset-2">
                                        @platform.WebsiteUrl
                                    </a>
                                }
                                else
                                {
                                    <span class="text-base-content/60 text-xs italic">—</span>
                                }
                            </td>
                            <td>
                                <div class="flex items-center gap-2 justify-end">
                                    <a asp-controller="Platform" asp-action="Edit"
                                       asp-route-id="@platform.ProjectPlatformId"
                                       class="btn btn-ghost btn-sm">
                                        Bewerken
                                    </a>
                                    <a asp-controller="Platform" asp-action="Detail"
                                       asp-route-id="@platform.ProjectPlatformId"
                                       class="btn btn-ghost btn-sm">
                                        Details
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
