@using SynapseEnqueteManagement.UI.Admin.Models.Platform
@model PlatformAdminsViewModel
@{
    ViewData["Title"] = "Beheerders";
    ViewData["ActiveSection"] = "Beheerders";
    Layout = "_Layout";
}

<div class="max-w-2xl">
    <h1 class="font-heading font-bold text-2xl text-base-content mb-6">Beheerders</h1>

    @* Admins table *@
    <div class="card bg-base-100 shadow-sm mb-6">
        <div class="card-body p-0 overflow-x-auto">
            @if (!Model.Admins.Any())
            {
                <p class="text-sm text-base-content/60 italic p-4">Geen beheerders gevonden.</p>
            }
            else
            {
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Gebruikersnaam</th>
                            <th>E-mail</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var admin in Model.Admins)
                        {
                            <tr class="hover">
                                <td class="text-base-content">@admin.UserName</td>
                                <td class="text-base-content/60">@admin.Email</td>
                                <td>
                                    <form asp-action="RemoveAdmin" asp-route-id="@Model.ProjectPlatformId"
                                          method="post" class="inline"
                                          onsubmit="return confirm('Beheerder @admin.Email verwijderen?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@admin.UserId" />
                                        <button type="submit" class="btn btn-ghost btn-xs text-error">Verwijderen</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    @* Add admin inline form *@
    <div class="card bg-base-100 shadow-sm">
        <div class="card-body gap-4">
            <h2 class="font-semibold text-base-content">Beheerder toevoegen</h2>

            <div asp-validation-summary="ModelOnly"
                 class="text-sm text-error border border-error bg-error/10 px-4 py-3 rounded"></div>

            <form asp-action="AddAdmin" asp-route-id="@Model.ProjectPlatformId"
                  method="post" class="flex flex-col gap-4">
                @Html.AntiForgeryToken()

                <label class="form-control">
                    <div class="label"><span class="label-text text-xs font-medium">E-mailadres</span></div>
                    <input type="email" name="Email" class="input input-bordered w-full"
                           placeholder="beheerder@voorbeeld.be" required />
                </label>

                <label class="form-control">
                    <div class="label"><span class="label-text text-xs font-medium">Wachtwoord</span></div>
                    <input type="password" name="Password" class="input input-bordered w-full"
                           placeholder="Minimaal 6 tekens" required minlength="6" />
                </label>

                <div>
                    <button type="submit" class="btn btn-primary btn-sm">Beheerder toevoegen</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}