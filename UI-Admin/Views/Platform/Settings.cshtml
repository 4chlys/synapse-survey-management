@using SynapseEnqueteManagement.UI.Admin.Models.Platform
@model PlatformSettingsViewModel
@inject IViewLocalizer L
@inject IHtmlLocalizer<SharedResource> Shared
@{
    ViewData["Title"] = L["PageTitle"].Value;
    ViewData["ActiveSection"] = "Settings";
    Layout = "_Layout";
}

<div class="mb-8">
    <h1 class="font-heading font-bold text-2xl text-base-content">@L["Heading"]</h1>
    <p class="text-sm text-base-content/40 mt-0.5">@Model.BasicInfo.Name</p>
</div>

@* ── Basic info ── *@
<div class="settings-card settings-card--general mb-6" style="max-width: 640px;">
    <div class="settings-card-header">
        <div class="settings-card-icon settings-card-icon--general">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2"/>
            </svg>
        </div>
        <div>
            <h2 class="font-heading font-semibold text-base text-base-content">@L["BasicInfoHeading"]</h2>
            <p class="text-xs text-base-content/40 mt-0.5">@L["NameLabel"], logo & website</p>
        </div>
    </div>

    <form asp-action="SaveBasicInfo" asp-route-id="@Model.ProjectPlatformId"
          method="post" class="flex flex-col gap-4">
        <input type="hidden" name="ProjectPlatformId" value="@Model.BasicInfo.ProjectPlatformId" />

        <label class="form-control">
            <div class="label"><span class="label-text font-medium">@L["NameLabel"] *</span></div>
            <input name="Name" value="@Model.BasicInfo.Name" class="input input-bordered w-full"
                   placeholder="@L["NamePlaceholder"]" />
        </label>

        <label class="form-control">
            <div class="label"><span class="label-text font-medium">@L["LogoLabel"]</span></div>
            <input name="LogoUrl" value="@Model.BasicInfo.LogoUrl" class="input input-bordered w-full"
                   placeholder="https://..." />
        </label>

        <label class="form-control">
            <div class="label"><span class="label-text font-medium">@L["WebsiteLabel"]</span></div>
            <input name="WebsiteUrl" value="@Model.BasicInfo.WebsiteUrl" class="input input-bordered w-full"
                   placeholder="https://..." />
        </label>

        <div class="flex justify-end mt-2">
            <button type="submit" class="btn btn-primary btn-sm">@Shared["Common_Save"]</button>
        </div>
    </form>
</div>

@* ── Configuration ── *@
<div class="settings-card settings-card--ai" style="max-width: 640px;">
    <div class="settings-card-header">
        <div class="settings-card-icon settings-card-icon--ai">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="3"/>
                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
            </svg>
        </div>
        <div>
            <h2 class="font-heading font-semibold text-base text-base-content">@L["ConfigHeading"]</h2>
            <p class="text-xs text-base-content/40 mt-0.5">@L["FeatureFlagsDivider"], @L["QuotasDivider"].Value.ToLower() & @L["ContactBillingDivider"].Value.ToLower()</p>
        </div>
    </div>

    <form asp-action="SaveConfiguration" asp-route-id="@Model.ProjectPlatformId"
          method="post" class="flex flex-col gap-5">
        <input type="hidden" name="ProjectPlatformId" value="@Model.Configuration.ProjectPlatformId" />

        @* Feature flags *@
        <div class="flex items-center gap-2 mb-1">
            <div class="w-5 h-5 rounded-md flex items-center justify-center shrink-0"
                 style="background: color-mix(in oklch, var(--color-info) 10%, transparent); color: var(--color-info);">
                <svg width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
                </svg>
            </div>
            <span class="text-xs font-bold text-base-content/40 uppercase tracking-widest">@L["FeatureFlagsDivider"]</span>
        </div>

        <label class="settings-mode-option @(Model.Configuration.AiAssistanceEnabled ? "settings-mode-option--active" : "")">
            <input type="hidden" name="AiAssistanceEnabled" value="false" />
            <input type="checkbox" name="AiAssistanceEnabled" value="true"
                   class="toggle toggle-primary toggle-sm"
                   @(Model.Configuration.AiAssistanceEnabled ? "checked" : "") />
            <div class="flex-1 min-w-0">
                <p class="text-sm font-medium text-base-content">@L["AiAssistanceToggle"]</p>
            </div>
        </label>

        <label class="settings-mode-option @(Model.Configuration.IdeationEnabled ? "settings-mode-option--active" : "")">
            <input type="hidden" name="IdeationEnabled" value="false" />
            <input type="checkbox" name="IdeationEnabled" value="true"
                   class="toggle toggle-primary toggle-sm"
                   @(Model.Configuration.IdeationEnabled ? "checked" : "") />
            <div class="flex-1 min-w-0">
                <p class="text-sm font-medium text-base-content">@L["IdeationToggle"]</p>
            </div>
        </label>

        @* Quotas *@
        <div class="flex items-center gap-2 mt-3 mb-1">
            <div class="w-5 h-5 rounded-md flex items-center justify-center shrink-0"
                 style="background: color-mix(in oklch, var(--color-secondary) 10%, transparent); color: var(--color-secondary);">
                <svg width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/>
                    <line x1="6" y1="20" x2="6" y2="14"/>
                </svg>
            </div>
            <span class="text-xs font-bold text-base-content/40 uppercase tracking-widest">@L["QuotasDivider"]</span>
        </div>

        <div class="grid grid-cols-2 gap-4">
            <label class="form-control">
                <div class="label"><span class="label-text font-medium">@L["MaxProjectsLabel"]</span></div>
                <input name="MaxProjects" type="number" min="0"
                       value="@Model.Configuration.MaxProjects"
                       class="input input-bordered w-full no-spinner" placeholder="@L["UnlimitedPlaceholder"]" />
            </label>
            <label class="form-control">
                <div class="label"><span class="label-text font-medium">@L["MaxAdminsLabel"]</span></div>
                <input name="MaxAdmins" type="number" min="0"
                       value="@Model.Configuration.MaxAdmins"
                       class="input input-bordered w-full no-spinner" placeholder="@L["UnlimitedPlaceholder"]" />
            </label>
        </div>

        @* Contact & billing *@
        <div class="flex items-center gap-2 mt-3 mb-1">
            <div class="w-5 h-5 rounded-md flex items-center justify-center shrink-0"
                 style="background: color-mix(in oklch, var(--color-warning) 10%, transparent); color: var(--color-warning);">
                <svg width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/>
                </svg>
            </div>
            <span class="text-xs font-bold text-base-content/40 uppercase tracking-widest">@L["ContactBillingDivider"]</span>
        </div>

        <label class="form-control">
            <div class="label"><span class="label-text font-medium">@L["ContactNameLabel"]</span></div>
            <input name="ContactName" value="@Model.Configuration.ContactName"
                   class="input input-bordered w-full"
                   placeholder="@L["ContactNamePlaceholder"]" />
        </label>

        <label class="form-control">
            <div class="label"><span class="label-text font-medium">@L["ContactEmailLabel"]</span></div>
            <input name="ContactEmail" type="email" value="@Model.Configuration.ContactEmail"
                   class="input input-bordered w-full"
                   placeholder="@L["ContactEmailPlaceholder"]" />
        </label>

        <label class="form-control">
            <div class="label"><span class="label-text font-medium">@L["BillingReferenceLabel"]</span></div>
            <input name="BillingReference" value="@Model.Configuration.BillingReference"
                   class="input input-bordered w-full"
                   placeholder="@L["BillingReferencePlaceholder"]" />
        </label>

        @* AI monitoring *@
        <div class="flex items-center gap-2 mt-3 mb-1">
            <div class="w-5 h-5 rounded-md flex items-center justify-center shrink-0"
                 style="background: color-mix(in oklch, var(--color-accent) 10%, transparent); color: var(--color-accent);">
                <svg width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/>
                    <line x1="12" y1="17" x2="12" y2="21"/>
                </svg>
            </div>
            <span class="text-xs font-bold text-base-content/40 uppercase tracking-widest">@L["AiMonitoringDivider"]</span>
        </div>

        <label class="form-control">
            <div class="label"><span class="label-text font-medium">@L["AiModelNameLabel"]</span></div>
            <input name="AiModelName" value="@Model.Configuration.AiModelName"
                   class="input input-bordered w-full"
                   placeholder="@L["AiModelNamePlaceholder"]" />
            <span class="label-text-alt text-base-content/40 mt-1">@L["AiModelNameHint"]</span>
        </label>

        <label class="form-control">
            <div class="label"><span class="label-text font-medium">@L["CostDashboardUrlLabel"]</span></div>
            <input name="CostDashboardUrl" type="url" value="@Model.Configuration.CostDashboardUrl"
                   class="input input-bordered w-full"
                   placeholder="https://lookerstudio.google.com/embed/..." />
            <span class="label-text-alt text-base-content/40 mt-1">@L["CostDashboardUrlHint"]</span>
        </label>

        <div class="flex justify-end mt-2">
            <button type="submit" class="btn btn-primary btn-sm">@Shared["Common_Save"]</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
