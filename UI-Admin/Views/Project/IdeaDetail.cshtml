@model SynapseEnqueteManagement.UI.Admin.Models.Project.IdeaDetailViewModel
@inject IViewLocalizer L
@{
    ViewData["Title"] = L["PageTitle"].Value;
    Layout = "_Layout";

    string IdeaStatusBadge(string s) => s switch {
        "Approved"  => "badge-success",
        "Declined"  => "badge-error",
        "Flagged"   => "badge-warning",
        "Unflagged" => "badge-info",
        _           => "badge-ghost"
    };
    string IdeaStatusLabel(string s) => s switch {
        "Approved"  => L["IdeaStatus_Approved"].Value,
        "Declined"  => L["IdeaStatus_Declined"].Value,
        "Flagged"   => L["IdeaStatus_Flagged"].Value,
        "Unflagged" => L["IdeaStatus_Unflagged"].Value,
        _           => s
    };
    string CommentStatusBadge(string s) => s switch {
        "Approved"  => "badge-success",
        "Declined"  => "badge-error",
        "Flagged"   => "badge-warning",
        "Unflagged" => "badge-info",
        _           => "badge-ghost"
    };
    string CommentStatusLabel(string s) => s switch {
        "Approved"  => L["CommentStatus_Approved"].Value,
        "Declined"  => L["CommentStatus_Declined"].Value,
        "Flagged"   => L["CommentStatus_Flagged"].Value,
        "Unflagged" => L["CommentStatus_Unflagged"].Value,
        _           => s
    };
    var ideasUrl = Model.BackUrl;
}

<div class="w-full max-w-3xl">

    <!-- Back link -->
    <nav aria-label="breadcrumb" class="mb-5">
        <a href="@Model.BackUrl"
           class="inline-flex items-center gap-1.5 text-sm text-base-content/50 hover:text-base-content transition-colors">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
            </svg>
            @L["BackLink"]
        </a>
    </nav>

    <!-- Idea card -->
    <article class="card bg-base-100 shadow-sm border border-base-200 mb-6">
        <div class="card-body gap-4">

            <!-- Category + status row -->
            <div class="flex items-center justify-between gap-3 flex-wrap">
                <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-primary uppercase tracking-wide">
                    <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M7 7h.01M7 3h5a1.99 1.99 0 011.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.99 1.99 0 013 12V7a4 4 0 014-4z"/>
                    </svg>
                    @Model.CategoryName
                </span>
                <div class="flex items-center gap-2">
                    <span class="badge @IdeaStatusBadge(Model.Status)">@IdeaStatusLabel(Model.Status)</span>
                    <span class="text-xs text-base-content/40">@Model.CreatedAt.ToString("dd MMM yyyy HH:mm")</span>
                </div>
            </div>

            <!-- Image -->
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <a href="@Model.ImageUrl" target="_blank" class="block rounded-xl overflow-hidden bg-base-200 aspect-video">
                    <img src="@Model.ImageUrl" alt="" class="w-full h-full object-cover" />
                </a>
            }

            <!-- Description -->
            <p class="text-base text-base-content leading-relaxed">@Model.Description</p>

            <!-- Author -->
            <div class="flex items-center gap-1.5 pt-1 border-t border-base-200 text-xs text-base-content/50">
                <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                </svg>
                @L["SubmittedBy"]:
                @if (!string.IsNullOrEmpty(Model.ParticipantEmail))
                {
                    <a href="mailto:@Model.ParticipantEmail" class="link link-primary">@Model.ParticipantEmail</a>
                }
                else
                {
                    <span>@L["Anonymous"]</span>
                }
            </div>

            <!-- Emoji reactions on the idea -->
            @if (Model.EmojiReactions.Any())
            {
                <div class="flex flex-wrap gap-2 pt-1">
                    @foreach (var r in Model.EmojiReactions)
                    {
                        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold bg-base-200 border border-base-300 text-base-content/70">
                            <span class="text-base leading-none">@r.Symbol</span>
                            @r.Count
                        </span>
                    }
                </div>
            }

            <!-- Moderation actions -->
            <div class="flex flex-wrap gap-2 pt-2 border-t border-base-200">
                @if (Model.Status != "Approved")
                {
                    <form asp-action="ApproveIdea" method="post" class="inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="projectId" value="@Model.ProjectId" />
                        <input type="hidden" name="ideaId" value="@Model.IdeaId" />
                        <input type="hidden" name="returnUrl" value="@ideasUrl" />
                        <button type="submit" class="btn-approve">
                            <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M20 6L9 17l-5-5"/></svg>
                            @L["ActionApprove"]
                        </button>
                    </form>
                }
                @if (Model.Status != "Declined")
                {
                    <form asp-action="DeclineIdea" method="post" class="inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="projectId" value="@Model.ProjectId" />
                        <input type="hidden" name="ideaId" value="@Model.IdeaId" />
                        <input type="hidden" name="returnUrl" value="@ideasUrl" />
                        <button type="submit" class="btn-decline">
                            <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M18 6L6 18M6 6l12 12"/></svg>
                            @L["ActionDecline"]
                        </button>
                    </form>
                }
                @if (Model.Status != "Flagged")
                {
                    <form asp-action="FlagIdea" method="post" class="inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="projectId" value="@Model.ProjectId" />
                        <input type="hidden" name="ideaId" value="@Model.IdeaId" />
                        <input type="hidden" name="returnUrl" value="@ideasUrl" />
                        <button type="submit" class="btn-flag">
                            <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/></svg>
                            @L["ActionFlag"]
                        </button>
                    </form>
                }
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <form asp-action="RemoveIdeaImage" method="post" class="inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="projectId" value="@Model.ProjectId" />
                        <input type="hidden" name="ideaId" value="@Model.IdeaId" />
                        <input type="hidden" name="returnUrl" value="@ideasUrl" />
                        <button type="submit" class="btn-cancel" data-confirm="@L["ConfirmRemoveImage"].Value">
                            <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
                            @L["ActionRemoveImage"]
                        </button>
                    </form>
                }
            </div>

        </div>
    </article>

    <!-- Comments section -->
    <section>
        <div class="flex items-center gap-3 mb-4">
            <h2 class="font-heading font-semibold text-sm text-base-content/60 uppercase tracking-widest">
                @L["CommentsHeading"] (@Model.Comments.Count)
            </h2>
            <div class="flex-1 h-px bg-base-200"></div>
        </div>

        @if (!Model.Comments.Any())
        {
            <div class="card bg-base-100 shadow-sm border border-base-200">
                <div class="card-body items-center text-center py-12">
                    <svg class="w-9 h-9 text-base-content/20 mb-2" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                    </svg>
                    <p class="text-sm text-base-content/40 italic">@L["NoComments"]</p>
                </div>
            </div>
        }
        else
        {
            <div class="flex flex-col gap-3">
                @foreach (var comment in Model.Comments)
                {
                    string cardBorder = comment.ModerationStatus switch {
                        "Flagged"  => "border-warning/30 bg-warning/5",
                        "Declined" => "border-base-300 opacity-60",
                        _          => "border-base-200"
                    };
                    <article class="card bg-base-100 shadow-sm border @cardBorder">
                        <div class="card-body gap-3 py-4">

                            <!-- Comment header: status + date -->
                            <div class="flex items-center justify-between gap-2 flex-wrap">
                                <span class="badge @CommentStatusBadge(comment.ModerationStatus) badge-sm">
                                    @CommentStatusLabel(comment.ModerationStatus)
                                </span>
                                <span class="text-xs text-base-content/35">@comment.CreatedAt.ToString("dd MMM yyyy HH:mm")</span>
                            </div>

                            <!-- Comment text -->
                            <p class="text-sm text-base-content leading-relaxed">@comment.Text</p>

                            <!-- Comment footer: author + reactions -->
                            <div class="flex items-center justify-between gap-2 flex-wrap pt-1 border-t border-base-200">
                                <div class="flex items-center gap-1.5 text-xs text-base-content/50">
                                    <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                                    </svg>
                                    @if (!string.IsNullOrEmpty(comment.ParticipantEmail))
                                    {
                                        <a href="mailto:@comment.ParticipantEmail" class="link link-primary">@comment.ParticipantEmail</a>
                                    }
                                    else
                                    {
                                        <span>@L["Anonymous"]</span>
                                    }
                                </div>

                                @if (comment.EmojiReactions.Any())
                                {
                                    <div class="flex flex-wrap gap-1.5">
                                        @foreach (var r in comment.EmojiReactions)
                                        {
                                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs bg-base-200 border border-base-300 text-base-content/60">
                                                <span class="text-sm leading-none">@r.Symbol</span>
                                                @r.Count
                                            </span>
                                        }
                                    </div>
                                }
                            </div>

                            <!-- Comment moderation actions -->
                            <div class="flex flex-wrap gap-1.5 pt-1">
                                @if (comment.ModerationStatus != "Approved")
                                {
                                    <form asp-action="ApproveComment" method="post" class="inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="projectId" value="@Model.ProjectId" />
                                        <input type="hidden" name="ideaId" value="@Model.IdeaId" />
                                        <input type="hidden" name="commentId" value="@comment.CommentId" />
                                        <input type="hidden" name="returnUrl" value="@Url.Action("IdeaDetail", new { Model.ProjectId, Model.IdeaId, Model.CategoryId, categoryName = Model.CategoryName, returnUrl = Model.BackUrl })" />
                                        <button type="submit" class="btn-mod-approve">
                                            <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M20 6L9 17l-5-5"/></svg>
                                            @L["ActionApprove"]
                                        </button>
                                    </form>
                                }
                                @if (comment.ModerationStatus != "Declined")
                                {
                                    <form asp-action="DeclineComment" method="post" class="inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="projectId" value="@Model.ProjectId" />
                                        <input type="hidden" name="ideaId" value="@Model.IdeaId" />
                                        <input type="hidden" name="commentId" value="@comment.CommentId" />
                                        <input type="hidden" name="returnUrl" value="@Url.Action("IdeaDetail", new { Model.ProjectId, Model.IdeaId, Model.CategoryId, categoryName = Model.CategoryName, returnUrl = Model.BackUrl })" />
                                        <button type="submit" class="btn-mod-decline">
                                            <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M18 6L6 18M6 6l12 12"/></svg>
                                            @L["ActionDecline"]
                                        </button>
                                    </form>
                                }
                                @if (comment.ModerationStatus != "Flagged")
                                {
                                    <form asp-action="FlagComment" method="post" class="inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="projectId" value="@Model.ProjectId" />
                                        <input type="hidden" name="ideaId" value="@Model.IdeaId" />
                                        <input type="hidden" name="commentId" value="@comment.CommentId" />
                                        <input type="hidden" name="returnUrl" value="@Url.Action("IdeaDetail", new { Model.ProjectId, Model.IdeaId, Model.CategoryId, categoryName = Model.CategoryName, returnUrl = Model.BackUrl })" />
                                        <button type="submit" class="btn-mod-flag">
                                            <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/></svg>
                                            @L["ActionFlag"]
                                        </button>
                                    </form>
                                }
                            </div>

                        </div>
                    </article>
                }
            </div>
        }
    </section>

</div>
