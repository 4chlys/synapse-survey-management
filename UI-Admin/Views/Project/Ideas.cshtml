@model SynapseEnqueteManagement.UI.Admin.Models.Project.IdeasViewModel
@{
    ViewData["Title"] = "Ideeën";
    Layout = "_Layout";
}

<div class="w-full">

    <!-- Header + summary badges -->
    <div class="flex flex-wrap items-start justify-between gap-3 mb-5">
        <div>
            <h1 class="font-heading font-bold text-2xl text-base-content">Ideeën</h1>
            <p class="text-sm text-base-content/50 mt-0.5">@Model.TotalCount ideeën in dit project</p>
        </div>
        <div class="flex flex-wrap gap-2 items-center">
            <span class="badge badge-success gap-1">✓ @Model.ApprovedCount goedgekeurd</span>
            <span class="badge badge-warning gap-1">⏳ @Model.PendingCount nieuw</span>
            <span class="badge badge-error gap-1">⚑ @Model.FlaggedCount gemarkeerd</span>

            <div class="dropdown dropdown-end" data-export-emails data-project-id="@Model.ProjectId">
                <button type="button" class="btn btn-primary btn-sm gap-1.5" data-export-trigger>
                    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                        <path d="M12 3v12m0 0l-4-4m4 4l4-4M4 17v2a2 2 0 002 2h12a2 2 0 002-2v-2"/>
                    </svg>
                    E-mails exporteren
                </button>
                <ul tabindex="0" class="dropdown-content menu bg-base-100 rounded-box z-10 w-44 p-2 shadow hidden" data-export-fallback>
                    <li><a href="@Url.Action("ExportParticipantEmails", new { projectId = Model.ProjectId, format = "csv" })">CSV (.csv)</a></li>
                    <li><a href="@Url.Action("ExportParticipantEmails", new { projectId = Model.ProjectId, format = "txt" })">Tekst (.txt)</a></li>
                    <li><a href="@Url.Action("ExportParticipantEmails", new { projectId = Model.ProjectId, format = "xlsx" })">Excel (.xlsx)</a></li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Filter bar -->
    <form method="get" asp-action="Ideas" asp-route-projectId="@Model.ProjectId"
          class="flex flex-wrap gap-2 mb-5 items-center"
          data-ideas-filter>
        <label class="input input-bordered input-sm flex items-center gap-2 flex-1 min-w-48">
            <svg class="text-base-content/40" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
            <input type="search" name="search" value="@Model.Search"
                   placeholder="Zoek op beschrijving…" class="grow" />
        </label>

        <select name="categoryId" class="select select-bordered select-sm min-w-40"
                onchange="this.form.submit()">
            <option value="">Alle categorieën</option>
            @foreach (var cat in Model.Categories)
            {
                if (Model.CategoryId == cat.CategoryId)
                {
                    <option value="@cat.CategoryId" selected>@cat.Name</option>
                }
                else
                {
                    <option value="@cat.CategoryId">@cat.Name</option>
                }
            }
        </select>

        <select name="status" class="select select-bordered select-sm min-w-36"
                onchange="this.form.submit()">
            <option value="">Alle statussen</option>
            @if (Model.Status == "Unflagged") { <option value="Unflagged" selected>Nieuw</option> }
            else { <option value="Unflagged">Nieuw</option> }
            @if (Model.Status == "Approved") { <option value="Approved" selected>Goedgekeurd</option> }
            else { <option value="Approved">Goedgekeurd</option> }
            @if (Model.Status == "Flagged") { <option value="Flagged" selected>Gemarkeerd</option> }
            else { <option value="Flagged">Gemarkeerd</option> }
            @if (Model.Status == "Declined") { <option value="Declined" selected>Afgewezen</option> }
            else { <option value="Declined">Afgewezen</option> }
        </select>

        <button type="submit" class="btn btn-primary btn-sm">Zoeken</button>
        @if (!string.IsNullOrEmpty(Model.Search) || Model.CategoryId.HasValue || !string.IsNullOrEmpty(Model.Status))
        {
            <a asp-action="Ideas" asp-route-projectId="@Model.ProjectId"
               class="btn btn-ghost btn-sm" data-clear-filter>Wissen</a>
        }
    </form>

    <!-- Ideas table + pagination -->
    <div id="ideas-results">
        @await Html.PartialAsync("_IdeasTable", Model)
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const root = document.querySelector('[data-export-emails]');
            if (!root) return;
            const projectId = root.dataset.projectId;
            const trigger = root.querySelector('[data-export-trigger]');
            const fallback = root.querySelector('[data-export-fallback]');
            const baseUrl = '@Url.Action("ExportParticipantEmails", new { projectId = "__PID__" })'.replace('__PID__', projectId);
            const types = [
                { description: 'CSV', accept: { 'text/csv': ['.csv'] } },
                { description: 'Tekstbestand', accept: { 'text/plain': ['.txt'] } },
                { description: 'Excel', accept: { 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet': ['.xlsx'] } }
            ];
            const extToFormat = { '.csv': 'csv', '.txt': 'txt', '.xlsx': 'xlsx' };

            if (typeof window.showSaveFilePicker !== 'function') {
                trigger.addEventListener('click', () => fallback.classList.toggle('hidden'));
                return;
            }

            trigger.addEventListener('click', async () => {
                let handle;
                try {
                    handle = await window.showSaveFilePicker({
                        suggestedName: `participants-${projectId}`,
                        types
                    });
                } catch (e) {
                    if (e?.name === 'AbortError') return;
                    console.error(e);
                    return;
                }
                const name = handle.name.toLowerCase();
                const ext = Object.keys(extToFormat).find(x => name.endsWith(x)) || '.csv';
                const format = extToFormat[ext];

                const resp = await fetch(`${baseUrl}&format=${format}`);
                if (!resp.ok) {
                    alert('Export mislukt.');
                    return;
                }

                const writable = await handle.createWritable();
                await resp.body.pipeTo(writable);
            });
        })();
    </script>
}
