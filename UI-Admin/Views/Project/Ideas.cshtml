@model SynapseEnqueteManagement.UI.Admin.Models.Project.IdeasViewModel
@inject IViewLocalizer L
@{
    ViewData["Title"] = L["PageTitle"].Value;
    Layout = "_Layout";
}

<div class="w-full">

    <!-- Header + summary badges -->
    <div class="flex flex-wrap items-start justify-between gap-3 mb-5">
        <div>
            <h1 class="font-heading font-bold text-2xl text-base-content">@L["Heading"]</h1>
            <p class="text-sm text-base-content/50 mt-0.5">@string.Format(L["TotalCountText"].Value, Model.TotalCount)</p>
        </div>
        <div class="flex flex-wrap gap-2 items-center">
            <span class="badge badge-success gap-1">✓ @string.Format(L["BadgeApproved"].Value, Model.ApprovedCount)</span>
            <span class="badge badge-warning gap-1">⏳ @string.Format(L["BadgeNew"].Value, Model.PendingCount)</span>
            <span class="badge badge-error gap-1">⚑ @string.Format(L["BadgeFlagged"].Value, Model.FlaggedCount)</span>

            <div class="dropdown dropdown-end" data-export-emails
                 data-project-id="@Model.ProjectId"
                 data-export-url="@Url.Action("ExportParticipantEmails", new { projectId = Model.ProjectId })"
                 data-failed-message="@L["ExportFailedAlert"].Value"
                 data-text-format-description="@L["ExportFormat_TextDescription"].Value">
                <button type="button" class="btn btn-primary btn-sm gap-1.5" data-export-trigger>
                    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                        <path d="M12 3v12m0 0l-4-4m4 4l4-4M4 17v2a2 2 0 002 2h12a2 2 0 002-2v-2"/>
                    </svg>
                    @L["ExportEmailsButton"]
                </button>
                <ul tabindex="0" class="dropdown-content menu bg-base-100 rounded-box z-10 w-44 p-2 shadow hidden" data-export-fallback>
                    <li><a href="@Url.Action("ExportParticipantEmails", new { projectId = Model.ProjectId, format = "csv" })">CSV (.csv)</a></li>
                    <li><a href="@Url.Action("ExportParticipantEmails", new { projectId = Model.ProjectId, format = "txt" })">@L["ExportFormat_Text"]</a></li>
                    <li><a href="@Url.Action("ExportParticipantEmails", new { projectId = Model.ProjectId, format = "xlsx" })">Excel (.xlsx)</a></li>
                </ul>
            </div>

            <button id="summary-trigger-btn" data-open-modal="summary-modal" type="button" class="btn btn-secondary btn-sm gap-1.5">
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path d="M9 12h6m-3-3v6M5 3h14a2 2 0 012 2v14a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2z"/>
                </svg>
                @L["AiSummaryButton"]
            </button>
        </div>
    </div>

    <!-- Filter bar -->
    <form method="get" asp-action="Ideas" asp-route-projectId="@Model.ProjectId"
          class="flex flex-wrap gap-2 mb-5 items-center"
          data-ideas-filter>
        <label class="input input-bordered input-sm flex items-center gap-2 flex-1 min-w-48">
            <svg class="text-base-content/40" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
            <input type="search" name="search" value="@Model.Search"
                   placeholder="@L["SearchPlaceholder"]" class="grow" />
        </label>

        <select name="categoryId" class="select select-bordered select-sm min-w-40"
                data-submit-on-change>
            <option value="">@L["AllCategories"]</option>
            @foreach (var cat in Model.Categories)
            {
                if (Model.CategoryId == cat.CategoryId)
                {
                    <option value="@cat.CategoryId" selected>@cat.Name</option>
                }
                else
                {
                    <option value="@cat.CategoryId">@cat.Name</option>
                }
            }
        </select>

        <select name="status" class="select select-bordered select-sm min-w-36"
                data-submit-on-change>
            <option value="">@L["AllStatuses"]</option>
            @if (Model.Status == "Unflagged") { <option value="Unflagged" selected>@L["Status_New"]</option> }
            else { <option value="Unflagged">@L["Status_New"]</option> }
            @if (Model.Status == "Approved") { <option value="Approved" selected>@L["Status_Approved"]</option> }
            else { <option value="Approved">@L["Status_Approved"]</option> }
            @if (Model.Status == "Flagged") { <option value="Flagged" selected>@L["Status_Flagged"]</option> }
            else { <option value="Flagged">@L["Status_Flagged"]</option> }
            @if (Model.Status == "Declined") { <option value="Declined" selected>@L["Status_Declined"]</option> }
            else { <option value="Declined">@L["Status_Declined"]</option> }
        </select>

        <button type="submit" class="btn btn-primary btn-sm">@L["SearchButton"]</button>
        @if (!string.IsNullOrEmpty(Model.Search) || Model.CategoryId.HasValue || !string.IsNullOrEmpty(Model.Status))
        {
            <a asp-action="Ideas" asp-route-projectId="@Model.ProjectId"
               class="btn btn-ghost btn-sm" data-clear-filter>@L["ClearButton"]</a>
        }
    </form>

    <!-- Ideas table + pagination -->
    <div id="ideas-results">
        @await Html.PartialAsync("_IdeasTable", Model)
    </div>
</div>

@await Html.PartialAsync("_IdeaSummaryPanel", Model)
