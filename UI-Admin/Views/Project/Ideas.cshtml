@model SynapseEnqueteManagement.UI.Admin.Models.Project.IdeasViewModel
@inject IViewLocalizer L
@{
    ViewData["Title"] = L["PageTitle"].Value;
    Layout = "_Layout";
}

<div class="w-full">

    <!-- Breadcrumb back link -->
    <div class="mb-4">
        <a asp-action="IdeasCategories" asp-route-projectId="@Model.ProjectId"
           class="inline-flex items-center gap-1.5 text-sm text-base-content/50 hover:text-base-content transition-colors">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
            </svg>
            @L["BackToCategories"]
        </a>
    </div>

    <!-- Header + summary badges -->
    <div class="flex flex-wrap items-start justify-between gap-3 mb-5">
        <div>
            <h1 class="font-heading font-bold text-2xl text-base-content">@Model.CategoryName</h1>
            <p class="text-sm text-base-content/50 mt-0.5">@string.Format(L["TotalCountText"].Value, Model.TotalCount)</p>
        </div>
        <div class="flex flex-wrap gap-2 items-center" data-status-badges>
            <button type="button"
                    class="badge badge-success gap-1 ideas-filter-badge cursor-pointer"
                    data-status-filter="Approved"
                    data-active="@(Model.Status == "Approved" ? "true" : "false")">
                ✓ @string.Format(L["BadgeApproved"].Value, Model.ApprovedCount)
            </button>
            <button type="button"
                    class="badge badge-info gap-1 ideas-filter-badge cursor-pointer"
                    data-status-filter="Unflagged"
                    data-active="@(Model.Status == "Unflagged" ? "true" : "false")">
                ● @string.Format(L["BadgeNew"].Value, Model.PendingCount)
            </button>
            <button type="button"
                    class="badge badge-warning gap-1 ideas-filter-badge cursor-pointer"
                    data-status-filter="Flagged"
                    data-active="@(Model.Status == "Flagged" ? "true" : "false")">
                ⚑ @string.Format(L["BadgeFlagged"].Value, Model.FlaggedCount)
            </button>
            <button type="button"
                    class="badge badge-error gap-1 ideas-filter-badge cursor-pointer"
                    data-status-filter="Declined"
                    data-active="@(Model.Status == "Declined" ? "true" : "false")">
                ✕ @string.Format(L["BadgeDeclined"].Value, Model.DeclinedCount)
            </button>
        </div>
    </div>

    <!-- Filter bar -->
    <form method="get" asp-action="Ideas"
          class="flex flex-wrap gap-2 mb-6 items-center"
          data-ideas-filter>
        <input type="hidden" name="projectId" value="@Model.ProjectId" />
        <input type="hidden" name="categoryId" value="@Model.CategoryId" />

        <label class="input input-bordered input-sm flex items-center gap-2 flex-1 min-w-48">
            <svg class="text-base-content/40" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/>
            </svg>
            <input type="search" name="search" value="@Model.Search"
                   placeholder="@L["SearchPlaceholder"]" class="grow" />
        </label>

        <select name="status" class="select select-bordered select-sm min-w-36">
            <option value="">@L["AllStatuses"]</option>
            @if (Model.Status == "Unflagged") { <option value="Unflagged" selected>@L["Status_New"]</option> }
            else { <option value="Unflagged">@L["Status_New"]</option> }
            @if (Model.Status == "Approved") { <option value="Approved" selected>@L["Status_Approved"]</option> }
            else { <option value="Approved">@L["Status_Approved"]</option> }
            @if (Model.Status == "Flagged") { <option value="Flagged" selected>@L["Status_Flagged"]</option> }
            else { <option value="Flagged">@L["Status_Flagged"]</option> }
            @if (Model.Status == "Declined") { <option value="Declined" selected>@L["Status_Declined"]</option> }
            else { <option value="Declined">@L["Status_Declined"]</option> }
        </select>

        <button type="submit" class="btn btn-primary btn-sm">@L["SearchButton"]</button>
        @if (!string.IsNullOrEmpty(Model.Search) || !string.IsNullOrEmpty(Model.Status))
        {
            <a asp-action="Ideas" asp-route-projectId="@Model.ProjectId" asp-route-categoryId="@Model.CategoryId"
               class="btn btn-ghost btn-sm" data-clear-filter>@L["ClearButton"]</a>
        }
    </form>

    <!-- Ideas cards + pagination -->
    <div id="ideas-results">
        @await Html.PartialAsync("_IdeasTable", Model)
    </div>
</div>
