@model SynapseEnqueteManagement.UI.Admin.Models.Project.IdeasViewModel
@inject IViewLocalizer L

<dialog id="summary-modal" class="modal">
    <div class="modal-box w-[480px] max-w-[92vw] max-h-[90vh] rounded-2xl overflow-y-auto p-7 flex flex-col gap-4">

        <div class="flex items-center justify-between">
            <div class="flex items-center gap-3 min-w-0">
                <div class="w-10 h-10 rounded-xl bg-secondary/15 text-secondary flex items-center justify-center flex-shrink-0">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-3-3v6M5 3h14a2 2 0 012 2v14a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2z"/>
                    </svg>
                </div>
                <div class="min-w-0">
                    <div class="text-[11px] uppercase font-bold tracking-wide text-base-content/50">AI</div>
                    <div class="font-heading font-bold text-base text-base-content truncate">@L["PanelTitle"]</div>
                </div>
            </div>
            <form method="dialog">
                <button type="submit" class="btn btn-ghost btn-sm btn-circle">×</button>
            </form>
        </div>

        <form id="summary-form" class="flex flex-col gap-3">
            <label class="form-control">
                <div class="label"><span class="label-text text-xs">@L["CategoryLabel"]</span></div>
                <select name="CategoryId" class="select select-bordered select-sm">
                    <option value="">@L["AllCategories"]</option>
                    @foreach (var cat in Model.Categories)
                    {
                        <option value="@cat.CategoryId">@cat.Name</option>
                    }
                </select>
            </label>

            <label class="form-control">
                <div class="label"><span class="label-text text-xs">@L["StatusLabel"]</span></div>
                <select name="Status" class="select select-bordered select-sm">
                    <option value="">@L["AllStatuses"]</option>
                    <option value="Approved">@L["Status_Approved"]</option>
                    <option value="Unflagged">@L["Status_New"]</option>
                    <option value="Flagged">@L["Status_Flagged"]</option>
                </select>
            </label>

            <label class="form-control">
                <div class="label"><span class="label-text text-xs">@L["SamplingStrategyLabel"]</span></div>
                <select name="SamplingStrategy" class="select select-bordered select-sm">
                    <option value="Newest">@L["Strategy_Newest"]</option>
                    <option value="MostCommented">@L["Strategy_MostCommented"]</option>
                    <option value="Diverse">@L["Strategy_Diverse"]</option>
                </select>
            </label>

            <fieldset class="flex flex-col gap-1.5">
                <legend class="label-text text-xs mb-1">@L["IdeaSelectionLabel"]</legend>
                <label class="flex items-center gap-2.5 cursor-pointer">
                    <input type="radio" name="SelectAll" value="false" class="radio radio-sm" checked />
                    <span class="text-sm">@string.Format(L["SelectFirst"].Value, Model.IdeaSummaryMaxIdeas)</span>
                </label>
                <label class="flex items-center gap-2.5 cursor-pointer">
                    <input type="radio" name="SelectAll" value="true" class="radio radio-sm" />
                    <span class="text-sm">@L["SelectAll"]</span>
                </label>
            </fieldset>

            <fieldset class="flex flex-col gap-1.5">
                <legend class="label-text text-xs mb-1">@L["ExportFormatLabel"]</legend>
                <label class="flex items-center gap-2.5 cursor-pointer">
                    <input type="radio" name="Format" value="Pdf" class="radio radio-sm" checked />
                    <span class="text-sm">@L["Format_Pdf"]</span>
                </label>
                <label class="flex items-center gap-2.5 cursor-pointer">
                    <input type="radio" name="Format" value="Txt" class="radio radio-sm" />
                    <span class="text-sm">@L["Format_Txt"]</span>
                </label>
                <label class="flex items-center gap-2.5 cursor-pointer">
                    <input type="radio" name="Format" value="Png" class="radio radio-sm" />
                    <span class="text-sm">@L["Format_Png"]</span>
                </label>
            </fieldset>
        </form>

        <div id="summary-status" class="hidden flex flex-col gap-2 px-4 py-3 bg-base-200/60 rounded-xl text-sm">
            <div id="summary-status-text" class="text-base-content/70">@L["StatusQueued"]</div>
            <a id="summary-download-link" href="#" class="btn btn-success btn-sm hidden">
                @L["DownloadButton"]
            </a>
            <div id="summary-error" class="text-error hidden"></div>
        </div>

        <div class="flex justify-end gap-2 pt-3 border-t border-base-200">
            <button id="summary-retry" type="button" class="btn btn-ghost btn-sm hidden">@L["RetryButton"]</button>
            <button type="button" id="summary-submit" class="btn btn-primary btn-sm gap-1">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-3-3v6M5 3h14a2 2 0 012 2v14a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2z"/>
                </svg>
                @L["GenerateButton"]
            </button>
        </div>
    </div>
    <form method="dialog" class="modal-backdrop"><button>close</button></form>
</dialog>

@Html.AntiForgeryToken()

<script>
(function () {
    const modal     = document.getElementById('summary-modal');
    const form      = document.getElementById('summary-form');
    const statusDiv = document.getElementById('summary-status');
    const statusTxt = document.getElementById('summary-status-text');
    const dlLink    = document.getElementById('summary-download-link');
    const errDiv    = document.getElementById('summary-error');
    const submitBtn = document.getElementById('summary-submit');
    const retryBtn  = document.getElementById('summary-retry');
    const projectId = @Model.ProjectId;
    const token     = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
    const msg = {
        queued:       '@Html.Raw(L["StatusQueued"].Value)',
        processing:   '@Html.Raw(L["StatusProcessing"].Value)',
        ready:        '@Html.Raw(L["StatusReady"].Value)',
        failed:       '@Html.Raw(L["StatusFailed"].Value)',
        startError:   '@Html.Raw(L["StatusStartError"].Value)',
        unknownError: '@Html.Raw(L["StatusUnknownError"].Value)',
    };
    let pollTimer = null;

    function resetForm() {
        clearPoll();
        statusDiv.classList.add('hidden');
        dlLink.classList.add('hidden');
        errDiv.classList.add('hidden');
        retryBtn.classList.add('hidden');
        submitBtn.classList.remove('hidden');
        submitBtn.disabled = false;
    }

    function clearPoll() {
        if (pollTimer) { clearInterval(pollTimer); pollTimer = null; }
    }

    modal?.addEventListener('close', () => {
        if (!pollTimer) resetForm();
    });
    retryBtn.addEventListener('click', resetForm);

    submitBtn.addEventListener('click', async () => {
        const raw = Object.fromEntries(new FormData(form));
        const payload = {
            Format:           raw.Format,
            SamplingStrategy: raw.SamplingStrategy,
            CategoryId:       raw.CategoryId ? parseInt(raw.CategoryId) : null,
            Status:           raw.Status || null,
            LanguageCode:     null,
            OutputLanguage:   '@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName',
            SelectAll:        raw.SelectAll === 'true',
        };

        submitBtn.disabled = true;
        statusDiv.classList.remove('hidden');
        statusTxt.textContent = msg.queued;
        dlLink.classList.add('hidden');
        errDiv.classList.add('hidden');
        retryBtn.classList.add('hidden');

        const resp = await fetch(`/Project/GenerateSummary?projectId=${projectId}`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token,
            },
            body: JSON.stringify(payload),
        });

        if (!resp.ok) {
            statusTxt.textContent = msg.startError;
            submitBtn.disabled = false;
            return;
        }

        const { jobId } = await resp.json();
        submitBtn.classList.add('hidden');
        pollTimer = setInterval(() => pollStatus(jobId), 3000);
    });

    async function pollStatus(jobId) {
        const resp = await fetch(`/Project/SummaryStatus?projectId=${projectId}&jobId=${jobId}`);
        if (!resp.ok) return;
        const data = await resp.json();

        if (data.status === 'Completed') {
            clearPoll();
            const downloadUrl = `/Project/DownloadSummary?projectId=${projectId}&jobId=${jobId}`;
            if (modal.open) {
                statusTxt.textContent = msg.ready;
                dlLink.href = downloadUrl;
                dlLink.classList.remove('hidden');
                retryBtn.classList.remove('hidden');
            } else {
                const a = document.createElement('a');
                a.href = downloadUrl;
                a.download = '';
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                resetForm();
            }
        } else if (data.status === 'Failed') {
            clearPoll();
            if (modal.open) {
                statusTxt.textContent = msg.failed;
                errDiv.textContent = data.errorMessage ?? msg.unknownError;
                errDiv.classList.remove('hidden');
                retryBtn.classList.remove('hidden');
            } else {
                resetForm();
            }
        } else {
            statusTxt.textContent = msg.processing;
        }
    }
})();
</script>