@model SynapseEnqueteManagement.UI.Admin.Models.Project.IdeasViewModel
@inject IViewLocalizer L

<div id="summary-panel" class="fixed inset-0 z-50 hidden" aria-modal="true">
    <div class="absolute inset-0 bg-black/40" id="summary-overlay"></div>
    <div class="absolute right-0 top-0 h-full w-full max-w-md bg-base-100 shadow-2xl flex flex-col">
        <div class="flex items-center justify-between p-4 border-b">
            <h2 class="font-semibold text-base-content">@L["PanelTitle"]</h2>
            <button id="summary-close" class="btn btn-ghost btn-sm btn-square">✕</button>
        </div>

        <form id="summary-form" class="flex flex-col gap-4 p-4 flex-1 overflow-y-auto">
            <label class="form-control">
                <div class="label"><span class="label-text font-medium">@L["CategoryLabel"]</span></div>
                <select name="CategoryId" class="select select-bordered select-sm">
                    <option value="">@L["AllCategories"]</option>
                    @foreach (var cat in Model.Categories)
                    {
                        <option value="@cat.CategoryId">@cat.Name</option>
                    }
                </select>
            </label>

            <label class="form-control">
                <div class="label"><span class="label-text font-medium">@L["StatusLabel"]</span></div>
                <select name="Status" class="select select-bordered select-sm">
                    <option value="">@L["AllStatuses"]</option>
                    <option value="Approved">@L["Status_Approved"]</option>
                    <option value="Unflagged">@L["Status_New"]</option>
                    <option value="Flagged">@L["Status_Flagged"]</option>
                </select>
            </label>

            <label class="form-control">
                <div class="label"><span class="label-text font-medium">@L["SamplingStrategyLabel"]</span></div>
                <select name="SamplingStrategy" class="select select-bordered select-sm">
                    <option value="Newest">@L["Strategy_Newest"]</option>
                    <option value="MostCommented">@L["Strategy_MostCommented"]</option>
                    <option value="Diverse">@L["Strategy_Diverse"]</option>
                </select>
            </label>

            <fieldset class="flex flex-col gap-1">
                <legend class="label-text font-medium mb-1">@L["IdeaSelectionLabel"]</legend>
                <label class="flex items-center gap-2 cursor-pointer">
                    <input type="radio" name="SelectAll" value="false" class="radio radio-sm" checked />
                    <span class="text-sm">@L["SelectFirst"]</span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer">
                    <input type="radio" name="SelectAll" value="true" class="radio radio-sm" />
                    <span class="text-sm">@L["SelectAll"]</span>
                </label>
            </fieldset>

            <fieldset class="flex flex-col gap-1">
                <legend class="label-text font-medium mb-1">@L["ExportFormatLabel"]</legend>
                <label class="flex items-center gap-2 cursor-pointer">
                    <input type="radio" name="Format" value="Pdf" class="radio radio-sm" checked />
                    <span class="text-sm">@L["Format_Pdf"]</span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer">
                    <input type="radio" name="Format" value="Txt" class="radio radio-sm" />
                    <span class="text-sm">@L["Format_Txt"]</span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer">
                    <input type="radio" name="Format" value="Png" class="radio radio-sm" />
                    <span class="text-sm">@L["Format_Png"]</span>
                </label>
            </fieldset>

            <button type="submit" id="summary-submit" class="btn btn-primary btn-sm mt-2">
                @L["GenerateButton"]
            </button>
        </form>

        <div id="summary-status" class="hidden p-4 border-t flex flex-col gap-2">
            <div id="summary-status-text" class="text-sm text-base-content/70">@L["StatusQueued"]</div>
            <a id="summary-download-link" href="#" class="btn btn-success btn-sm hidden">
                @L["DownloadButton"]
            </a>
            <div id="summary-error" class="text-sm text-error hidden"></div>
            <button id="summary-retry" class="btn btn-ghost btn-sm hidden">@L["RetryButton"]</button>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

<script>
(function () {
    const panel      = document.getElementById('summary-panel');
    const overlay    = document.getElementById('summary-overlay');
    const closeBtn   = document.getElementById('summary-close');
    const form       = document.getElementById('summary-form');
    const statusDiv  = document.getElementById('summary-status');
    const statusText = document.getElementById('summary-status-text');
    const dlLink     = document.getElementById('summary-download-link');
    const errDiv     = document.getElementById('summary-error');
    const retryBtn   = document.getElementById('summary-retry');
    const submitBtn  = document.getElementById('summary-submit');
    const projectId  = @Model.ProjectId;
    const token      = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
    const msg = {
        queued:      '@Html.Raw(L["StatusQueued"].Value)',
        processing:  '@Html.Raw(L["StatusProcessing"].Value)',
        ready:       '@Html.Raw(L["StatusReady"].Value)',
        failed:      '@Html.Raw(L["StatusFailed"].Value)',
        startError:  '@Html.Raw(L["StatusStartError"].Value)',
        unknownError:'@Html.Raw(L["StatusUnknownError"].Value)',
    };
    let pollTimer    = null;

    document.getElementById('open-summary-panel')?.addEventListener('click', () => {
        panel.classList.remove('hidden');
    });
    overlay.addEventListener('click', closePanel);
    closeBtn.addEventListener('click', closePanel);
    retryBtn.addEventListener('click', () => {
        statusDiv.classList.add('hidden');
        submitBtn.disabled = false;
    });

    function closePanel() {
        panel.classList.add('hidden');
        clearPoll();
    }

    function clearPoll() {
        if (pollTimer) { clearInterval(pollTimer); pollTimer = null; }
    }

    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const raw = Object.fromEntries(new FormData(form));
        const payload = {
            Format:           raw.Format,
            SamplingStrategy: raw.SamplingStrategy,
            CategoryId:       raw.CategoryId ? parseInt(raw.CategoryId) : null,
            Status:           raw.Status || null,
            LanguageCode:     null,
            SelectAll:        raw.SelectAll === 'true',
        };

        submitBtn.disabled = true;
        statusDiv.classList.remove('hidden');
        statusText.textContent = msg.queued;
        dlLink.classList.add('hidden');
        errDiv.classList.add('hidden');
        retryBtn.classList.add('hidden');

        const resp = await fetch(`/Project/GenerateSummary?projectId=${projectId}`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token,
            },
            body: JSON.stringify(payload),
        });

        if (!resp.ok) {
            statusText.textContent = msg.startError;
            submitBtn.disabled = false;
            return;
        }

        const { jobId } = await resp.json();
        pollTimer = setInterval(() => pollStatus(jobId), 3000);
    });

    async function pollStatus(jobId) {
        const resp = await fetch(`/Project/SummaryStatus?projectId=${projectId}&jobId=${jobId}`);
        if (!resp.ok) return;
        const data = await resp.json();

        if (data.status === 'Completed') {
            clearPoll();
            statusText.textContent = msg.ready;
            dlLink.href = `/Project/DownloadSummary?projectId=${projectId}&jobId=${jobId}`;
            dlLink.classList.remove('hidden');
            submitBtn.disabled = false;
        } else if (data.status === 'Failed') {
            clearPoll();
            statusText.textContent = msg.failed;
            errDiv.textContent = data.errorMessage ?? msg.unknownError;
            errDiv.classList.remove('hidden');
            retryBtn.classList.remove('hidden');
            submitBtn.disabled = false;
        } else {
            statusText.textContent = msg.processing;
        }
    }
})();
</script>