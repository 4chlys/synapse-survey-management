@using SynapseEnqueteManagement.UI.Admin.Models.Category
@model List<CategoryViewModel>
@{
    ViewData["Title"] = "Categorieën";
    Layout = "_Layout";
    int projectId = (int)ViewData["ProjectId"];
    var projectState = ViewData["ProjectState"]?.ToString() ?? "";
    var isLocked = projectState is "Active" or "Archived";
    bool isNew = ViewData["IsNew"] is true;
}
<div class="max-w-2xl">
    <h1 class="font-heading font-bold text-2xl text-base-content mb-6">Categorieën</h1>

    @if (isLocked)
    {
        <div class="alert alert-warning mb-4">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" class="flex-shrink-0"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            <span>Dit project is @(projectState == "Active" ? "actief" : "gearchiveerd"). Categorieën kunnen niet meer worden gewijzigd.</span>
        </div>
    }

    <div class="card bg-base-100 shadow-sm mb-6">
        <div class="card-body p-0 overflow-x-auto">
            <table class="table table-sm">
                <thead><tr><th>Naam</th><th>Beschrijving</th>@if (!isLocked){<th class="w-12"></th>}</tr></thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="@(isLocked ? 2 : 3)" class="text-center text-base-content/40 py-6 italic">Nog geen categorieën.</td></tr>
                    }
                    @foreach (var cat in Model)
                    {
                        <tr class="hover">
                            <td class="font-medium">@cat.Name</td>
                            <td class="text-base-content/60">@cat.Description</td>
                            @if (!isLocked)
                            {
                                <td>
                                    <form asp-action="DeleteCategory" method="post">
                                        <input type="hidden" name="projectId" value="@projectId" />
                                        <input type="hidden" name="categoryId" value="@cat.CategoryId" />
                                        <input type="hidden" name="isNew" value="@isNew.ToString().ToLower()" />
                                        <button type="submit" class="btn btn-ghost btn-xs text-error">×</button>
                                    </form>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (!isLocked)
    {
        <div class="card bg-base-100 shadow-sm">
            <div class="card-body gap-4">
                <h2 class="font-semibold text-base-content">Categorie toevoegen</h2>
                <form asp-action="AddCategory" method="post" class="flex gap-2 items-end">
                    <input type="hidden" name="projectId" value="@projectId" />
                    <input type="hidden" name="isNew" value="@isNew.ToString().ToLower()" />
                    <label class="form-control flex-1">
                        <div class="label"><span class="label-text text-xs">Naam *</span></div>
                        <input type="text" name="Name" class="input input-bordered input-sm w-full" placeholder="Categorienaam" required />
                    </label>
                    <label class="form-control flex-[2]">
                        <div class="label"><span class="label-text text-xs">Beschrijving</span></div>
                        <input type="text" name="Description" class="input input-bordered input-sm w-full" placeholder="Optioneel" />
                    </label>
                    <button type="submit" class="btn btn-primary btn-sm">Toevoegen</button>
                </form>
            </div>
        </div>
    }

    <div class="flex justify-between mt-6">
        <a asp-action="Questions" asp-route-projectId="@projectId" asp-route-isNew="@isNew" class="btn btn-ghost btn-sm">← Vragen</a>
        <a asp-action="@(isLocked ? "Dashboard" : "Activate")" asp-route-projectId="@projectId" class="btn btn-primary btn-sm">@(isLocked ? "Dashboard →" : "Volgende →")</a>
    </div>
</div>
