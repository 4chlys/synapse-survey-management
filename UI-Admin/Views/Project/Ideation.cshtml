@using SynapseEnqueteManagement.UI.Admin.Models.Category
@model List<CategoryViewModel>
@{
    ViewData["Title"] = "Categorieën";
    Layout = "_Layout";
    int projectId = (int)ViewData["ProjectId"];
}
<div class="max-w-2xl">
    <h1 class="font-heading font-bold text-2xl text-base-content mb-6">Categorieën</h1>
    <div class="card bg-base-100 shadow-sm mb-6">
        <div class="card-body p-0 overflow-x-auto">
            <table class="table table-sm">
                <thead><tr><th>Naam</th><th>Beschrijving</th><th class="w-12"></th></tr></thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="3" class="text-center text-base-content/40 py-6 italic">Nog geen categorieën.</td></tr>
                    }
                    @foreach (var cat in Model)
                    {
                        <tr class="hover">
                            <td class="font-medium">@cat.Name</td>
                            <td class="text-base-content/60">@cat.Description</td>
                            <td>
                                <form asp-action="DeleteCategory" method="post">
                                    <input type="hidden" name="projectId" value="@projectId" />
                                    <input type="hidden" name="categoryId" value="@cat.CategoryId" />
                                    <button type="submit" class="btn btn-ghost btn-xs text-error">×</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="card bg-base-100 shadow-sm">
        <div class="card-body gap-4">
            <h2 class="font-semibold text-base-content">Categorie toevoegen</h2>
            <form asp-action="AddCategory" method="post" class="flex gap-2 items-end">
                <input type="hidden" name="projectId" value="@projectId" />
                <label class="form-control flex-1">
                    <div class="label"><span class="label-text text-xs">Naam *</span></div>
                    <input type="text" name="Name" class="input input-bordered input-sm w-full" placeholder="Categorienaam" required />
                </label>
                <label class="form-control flex-[2]">
                    <div class="label"><span class="label-text text-xs">Beschrijving</span></div>
                    <input type="text" name="Description" class="input input-bordered input-sm w-full" placeholder="Optioneel" />
                </label>
                <button type="submit" class="btn btn-primary btn-sm">Toevoegen</button>
            </form>
        </div>
    </div>
    <div class="flex justify-between mt-6">
        <a asp-action="Questions" asp-route-projectId="@projectId" class="btn btn-ghost btn-sm">← Vragen</a>
        <a asp-action="Activate" asp-route-projectId="@projectId" class="btn btn-primary btn-sm">Volgende →</a>
    </div>
</div>
