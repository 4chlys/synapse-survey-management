@using SynapseEnqueteManagement.UI.Admin.Models.Category
@using SynapseEnqueteManagement.UI.Admin.Models.Project
@model List<CategoryViewModel>
@inject IViewLocalizer L
@inject IHtmlLocalizer<SharedResource> Shared
@{
    ViewData["Title"] = L["PageTitle"].Value;
    Layout = "_Layout";
    int projectId = (int)ViewData["ProjectId"];
    var projectState = ViewData["ProjectState"]?.ToString() ?? "";
    var isLocked = projectState is "Active" or "Archived";
    bool isNew = ViewData["IsNew"] is true;
    var project = ViewData["Project"] as ProjectAdminViewModel;
    var availableLangs = (ViewData["AvailableLanguageCodes"] as string[]) ?? new[] { "nl" };
    if (isNew) ViewData["WizardStep"] = 3;
}
<div class="w-full flex flex-col gap-4">
<div class="flex flex-col gap-4">
    <div class="mb-2">
        <h1 class="font-heading font-bold text-2xl text-base-content">@L["Heading"]</h1>
        <p class="text-base-content/50 text-sm mt-1">@L["Subtitle"]</p>
    </div>

    @if (isLocked)
    {
        <div class="alert alert-warning mb-4">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" class="flex-shrink-0"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            <span>@(projectState == "Active" ? L["LockedActive"] : L["LockedArchived"])</span>
        </div>
    }

    <div class="card bg-base-100 shadow-sm">
        <div class="card-body gap-5">
            <h2 class="font-heading font-semibold text-base text-base-content uppercase tracking-wide opacity-60 pb-1 border-b border-base-200">@L["CategoriesHeading"]</h2>

            @if (Model.Any())
            {
                <div class="grid grid-cols-2 md:grid-cols-3 gap-2.5">
                    @foreach (var cat in Model)
                    {
                        <div class="group relative flex flex-col items-start gap-1.5 p-4 rounded-xl border-[1.5px] border-base-300 bg-base-200/40">
                            <div class="w-9 h-9 rounded-lg bg-primary/15 text-primary flex items-center justify-center">
                                <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7 7h.01M7 3h5a1.99 1.99 0 011.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.99 1.99 0 013 12V7a4 4 0 014-4z"/></svg>
                            </div>
                            @foreach (var langCode in availableLangs)
                            {
                                var t = cat.Translations.FirstOrDefault(tr => tr.LanguageCode == langCode);
                                <div class="flex items-start gap-1.5">
                                    <span class="text-xs font-bold uppercase text-base-content/30 w-6 shrink-0 mt-0.5">@langCode</span>
                                    <div>
                                        <div class="text-sm font-bold text-base-content">@(t?.Name ?? "")</div>
                                        @if (!string.IsNullOrWhiteSpace(t?.Description))
                                        {
                                            <div class="text-xs text-base-content/50 leading-snug">@t.Description</div>
                                        }
                                    </div>
                                </div>
                            }
                            @if (!isLocked)
                            {
                                <form asp-action="DeleteCategory" method="post" class="absolute top-2 right-2 opacity-0 group-hover:opacity-100 transition-opacity">
                                    <input type="hidden" name="projectId" value="@projectId" />
                                    <input type="hidden" name="categoryId" value="@cat.CategoryId" />
                                    <input type="hidden" name="isNew" value="@isNew.ToString().ToLower()" />
                                    <button type="submit" class="btn btn-ghost btn-xs btn-circle text-error">
                                        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                                    </button>
                                </form>
                            }
                        </div>
                    }
                </div>
            }
            else if (isLocked)
            {
                <p class="text-base-content/40 italic text-sm text-center py-4">@L["NoCategories"]</p>
            }

            @if (!isLocked)
            {
                <div class="border-t border-base-200 pt-4">
                    @if (!Model.Any())
                    {
                        <p class="text-sm text-base-content/50 mb-3">@L["EmptyHint"]</p>
                    }
                    <form asp-action="AddCategory" method="post" class="flex flex-col gap-2">
                        <input type="hidden" name="projectId" value="@projectId" />
                        <input type="hidden" name="isNew" value="@isNew.ToString().ToLower()" />
                        @for (var i = 0; i < availableLangs.Length; i++)
                        {
                            var code = availableLangs[i];
                            <div class="flex gap-3 items-end">
                                <span class="text-xs font-bold uppercase text-base-content/40 w-6 shrink-0 self-end pb-1.5">@code</span>
                                <input type="hidden" name="Translations[@i].LanguageCode" value="@code" />
                                <div class="form-control gap-1.5 w-56">
                                    @if (i == 0)
                                    {
                                        <label class="text-sm font-semibold text-base-content">@L["NameRequired"]</label>
                                    }
                                    <input type="text" name="Translations[@i].Name" class="input input-bordered input-sm w-full" placeholder="@L["CategoryNamePlaceholder"]" required />
                                </div>
                                <div class="form-control gap-1.5 flex-1 max-w-sm">
                                    @if (i == 0)
                                    {
                                        <label class="text-sm font-semibold text-base-content">@L["DescriptionLabel"]</label>
                                    }
                                    <input type="text" name="Translations[@i].Description" class="input input-bordered input-sm w-full" placeholder="@L["OptionalPlaceholder"]" />
                                </div>
                            </div>
                        }
                        <div>
                            <button type="submit" class="btn btn-primary btn-sm gap-1">
                                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
                                @L["AddButton"]
                            </button>
                        </div>
                    </form>
                </div>
            }
        </div>
    </div>

    <details class="card bg-base-100 shadow-sm" @(isLocked ? "" : "open")>
        <summary class="card-body cursor-pointer flex-row items-center gap-2 py-4">
            <h2 class="font-heading font-semibold text-base text-base-content uppercase tracking-wide opacity-60">@L["SettingsHeading"]</h2>
            <svg class="w-4 h-4 text-base-content/40 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
        </summary>
        <div class="card-body pt-0 gap-4">
            <form asp-action="SaveIdeationSettings" method="post" class="flex flex-col gap-4">
                <input type="hidden" name="projectId" value="@projectId" />
                <input type="hidden" name="isNew" value="@isNew.ToString().ToLower()" />
                <div class="grid grid-cols-2 gap-4">
                    <div class="form-control gap-1.5">
                        <label class="text-sm font-semibold text-base-content">@L["MaxShownIdeasLabel"]</label>
                        <input type="number" name="ideaPageSize" min="1" max="100" value="@(project?.IdeaPageSize ?? 5)" class="input input-bordered input-sm w-full" @(isLocked ? "disabled" : "") />
                    </div>
                    <div class="form-control gap-1.5">
                        <label class="text-sm font-semibold text-base-content">@L["MaxExtraRequestsLabel"]</label>
                        <input type="number" name="maxExtraIdeaRequests" min="0" max="50" value="@(project?.MaxExtraIdeaRequests ?? 3)" class="input input-bordered input-sm w-full" @(isLocked ? "disabled" : "") />
                    </div>
                </div>
                <div class="form-control gap-1.5 max-w-xs">
                    <label class="text-sm font-semibold text-base-content">@L["ExtraBehaviorLabel"]</label>
                    @{
                        var replaceExisting = project?.ExtraIdeasReplaceExisting ?? false;
                    }
                    <select name="extraIdeasReplaceExisting" class="select select-bordered select-sm w-full" @(isLocked ? "disabled" : "")>
                        @if (!replaceExisting)
                        {
                            <option value="false" selected>@L["ExtraBehavior_Append"]</option>
                            <option value="true">@L["ExtraBehavior_Replace"]</option>
                        }
                        else
                        {
                            <option value="false">@L["ExtraBehavior_Append"]</option>
                            <option value="true" selected>@L["ExtraBehavior_Replace"]</option>
                        }
                    </select>
                </div>
                @if (!isLocked)
                {
                    <div><button type="submit" class="btn btn-primary btn-sm">@Shared["Common_Save"]</button></div>
                }
            </form>
        </div>
    </details>

    <div class="flex justify-between">
        <a asp-action="Questions" asp-route-projectId="@projectId" asp-route-isNew="@isNew" class="btn btn-ghost btn-sm">← @L["QuestionsLink"]</a>
        <div class="flex gap-2">
            @if (!isLocked)
            {
                <form asp-action="SaveProgress" method="post" class="inline">
                    <input type="hidden" name="projectId" value="@projectId" />
                    <input type="hidden" name="isNew" value="@isNew.ToString().ToLower()" />
                    <input type="hidden" name="step" value="3" />
                    <input type="hidden" name="returnAction" value="Ideation" />
                    <button type="submit" class="btn btn-outline btn-sm">@Shared["Common_Save"]</button>
                </form>
            }
            @if (!isLocked && !Model.Any())
            {
                <div class="flex flex-col items-end gap-1">
                    <button type="button" class="btn btn-primary btn-sm" disabled>@L["NextLink"] →</button>
                    <span class="text-xs text-warning">@L["NoCategoriesRequired"]</span>
                </div>
            }
            else
            {
                <a asp-action="@(isLocked ? "Dashboard" : "Activate")" asp-route-projectId="@projectId" class="btn btn-primary btn-sm">@(isLocked ? L["DashboardLink"].Value : L["NextLink"].Value) →</a>
            }
        </div>
    </div>
</div>
</div>
