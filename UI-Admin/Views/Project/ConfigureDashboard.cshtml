@using SynapseEnqueteManagement.UI.Admin.Models.Dashboard
@model ConfigureDashboardViewModel
@{
    ViewData["Title"] = "Widgets instellen";
    ViewData["ActiveSection"] = "Dashboard";
    Layout = "_Layout";
}
<div class="max-w-lg">
    <h1 class="font-heading font-bold text-2xl text-base-content mb-6">Widgets instellen</h1>
    <div class="card bg-base-100 shadow-sm">
        <div class="card-body gap-4">
            <form asp-action="ConfigureDashboard" asp-route-projectId="@Model.ProjectId" method="post" class="flex flex-col gap-3">
                @for (var i = 0; i < 9; i++)
                {
                    <div class="flex items-center gap-3">
                        <span class="text-base-content/40 text-xs w-20">Positie @(i + 1)</span>
                        <select name="Layout[@i]" class="select select-bordered select-sm flex-1">
                            @foreach (var type in Model.AllWidgetTypes)
                            {
                                var isSelected = i < Model.Layout.Length && Model.Layout[i] == type;
                                var label = type switch {
                                    "ViewCount" => "Bekeken (aantal)", "CompletionCount" => "Ingevuld (aantal)",
                                    "CompletionRate" => "Voltooiingsgraad (%)", "ParticipationTimeline" => "Deelname over tijd",
                                    "TopCategories" => "Top categorieën", "TopIdeas" => "Top ideeën",
                                    "SurveyDistribution" => "Survey-link & QR", "IdeaFeed" => "Nieuwste ideeën",
                                    "ModerationQueue" => "Moderatiestatus", _ => type
                                };
                                if (isSelected)
                                {
                                    <option value="@type" selected>@label</option>
                                }
                                else
                                {
                                    <option value="@type">@label</option>
                                }
                            }
                        </select>
                    </div>
                }
                <div class="card-actions justify-end gap-2 pt-2">
                    <a asp-action="Dashboard" asp-route-projectId="@Model.ProjectId" class="btn btn-ghost btn-sm">Annuleren</a>
                    <button type="submit" class="btn btn-primary btn-sm">Opslaan</button>
                </div>
            </form>
        </div>
    </div>
</div>
