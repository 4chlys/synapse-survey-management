@using SynapseEnqueteManagement.UI.Admin.Models.Project
@using Microsoft.Extensions.Options
@inject IOptions<SynapseEnqueteManagement.UI.Admin.AdminSettings> AdminSettingsOptions
@model CreateProjectViewModel
@{
    ViewData["Title"] = "Admin - Project aanmaken";
    Layout = "_Layout";
    var project = ViewData["Project"] as ProjectAdminViewModel;
    var participantDomain = AdminSettingsOptions.Value.ParticipantDomain;
}

<div class="min-h-screen bg-gray-900 text-white flex flex-col">

    <div class="flex items-center gap-2 px-6 pt-4">
        <div class="w-10 h-10 rounded-full border-2 border-white flex items-center justify-center overflow-hidden">
            <img src="@(project?.OrganisationLogoUrl ?? AppConstants.DefaultOrganisationLogoUrl)" alt="Organisatie" class="w-full h-full object-cover" />
        </div>
        <span class="text-xs">Admin</span>
    </div>

    <form asp-action="Create" method="post" class="flex-1 flex flex-col px-6 pt-4 pb-6">

        <input type="hidden" asp-for="ProjectId" />
        <p class="text-xs font-bold mb-4 text-center">Project aanmaken</p>

        <div class="grid grid-cols-2 gap-4 flex-1 pl-32">

            @* Left column *@
            <div class="space-y-5">

                <div>
                    <label class="block text-xs mb-1">Projectnaam</label>
                    <input asp-for="Name"
                           id="project-name-input"
                           placeholder="Voer de naam van je project in"
                           class="w-2/3 bg-gray-900 border border-gray-500 text-white text-xs italic px-3 py-2 focus:outline-none" />
                    <span asp-validation-for="Name" class="text-red-400 text-xs"></span>
                </div>

                <div>
                    <label class="block text-xs mb-1">URL-shortform</label>
                    <input asp-for="ShortForm"
                           id="project-shortform-input"
                           placeholder="automatisch ingevuld vanuit de naam"
                           readonly="@(project != null && project.ProjectState != "Draft" ? "readonly" : null)"
                           class="w-2/3 bg-gray-900 border border-gray-500 text-white text-xs italic px-3 py-2 focus:outline-none" />
                    <span asp-validation-for="ShortForm" class="text-red-400 text-xs"></span>
                    <span id="shortform-availability-msg" class="text-red-400 text-xs block"></span>
                    @if (project != null && project.ProjectState != "Draft")
                    {
                        <p class="text-xs text-gray-500 mt-1">Vergrendeld omdat dit project gepubliceerd is.</p>
                    }
                    else
                    {
                        <p class="text-xs text-gray-500 mt-1">Gebruikt voor de deelnemers-URL: &lt;shortform&gt;.@participantDomain. Laat leeg om automatisch in te vullen vanuit de projectnaam.</p>
                    }
                </div>

                <div>
                    <label class="block text-xs mb-1">Interactiemodus</label>
                    <div class="flex">
                        <button type="button" id="btn-chat"
                                class="px-5 py-1 text-xs border border-gray-500 text-white">Chat</button>
                        <button type="button" id="btn-scroll"
                                class="px-5 py-1 text-xs border border-gray-500 text-white border-l-0">Scroll</button>
                    </div>
                    <input type="hidden" asp-for="InteractionMode" id="InteractionMode"
                           data-initial="@Model.InteractionMode" />
                </div>

                <div>
                    <label class="block text-xs mb-1">AI-assistentie</label>
                    <div class="flex gap-4">
                        <label class="flex items-center gap-1 text-xs cursor-pointer">
                            <input type="radio" asp-for="AiAssistance" value="ProActive" /> Pro-actief
                        </label>
                        <label class="flex items-center gap-1 text-xs cursor-pointer">
                            <input type="radio" asp-for="AiAssistance" value="AskFirst" /> Eerst vragen
                        </label>
                        <label class="flex items-center gap-1 text-xs cursor-pointer">
                            <input type="radio" asp-for="AiAssistance" value="Never" /> Nooit
                        </label>
                    </div>
                </div>

                <div>
                    <label class="block text-xs mb-1">Leeftijdsbereik <span class="text-gray-500">(optioneel)</span></label>
                    <div class="flex items-center gap-2">
                        <input asp-for="MinAge" type="number" placeholder="Min" min="1"
                               class="w-20 bg-gray-900 border border-gray-500 text-white text-xs px-3 py-1 text-center focus:outline-none appearance-none no-spinner"
                               />
                        <span class="text-gray-400 text-xs">—</span>
                        <input asp-for="MaxAge" type="number" placeholder="Max" min="1"
                               class="w-20 bg-gray-900 border border-gray-500 text-white text-xs px-3 py-1 text-center focus:outline-none appearance-none no-spinner"
                               />
                    </div>
                </div>

                <div>
                    <label class="block text-xs mb-1">Afbeelding</label>
                    <div id="image-preview-box" class="border border-dashed border-gray-500 w-44 h-36 relative mb-2 overflow-hidden">
                        <svg id="image-placeholder" class="absolute inset-0 w-full h-full" xmlns="http://www.w3.org/2000/svg">
                            <line x1="0" y1="0" x2="100%" y2="100%" stroke="#6B7280" stroke-width="1" />
                            <line x1="100%" y1="0" x2="0" y2="100%" stroke="#6B7280" stroke-width="1" />
                        </svg>
                        <img id="image-preview" src="" alt="" class="absolute inset-0 w-full h-full object-cover hidden" />
                    </div>
                    <div class="flex gap-2">
                        <button type="button"
                                class="px-4 py-1 text-xs border border-gray-500 bg-gray-900 text-white hover:bg-gray-800">Genereren</button>
                        <button type="button" id="browse-btn"
                                class="px-4 py-1 text-xs border border-gray-500 bg-gray-900 text-white hover:bg-gray-800">Bladeren</button>
                    </div>
                    <input type="hidden" asp-for="ImageUrl" id="ImageUrl" />
                    <input type="file" id="image-file-input" accept="image/*" class="hidden" />
                </div>

            </div>

            @* Right column *@
            <div class="space-y-5">

                <div>
                    <label class="block text-xs mb-1">Onderwerp</label>
                    <input asp-for="Topic"
                           placeholder="Wat is het onderwerp van je project?"
                           class="w-2/3 bg-gray-900 border border-gray-500 text-white text-xs italic px-3 py-2 focus:outline-none" />
                    <span asp-validation-for="Topic" class="text-red-400 text-xs"></span>
                </div>

                <div>
                    <label class="block text-xs mb-1">Introductie</label>
                    <div class="w-2/3">
                        <div id="intro-editor" class="bg-gray-900 text-white text-xs"
                             style="min-height: 160px;">@Html.Raw(Model.Introduction)</div>
                    </div>
                    <input type="hidden" asp-for="Introduction" id="Introduction" />
                    <span asp-validation-for="Introduction" class="text-red-400 text-xs"></span>
                </div>

                <div>
                    <label class="block text-xs mb-2">Secties <span class="text-gray-500">(optioneel)</span></label>
                    <div id="sections-list" class="space-y-2 mb-1" data-initial-count="@Model.Sections.Count">
                        @for (int i = 0; i < Model.Sections.Count; i++)
                        {
                            <div class="flex items-center gap-1">
                                <input name="Sections[@i]" type="text" value="@Model.Sections[i]"
                                       class="flex-1 bg-gray-900 border border-gray-500 text-white text-xs px-3 py-1 focus:outline-none" />
                                <button type="button" data-remove-section
                                        class="text-gray-500 hover:text-white text-xs px-1">✕</button>
                            </div>
                        }
                    </div>
                    <button type="button" id="add-section-btn"
                            class="text-xs text-gray-300 hover:text-white">+ Toevoegen</button>
                </div>

                <div>
                    <label class="block text-xs mb-1">Contacttoestemming na idee-inzending</label>
                    <div class="flex">
                        <button type="button" id="btn-off"
                                class="px-5 py-1 text-xs border border-gray-500 text-white">UIT</button>
                        <button type="button" id="btn-on"
                                class="px-5 py-1 text-xs border border-gray-500 text-white border-l-0">AAN</button>
                    </div>
                    <input type="hidden" asp-for="ContactOptIn" id="ContactOptIn"
                           data-initial="@Model.ContactOptIn.ToString().ToLower()" />
                </div>

            </div>
        </div>

        <div class="flex justify-between mt-8">
            <a asp-controller="Project" asp-action="Index"
               class="px-6 py-2 text-xs border border-gray-500 bg-gray-900 text-white hover:bg-gray-800">Afsluiten</a>
            <div class="flex gap-3">
                <button type="submit" name="submitAction" value="save"
                        class="px-6 py-2 text-xs border border-gray-500 bg-gray-900 text-white hover:bg-gray-800">Opslaan</button>
                <button type="submit" name="submitAction" value="next"
                        class="px-6 py-2 text-xs border border-gray-500 bg-gray-900 text-white hover:bg-gray-800">Volgende →</button>
            </div>
        </div>

    </form>
</div>
