@model SynapseEnqueteManagement.UI.Admin.Models.Project.CreateProjectViewModel
@{
    var isEdit = Model.ProjectId.HasValue;
    var projectState = (string)(ViewData["ProjectState"] ?? "");
    var isLocked = isEdit && projectState is "Active" or "Archived";
    var shortFormReadonly = isEdit && projectState != "Draft";
    ViewData["Title"]         = isEdit ? "Project bewerken" : "Project aanmaken";
    ViewData["ActiveSection"] = "Instellingen";
    ViewData["HideSidebar"]   = true;
    Layout = "_Layout";
}

<div class="max-w-2xl">
    <h1 class="font-heading font-bold text-2xl text-base-content mb-6">
        @(isEdit ? "Project bewerken" : "Nieuw project")
    </h1>

    @if (isLocked)
    {
        <div class="alert alert-warning mb-4">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" class="flex-shrink-0"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            <span>Dit project is @(projectState == "Active" ? "actief" : "gearchiveerd"). Instellingen kunnen niet meer worden gewijzigd.</span>
        </div>
    }

    <div class="card bg-base-100 shadow-sm">
        <div class="card-body gap-5">
            <form asp-action="Create" method="post" class="flex flex-col gap-5">
                @Html.AntiForgeryToken()
                @if (isEdit) { <input type="hidden" asp-for="ProjectId" /> }
                <fieldset @(isLocked ? "disabled" : "") class="flex flex-col gap-5 contents">

                <label class="form-control">
                    <div class="label"><span class="label-text font-medium">Projectnaam *</span></div>
                    <input asp-for="Name" id="project-name-input" class="input input-bordered w-full" placeholder="Bijv. Mentaal Welzijn" maxlength="100" required />
                    <span asp-validation-for="Name" class="label-text-alt text-error mt-1"></span>
                </label>

                <label class="form-control">
                    <div class="label"><span class="label-text font-medium">Shortform</span></div>
                    <input asp-for="ShortForm" id="project-shortform-input"
                           class="input input-bordered w-full" placeholder="automatisch ingevuld vanuit de naam"
                           maxlength="30" pattern="^[a-z0-9](-?[a-z0-9])*$"
                           readonly="@shortFormReadonly" />
                    <span asp-validation-for="ShortForm" class="label-text-alt text-error mt-1"></span>
                    <span id="shortform-availability-msg" class="label-text-alt text-warning mt-1"></span>
                </label>

                <label class="form-control">
                    <div class="label"><span class="label-text font-medium">Onderwerp</span></div>
                    <input asp-for="Topic" class="input input-bordered w-full" placeholder="Waar gaat dit project over?" maxlength="100" />
                    <span asp-validation-for="Topic" class="label-text-alt text-error mt-1"></span>
                </label>

                <label class="form-control">
                    <div class="label"><span class="label-text font-medium">Introductietekst</span></div>
                    <textarea asp-for="Introduction" rows="4"
                              class="textarea textarea-bordered w-full resize-none"
                              placeholder="Welkomstboodschap voor deelnemers…"
                              maxlength="5000"></textarea>
                    <span asp-validation-for="Introduction" class="label-text-alt text-error mt-1"></span>
                </label>

                <div class="grid grid-cols-2 gap-4">
                    <label class="form-control">
                        <div class="label"><span class="label-text font-medium">Formuliertype</span></div>
                        <select asp-for="InteractionMode" class="select select-bordered w-full">
                            <option value="VerticalScroll">Verticaal scrollen</option>
                            <option value="Paginated">Paginering</option>
                        </select>
                    </label>
                    <label class="form-control">
                        <div class="label"><span class="label-text font-medium">AI-assistentie</span></div>
                        <select asp-for="AiAssistance" class="select select-bordered w-full">
                            <option value="ProActive">Pro-actief</option>
                            <option value="AskFirst">Op aanvraag</option>
                            <option value="Never">Nooit</option>
                        </select>
                    </label>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <label class="form-control">
                        <div class="label"><span class="label-text font-medium">Minimumleeftijd</span></div>
                        <input asp-for="MinAge" type="number" id="min-age-input" min="0" max="120"
                               class="input input-bordered w-full no-spinner" placeholder="Optioneel" />
                        <span asp-validation-for="MinAge" class="label-text-alt text-error mt-1"></span>
                    </label>
                    <label class="form-control">
                        <div class="label"><span class="label-text font-medium">Maximumleeftijd</span></div>
                        <input asp-for="MaxAge" type="number" id="max-age-input" min="0" max="120"
                               class="input input-bordered w-full no-spinner" placeholder="Optioneel" />
                        <span asp-validation-for="MaxAge" class="label-text-alt text-error mt-1"></span>
                    </label>
                </div>
                <span id="age-range-error" class="hidden text-error text-xs -mt-3 block">MinLeeftijd mag niet groter zijn dan MaxLeeftijd.</span>

                <label class="form-control">
                    <div class="label"><span class="label-text font-medium">Afbeelding URL</span></div>
                    <input asp-for="ImageUrl" class="input input-bordered w-full" placeholder="https://…" />
                </label>

                <div class="form-control">
                    <label class="label cursor-pointer justify-start gap-3">
                        <input asp-for="ContactOptIn" type="checkbox" class="checkbox checkbox-primary" />
                        <span class="label-text">Contactgegevens opvragen bij deelnemers</span>
                    </label>
                </div>

                <div class="divider my-0">Secties</div>

                <div id="sections-container" class="flex flex-col gap-2">
                    @for (int i = 0; i < (Model.Sections?.Count ?? 0); i++)
                    {
                        <div class="flex gap-2 items-center section-row">
                            <input type="text" name="Sections[@i]" value="@Model.Sections![i]" maxlength="20"
                                   class="input input-bordered input-sm flex-1" placeholder="Sectienaam" />
                            <button type="button" class="btn btn-ghost btn-sm text-error remove-section">×</button>
                        </div>
                    }
                </div>
                <button type="button" id="add-section" class="btn btn-ghost btn-sm gap-1 self-start">
                    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
                    Sectie toevoegen
                </button>

                <div class="card-actions justify-end gap-2 pt-2">
                    @if (!isLocked)
                    {
                        <a asp-action="Index" class="btn btn-ghost">Annuleren</a>
                        <button type="submit" name="submitAction" value="save" class="btn btn-outline">Opslaan</button>
                        <button type="submit" name="submitAction" value="next" class="btn btn-primary">Volgende →</button>
                    }
                    else
                    {
                        <a asp-action="Index" class="btn btn-ghost">Terug</a>
                        @if (Model.ProjectId.HasValue)
                        {
                            <a asp-action="Questions" asp-route-projectId="@Model.ProjectId" class="btn btn-primary">Volgende →</a>
                        }
                    }
                </div>
                </fieldset>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script type="module">
        let idx = @(Model.Sections?.Count ?? 0);
        document.getElementById('add-section').addEventListener('click', () => {
            const row = document.createElement('div');
            row.className = 'flex gap-2 items-center section-row';
            row.innerHTML = `<input type="text" name="Sections[${idx}]" maxlength="20" class="input input-bordered input-sm flex-1" placeholder="Sectienaam" /><button type="button" class="btn btn-ghost btn-sm text-error remove-section">×</button>`;
            document.getElementById('sections-container').appendChild(row);
            idx++;
        });
        document.getElementById('sections-container').addEventListener('click', e => {
            if (e.target.classList.contains('remove-section')) e.target.closest('.section-row').remove();
        });
    </script>
}
