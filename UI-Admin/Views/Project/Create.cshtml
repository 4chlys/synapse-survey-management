@using SynapseEnqueteManagement.BL.Domain.Project.Enums
@model SynapseEnqueteManagement.UI.Admin.Models.Project.CreateProjectViewModel
@inject IViewLocalizer L
@inject IHtmlLocalizer<SharedResource> Shared
@{
    var isEdit = Model.ProjectId.HasValue;
    var projectState = (string)(ViewData["ProjectState"] ?? "");
    var isLocked = isEdit && projectState is "Active" or "Archived";
    var shortFormReadonly = isEdit && projectState != "Draft";
    bool isNew = ViewData["IsNew"] is true;
    ViewData["Title"]         = isEdit ? L["TitleEdit"].Value : L["TitleCreate"].Value;
    ViewData["ActiveSection"] = "Settings";
    Layout = "_Layout";
    if (!isEdit || isNew) ViewData["WizardStep"] = 1;
}

@* Inline helper: label + optional tooltip icon *@
@functions {
    static Microsoft.AspNetCore.Html.IHtmlContent InfoIcon(string tip)
        => new Microsoft.AspNetCore.Html.HtmlString(
            $"<div class=\"tooltip tooltip-right\" data-tip=\"{System.Net.WebUtility.HtmlEncode(tip)}\">" +
            "<span class=\"text-base-content/35 hover:text-base-content/60 cursor-help text-xs select-none\">ⓘ</span></div>");
}

<div class="w-full">
    <h1 class="font-heading font-bold text-2xl text-base-content mb-6">
        @(isEdit ? L["HeadingEdit"].Value : L["HeadingNew"].Value)
    </h1>

    @if (isLocked)
    {
        <div class="alert alert-warning mb-4">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" class="flex-shrink-0"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            <span>@(projectState == "Active" ? L["LockedActive"] : L["LockedArchived"])</span>
        </div>
    }

    <form id="project-form" asp-action="Create" method="post" class="flex flex-col gap-6">
        @Html.AntiForgeryToken()
        @if (isEdit) { <input type="hidden" asp-for="ProjectId" /> }
        <input type="hidden" name="isNew" value="@isNew.ToString().ToLower()" />

        <fieldset @(isLocked ? "disabled" : "") class="contents">

            @* ── Card 1: General Info ── *@
            <div class="card bg-base-100 shadow-sm">
                <div class="card-body gap-5">
                    <h2 class="font-heading font-semibold text-base text-base-content uppercase tracking-wide opacity-60 pb-1 border-b border-base-200">@L["SectionGeneral"]</h2>

                    <div class="grid grid-cols-2 gap-4">
                        <div class="form-control gap-1.5">
                            <div class="flex items-center gap-1.5">
                                <label class="text-sm font-semibold text-base-content" for="project-name-input">@L["NameLabel"] <span class="text-error">*</span></label>
                            </div>
                            <input asp-for="Name" id="project-name-input" class="input input-bordered w-full" placeholder="@L["NamePlaceholder"]" maxlength="100" required />
                            <span asp-validation-for="Name" class="text-xs text-error"></span>
                        </div>

                        <div class="form-control gap-1.5">
                            <div class="flex items-center gap-1.5">
                                <label class="text-sm font-semibold text-base-content">@L["LanguageLabel"] <span class="text-error">*</span></label>
                            </div>
                            <select asp-for="DefaultLanguageCode" class="select select-bordered w-full">
                                <option value="nl">Nederlands</option>
                                <option value="en">English</option>
                            </select>
                            <span asp-validation-for="DefaultLanguageCode" class="text-xs text-error"></span>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-4">
                        <div class="form-control gap-1.5">
                            <div class="flex items-center gap-1.5">
                                <label class="text-sm font-semibold text-base-content" for="project-shortform-input">@L["ShortformLabel"]</label>
                                @InfoIcon(L["ShortformHint"].Value)
                            </div>
                            <input asp-for="ShortForm" id="project-shortform-input"
                                   class="input input-bordered w-full" placeholder="@L["ShortformPlaceholder"]"
                                   maxlength="30" pattern="^[a-z0-9](-?[a-z0-9])*$"
                                   readonly="@shortFormReadonly" />
                            <span asp-validation-for="ShortForm" class="text-xs text-error"></span>
                            <span id="shortform-availability-msg" class="text-xs text-warning"></span>
                        </div>

                        <div class="form-control gap-1.5">
                            <div class="flex items-center gap-1.5">
                                <label class="text-sm font-semibold text-base-content">@L["TopicLabel"] <span class="text-error">*</span></label>
                            </div>
                            <input asp-for="Topic" class="input input-bordered w-full" placeholder="@L["TopicPlaceholder"]" maxlength="100" />
                            <span asp-validation-for="Topic" class="text-xs text-error"></span>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-4 items-start">
                        <div class="form-control gap-1.5">
                            <div class="flex items-center gap-1.5">
                                <span class="text-sm font-semibold text-base-content">@L["IntroductionLabel"] <span class="text-error">*</span></span>
                                @InfoIcon(L["IntroductionHint"].Value)
                            </div>
                            @if (isLocked)
                            {
                                <div class="prose max-w-none border border-base-300 rounded p-3 bg-base-200">
                                    @Html.Raw(Model.Introduction)
                                </div>
                            }
                            else
                            {
                                <div id="intro-editor" class="bg-base-100">@Html.Raw(Model.Introduction)</div>
                            }
                            <input type="hidden" asp-for="Introduction" id="Introduction" />
                            <div class="flex justify-between">
                                <span asp-validation-for="Introduction" class="text-xs text-error"></span>
                                <span id="intro-char-count" class="text-xs text-base-content/40"></span>
                            </div>
                        </div>

                        <div class="form-control gap-1.5">
                            <div class="flex items-center gap-1.5">
                                <span class="text-sm font-semibold text-base-content">@L["ImageLabel"]</span>
                                @InfoIcon(L["ImageHint"].Value)
                            </div>
                            <div id="image-drop-zone"
                                 class="relative border-2 border-dashed border-base-300 rounded-xl bg-base-200
                                        flex items-center justify-center min-h-44 w-full overflow-hidden -mt-0.5
                                        transition-colors @(!isLocked ? "cursor-pointer hover:border-primary/50 hover:bg-base-200/60" : "")">
                                <div id="image-placeholder"
                                     class="flex flex-col items-center gap-2 text-base-content/35 pointer-events-none select-none @(!string.IsNullOrEmpty(Model.ImageUrl) ? "hidden" : "")">
                                    <svg width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                                        <path d="M4 16.2A5 5 0 0 1 6.5 7a7 7 0 0 1 13.5 2.1 4 4 0 0 1-.5 7.9H5"/>
                                        <path d="M12 13v8M9 18l3-3 3 3"/>
                                    </svg>
                                    <p class="text-sm text-center leading-snug px-6">
                                        <span class="font-medium">@L["DropzonePrimary"]</span><br/>
                                        <span class="text-xs opacity-75">@L["DropzoneSecondary"]</span>
                                    </p>
                                </div>
                                <img id="image-preview" src="@(Model.ImageUrl ?? "")" alt=""
                                     class="absolute inset-0 w-full h-full object-cover @(string.IsNullOrEmpty(Model.ImageUrl) ? "hidden" : "")" />
                                @if (!isLocked)
                                {
                                    <div id="image-drag-overlay"
                                         class="hidden absolute inset-0 bg-primary/10 flex items-center justify-center pointer-events-none">
                                        <span class="bg-base-100/80 text-primary font-semibold text-sm rounded-lg px-4 py-2">@L["DropzoneDropHere"]</span>
                                    </div>
                                    <button type="button" id="image-clear-btn"
                                            class="absolute top-2 right-2 btn btn-xs btn-circle btn-error shadow @(string.IsNullOrEmpty(Model.ImageUrl) ? "hidden" : "")">
                                        ✕
                                    </button>
                                }
                            </div>
                            <input type="hidden" asp-for="ImageUrl" id="ImageUrl" />
                            <span asp-validation-for="ImageUrl" class="text-xs text-error"></span>
                        </div>
                    </div>

                    @* Checkbox (left) aligned with image buttons (right) *@
                    <div class="grid grid-cols-2 gap-4 items-center">
                        <div class="form-control">
                            <label class="flex items-center gap-3 cursor-pointer">
                                <input asp-for="ContactOptIn" type="checkbox" class="checkbox checkbox-primary" />
                                <span class="text-sm text-base-content">@L["ContactOptInLabel"]</span>
                            </label>
                        </div>
                        @if (!isLocked)
                        {
                            <div class="flex gap-2">
                                <button type="button" id="browse-btn" class="btn btn-outline btn-sm flex-1">@L["BrowseButton"]</button>
                                <button type="button" id="generate-btn" class="btn btn-outline btn-sm flex-1"
                                        data-generating-text="@L["GeneratingText"]">@L["GenerateButton"]</button>
                            </div>
                            <input type="file" id="image-file-input" accept="image/*" class="hidden" />
                        }
                    </div>

                    @if ((Model.SupportedLanguageCodes?.Count ?? 0) > 1)
                    {
                        <div class="form-control gap-1">
                            <label class="flex items-center gap-3 cursor-pointer">
                                <input asp-for="AllowCrossLanguageIdeas" type="checkbox" class="checkbox checkbox-primary" />
                                <span class="text-sm text-base-content">@L["CrossLanguageLabel"]</span>
                            </label>
                            <span class="text-xs text-base-content/50 pl-9">@L["CrossLanguageHint"]</span>
                        </div>
                    }
                </div>
            </div>

            @* ── Card 2: Appearance ── *@
            <div class="card bg-base-100 shadow-sm">
                <div class="card-body gap-5">
                    <h2 class="font-heading font-semibold text-base text-base-content uppercase tracking-wide opacity-60 pb-1 border-b border-base-200">@L["SectionAppearance"]</h2>

                    <div class="form-control gap-1.5">
                        <div class="flex items-center gap-1.5">
                            <label class="text-sm font-semibold text-base-content">@L["ThemeLabel"]</label>
                        </div>
                        @* Option values must match the string the model holds (enum name, e.g.
                           "HighContrast"); GetEnumSelectList would emit integer-string values
                           that never match, so the saved theme never preselects. *@
                        <select asp-for="Theme"
                                asp-items="@(Enum.GetNames<ProjectTheme>().Select(n => new SelectListItem { Value = n, Text = n }))"
                                class="select select-bordered w-full max-w-xs"></select>
                        <span asp-validation-for="Theme" class="text-xs text-error"></span>
                    </div>

                    <div class="form-control gap-1.5">
                        <span class="text-sm font-semibold text-base-content">@L["PreviewLabel"]</span>
                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <span class="text-xs text-base-content/50">@L["PreviewLight"]</span>
                                <div id="theme-preview-light"
                                     data-initial-theme="@((Model.Theme ?? "Minimal").ToLowerInvariant())"
                                     data-mode="light"></div>
                            </div>
                            <div>
                                <span class="text-xs text-base-content/50">@L["PreviewDark"]</span>
                                <div id="theme-preview-dark"
                                     data-initial-theme="@((Model.Theme ?? "Minimal").ToLowerInvariant())"
                                     data-mode="dark"></div>
                            </div>
                        </div>
                        <span class="text-xs text-base-content/40">@L["PreviewHint"]</span>
                    </div>

                    <div class="form-control gap-1.5">
                        <div class="flex items-center gap-1.5">
                            <span class="text-sm font-semibold text-base-content">@L["PrimaryColorLabel"]</span>
                        </div>
                        <div class="flex items-center gap-3">
                            <input id="primary-color-picker" type="color" value="#16A34A"
                                   class="h-10 w-16 rounded border border-base-300 cursor-pointer disabled:opacity-50" />
                            <label class="flex items-center gap-2 cursor-pointer">
                                <input id="use-theme-color" type="checkbox" class="checkbox checkbox-sm" />
                                <span class="text-sm text-base-content">@L["UseThemeColorLabel"]</span>
                            </label>
                        </div>
                        <div>
                            <span class="text-xs text-base-content/50">@L["ColorSwatches_Label"]</span>
                            <div id="primary-color-swatches" class="flex flex-wrap gap-2 mt-1.5">
                                <button type="button" data-swatch-color="#EA580C"
                                        class="h-7 w-7 rounded-full border border-base-300 cursor-pointer hover:scale-110 transition-transform"
                                        style="background-color:#EA580C" title="@L["ColorSwatch_Sports"]"
                                        aria-label="@L["ColorSwatch_Sports"]"></button>
                                <button type="button" data-swatch-color="#16A34A"
                                        class="h-7 w-7 rounded-full border border-base-300 cursor-pointer hover:scale-110 transition-transform"
                                        style="background-color:#16A34A" title="@L["ColorSwatch_Nature"]"
                                        aria-label="@L["ColorSwatch_Nature"]"></button>
                                <button type="button" data-swatch-color="#7C3AED"
                                        class="h-7 w-7 rounded-full border border-base-300 cursor-pointer hover:scale-110 transition-transform"
                                        style="background-color:#7C3AED" title="@L["ColorSwatch_Culture"]"
                                        aria-label="@L["ColorSwatch_Culture"]"></button>
                                <button type="button" data-swatch-color="#0D9488"
                                        class="h-7 w-7 rounded-full border border-base-300 cursor-pointer hover:scale-110 transition-transform"
                                        style="background-color:#0D9488" title="@L["ColorSwatch_Health"]"
                                        aria-label="@L["ColorSwatch_Health"]"></button>
                            </div>
                        </div>
                        <input asp-for="PrimaryColor" type="hidden" />
                        <span asp-validation-for="PrimaryColor" class="text-xs text-error"></span>
                        <div id="primary-color-contrast-warning"
                             class="hidden flex items-start gap-1 text-warning text-xs"
                             role="status" aria-live="polite"
                             data-light-base="#FFFFFF"
                             data-dark-base="#1A1430"
                             data-min-ratio="3"
                             data-msg-light="@L["PrimaryColor_LowContrast_Light"]"
                             data-msg-dark="@L["PrimaryColor_LowContrast_Dark"]"
                             data-msg-both="@L["PrimaryColor_LowContrast_Both"]">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0 mt-0.5">
                                <path d="M12 9v4m0 4h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
                            </svg>
                            <span data-warning-text></span>
                        </div>
                    </div>

                    <details open="@(string.IsNullOrWhiteSpace(Model.CustomCss) ? null : "open")">
                        <summary class="cursor-pointer text-sm font-semibold text-base-content py-1">@L["CustomCssLabel"]</summary>
                        <div class="form-control mt-2 gap-1.5">
                            <div class="flex justify-end">
                                <button id="customcss-reset" type="button" class="btn btn-xs btn-ghost"
                                        data-confirm="@L["CustomCss_ResetConfirm"].Value">@L["CustomCss_ResetButton"]</button>
                            </div>
                            <textarea asp-for="CustomCss" rows="6"
                                      class="textarea textarea-bordered w-full font-mono text-sm"></textarea>
                            <span class="text-xs text-base-content/40">@L["CustomCssHint"]</span>
                            <span asp-validation-for="CustomCss" class="text-xs text-error"></span>
                            <details class="mt-1 text-sm">
                                <summary class="cursor-pointer text-sm text-base-content/70">
                                    @L["CustomCssHelperSummary"]
                                </summary>
                                <div id="customcss-helper" class="mt-2 flex flex-col gap-3">
                                    <div>
                                        <div class="text-xs uppercase opacity-60 mb-1">@L["CustomCssVariables"]</div>
                                        <div data-helper-group="variables" class="flex flex-wrap gap-1"></div>
                                    </div>
                                    <div>
                                        <div class="text-xs uppercase opacity-60 mb-1">@L["CustomCssSnippets"]</div>
                                        <div data-helper-group="snippets" class="flex flex-wrap gap-1"
                                             data-label-primary-color="@L["Snippet_PrimaryColor"]"
                                             data-label-rounded-buttons="@L["Snippet_RoundedButtons"]"
                                             data-label-idea-card-shadow="@L["Snippet_IdeaCardShadow"]"
                                             data-label-heading-font="@L["Snippet_HeadingFont"]"
                                             data-label-rounded-buttons-everywhere="@L["Snippet_RoundedButtonsEverywhere"]"
                                             data-label-brand-gradient-header="@L["Snippet_BrandGradientHeader"]"
                                             data-label-stronger-focus-ring="@L["Snippet_StrongerFocusRing"]"></div>
                                    </div>
                                    <div>
                                        <div class="text-xs uppercase opacity-60 mb-1">@L["CustomCss_SelectorsLabel"]</div>
                                        <p class="text-xs opacity-70 mb-1">@L["CustomCss_SelectorsHelp"]</p>
                                        <div class="flex flex-wrap gap-1">
                                            <code class="bg-base-200 px-1.5 py-0.5 rounded text-xs font-mono">[data-project-theme]</code>
                                            <code class="bg-base-200 px-1.5 py-0.5 rounded text-xs font-mono">.btn.btn-primary</code>
                                            <code class="bg-base-200 px-1.5 py-0.5 rounded text-xs font-mono">#ideas-list a</code>
                                            <code class="bg-base-200 px-1.5 py-0.5 rounded text-xs font-mono">.chat-bubble-left</code>
                                            <code class="bg-base-200 px-1.5 py-0.5 rounded text-xs font-mono">.accent-strip</code>
                                            <code class="bg-base-200 px-1.5 py-0.5 rounded text-xs font-mono">header</code>
                                        </div>
                                    </div>
                                    <details>
                                        <summary class="cursor-pointer text-sm opacity-70">@L["CustomCss_AvoidLabel"]</summary>
                                        <ul class="mt-1 ml-4 list-disc opacity-70 text-xs flex flex-col gap-0.5">
                                            <li>@L["CustomCss_Avoid_Overflow"]</li>
                                            <li>@L["CustomCss_Avoid_FixedPosition"]</li>
                                            <li>@L["CustomCss_Avoid_Important"]</li>
                                            <li>@L["CustomCss_Avoid_ExternalImports"]</li>
                                        </ul>
                                    </details>
                                    <div id="customcss-syntax-hint"
                                         class="text-xs opacity-70" aria-live="polite"
                                         data-unbalanced-label="@L["CustomCss_Unbalanced"].Value"
                                         data-balanced-label="@L["CustomCss_Balanced"]"></div>
                                </div>
                            </details>
                        </div>
                    </details>
                </div>
            </div>

            @* ── Card 3: Behavior & Settings ── *@
            <div class="card bg-base-100 shadow-sm">
                <div class="card-body gap-5">
                    <h2 class="font-heading font-semibold text-base text-base-content uppercase tracking-wide opacity-60 pb-1 border-b border-base-200">@L["SectionBehavior"]</h2>

                    <div class="grid grid-cols-2 gap-4">
                        <div class="form-control gap-1.5">
                            <div class="flex items-center gap-1.5">
                                <span class="text-sm font-semibold text-base-content">@L["InteractionModeLabel"]</span>
                                @InfoIcon(L["InteractionModeHint"].Value)
                            </div>
                            <select asp-for="InteractionMode" class="select select-bordered w-full">
                                <option value="VerticalScroll">@L["InteractionMode_Scroll"]</option>
                                <option value="Chat">@L["InteractionMode_Chat"]</option>
                            </select>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-4">
                        <div class="form-control gap-1.5">
                            <label class="text-sm font-semibold text-base-content" for="min-age-input">@L["MinAgeLabel"]</label>
                            <input asp-for="MinAge" type="number" id="min-age-input" min="0" max="120"
                                   class="input input-bordered w-full no-spinner" placeholder="@L["AgeOptional"]" />
                            <span asp-validation-for="MinAge" class="text-xs text-error"></span>
                        </div>
                        <div class="form-control gap-1.5">
                            <label class="text-sm font-semibold text-base-content" for="max-age-input">@L["MaxAgeLabel"]</label>
                            <input asp-for="MaxAge" type="number" id="max-age-input" min="0" max="120"
                                   class="input input-bordered w-full no-spinner" placeholder="@L["AgeOptional"]" />
                            <span asp-validation-for="MaxAge" class="text-xs text-error"></span>
                        </div>
                    </div>
                    <span id="age-range-error" class="hidden text-error text-xs -mt-3 block">@L["AgeRangeError"]</span>

                    <div class="form-control gap-1.5">
                        <div class="flex items-center gap-1.5">
                            <span class="text-sm font-semibold text-base-content">@L["SectionsDivider"]</span>
                            @InfoIcon(L["SectionsHint"].Value)
                        </div>
                        <div id="sections-container" class="grid grid-cols-2 gap-2" data-section-count="@(Model.Sections?.Count ?? 0)">
                            @for (int i = 0; i < (Model.Sections?.Count ?? 0); i++)
                            {
                                <div class="flex gap-1 items-center section-row">
                                    <input type="text" name="Sections[@i]" value="@Model.Sections![i]" maxlength="20"
                                           class="input input-bordered input-sm flex-1" placeholder="@L["SectionNamePlaceholder"]" />
                                    <button type="button" class="btn btn-ghost btn-sm text-error remove-section">&times;</button>
                                </div>
                            }
                        </div>
                        <button type="button" id="add-section" class="btn btn-ghost btn-sm gap-1 self-start">
                            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
                            @L["AddSectionButton"]
                        </button>
                    </div>
                </div>
            </div>

        </fieldset>

        @if (isLocked && Model.ProjectId.HasValue)
        {
            <div class="card bg-base-100 shadow-sm">
                <div class="card-body">
                    <h2 class="font-heading font-semibold text-base text-base-content uppercase tracking-wide opacity-60 pb-1 border-b border-base-200 mb-2">@L["ExportDivider"]</h2>
                    <button type="button" class="btn btn-outline btn-sm gap-1.5 self-start"
                            onclick="document.getElementById('rawdata-modal').showModal()">
                        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                            <path d="M12 3v12m0 0l-4-4m4 4l4-4M4 17v2a2 2 0 002 2h12a2 2 0 002-2v-2"/>
                        </svg>
                        @L["ExportRawDataButton"]
                    </button>
                </div>
            </div>

            <dialog id="rawdata-modal" class="modal"
                    data-export-url="@Url.Action("ExportRawData", new { projectId = Model.ProjectId })">
                <div class="modal-box">
                    <h3 class="font-bold text-lg mb-4">@L["RawDataModalTitle"]</h3>
                    <p class="text-sm text-base-content/60 mb-3">@L["RawDataIntro"]</p>
                    <div class="form-control gap-2 mb-4">
                        <label class="flex items-center gap-3 cursor-pointer">
                            <input type="checkbox" class="checkbox checkbox-sm" data-rawdata-table="vragen" checked />
                            <span class="text-sm">@L["RawData_Questions"]</span>
                        </label>
                        <label class="flex items-center gap-3 cursor-pointer">
                            <input type="checkbox" class="checkbox checkbox-sm" data-rawdata-table="antwoorden" checked />
                            <span class="text-sm">@L["RawData_Answers"]</span>
                        </label>
                        <label class="flex items-center gap-3 cursor-pointer">
                            <input type="checkbox" class="checkbox checkbox-sm" data-rawdata-table="categorieen" checked />
                            <span class="text-sm">@L["RawData_Categories"]</span>
                        </label>
                        <label class="flex items-center gap-3 cursor-pointer">
                            <input type="checkbox" class="checkbox checkbox-sm" data-rawdata-table="ideeen" checked />
                            <span class="text-sm">@L["RawData_Ideas"]</span>
                        </label>
                        <label class="flex items-center gap-3 cursor-pointer">
                            <input type="checkbox" class="checkbox checkbox-sm" data-rawdata-table="comments" checked />
                            <span class="text-sm">@L["RawData_Comments"]</span>
                        </label>
                        <label class="flex items-center gap-3 cursor-pointer">
                            <input type="checkbox" class="checkbox checkbox-sm" data-rawdata-table="emojireacties" checked />
                            <span class="text-sm">@L["RawData_EmojiReactions"]</span>
                        </label>
                    </div>
                    <div class="flex items-center gap-2 mb-4">
                        <span class="text-sm font-medium">@L["FormatLabel"]</span>
                        <select id="rawdata-format" class="select select-bordered select-sm w-40">
                            <option value="xlsx">Excel (.xlsx)</option>
                            <option value="csv">CSV (.zip)</option>
                        </select>
                    </div>
                    <div class="modal-action">
                        <form method="dialog">
                            <button class="btn btn-ghost btn-sm">@L["CancelButton"]</button>
                        </form>
                        <button type="button" class="btn btn-primary btn-sm" id="rawdata-download">@L["ExportButton"]</button>
                    </div>
                </div>
                <form method="dialog" class="modal-backdrop"><button>close</button></form>
            </dialog>
        }

        <div class="flex justify-end gap-2 pb-4">
            @if (!isLocked)
            {
                <a asp-action="Index" class="btn btn-ghost">@L["CancelButton"]</a>
                <button type="submit" form="project-form" name="submitAction" value="save" class="btn btn-outline">@Shared["Common_Save"]</button>
                <button type="submit" form="project-form" name="submitAction" value="next" class="btn btn-primary">@L["NextButton"] &rarr;</button>
            }
            else
            {
                <a asp-action="Index" class="btn btn-ghost">@Shared["Common_Back"]</a>
                @if (Model.ProjectId.HasValue)
                {
                    <a asp-action="Questions" asp-route-projectId="@Model.ProjectId" class="btn btn-primary">@L["NextButton"] &rarr;</a>
                }
            }
        </div>
    </form>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}