@model IEnumerable<SynapseEnqueteManagement.UI.Admin.Models.Project.ProjectAdminViewModel>
@inject IViewLocalizer L
@inject IHtmlLocalizer<SharedResource> Shared
@{
    ViewData["Title"] = L["PageTitle"].Value;
    Layout = "_Layout";
    string StateKey(string s) => s switch { "Active" => "State_Active", "Archived" => "State_Archived", "Draft" => "State_Draft", _ => "" };
    string StateBadge(string s) => s switch { "Active" => "badge-success", "Archived" => "badge-ghost", _ => "badge-warning" };
}

<div class="w-full">
    <div class="flex items-center justify-between mb-6">
        <h1 class="font-heading font-bold text-2xl text-base-content">@L["Heading"]</h1>
        <a asp-action="Create" class="btn btn-primary btn-sm gap-1.5">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
            @L["NewButton"]
        </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        @foreach (var project in Model)
        {
            string href;
            if (project.ProjectState == "Draft")
            {
                href = project.LastWizardStep switch
                {
                    2 => Url.Action("Questions", new { projectId = project.ProjectId, isNew = true }),
                    3 => Url.Action("Ideation", new { projectId = project.ProjectId, isNew = true }),
                    _ => Url.Action("Create", new { projectId = project.ProjectId, isNew = true })
                };
            }
            else
            {
                href = Url.Action("Dashboard", new { projectId = project.ProjectId });
            }

            <div class="card relative bg-base-100 shadow-sm transition-all duration-200 ease-out group
                        hover:-translate-y-0.5 hover:scale-[1.015]
                        hover:shadow-xl hover:shadow-black/25 dark:hover:shadow-white/15">
                <figure class="aspect-video bg-base-200 relative overflow-hidden">
                    @if (!string.IsNullOrEmpty(project.ProjectImage))
                    {
                        <img src="@project.ProjectImage" alt="@project.Name"
                             class="w-full h-full object-cover group-hover:scale-105 transition duration-300"
                             loading="lazy" decoding="async" />
                        @if (project.IsAiGeneratedImage)
                        {
                            <span class="absolute bottom-2 left-2 bg-base-100/80 backdrop-blur-sm text-base-content/60 text-[10px] font-semibold px-2 py-0.5 rounded-full border border-base-300">
                                AI
                            </span>
                        }
                    }
                    else
                    {
                        <div class="w-full h-full flex items-center justify-center bg-primary/5">
                            <svg class="text-primary/20" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/></svg>
                        </div>
                    }
                    @{ var stateKey = StateKey(project.ProjectState); }
                    <span class="badge @StateBadge(project.ProjectState) badge-sm absolute top-2 left-2">@(string.IsNullOrEmpty(stateKey) ? project.ProjectState : Shared[stateKey].Value)</span>
                </figure>
                <div class="card-body p-4 gap-1">
                    <div class="flex items-start gap-2">
                        <div class="min-w-0 flex-1">
                            <h2 class="card-title text-sm font-semibold truncate">
                                <a href="@href" class="before:absolute before:inset-0 before:content-[''] before:rounded-[inherit] focus:outline-none focus-visible:before:ring-2 focus-visible:before:ring-primary">
                                    @project.Name
                                </a>
                            </h2>
                            <p class="text-xs text-base-content/50 truncate">@project.OrganisationName</p>
                        </div>

                        <div class="relative z-10 flex-shrink-0 self-center">
                            <button type="button"
                                    class="project-menu-btn btn btn-ghost btn-sm btn-square text-base-content/60 hover:text-base-content"
                                    data-project-id="@project.ProjectId"
                                    aria-haspopup="menu"
                                    aria-label="@L["MoreActions"]">
                                <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                    <circle cx="12" cy="5" r="1.75"/>
                                    <circle cx="12" cy="12" r="1.75"/>
                                    <circle cx="12" cy="19" r="1.75"/>
                                </svg>
                            </button>

                            <div class="project-menu hidden absolute right-0 top-full mt-1 min-w-48 py-1
                                        bg-base-100 border border-base-300 rounded-xl shadow-lg z-20"
                                 data-project-id="@project.ProjectId"
                                 role="menu">
                                <button type="button"
                                        class="w-full text-left px-3 py-2 text-xs hover:bg-base-200 flex items-center gap-2 cursor-pointer"
                                        role="menuitem"
                                        data-open-modal="copy-modal-@project.ProjectId">
                                    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                                        <rect x="9" y="9" width="13" height="13" rx="2"/>
                                        <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/>
                                    </svg>
                                    @L["CopyAsTemplate"]
                                </button>
                                @if (project.ProjectState == "Active")
                                {
                                    <a asp-action="Archive" asp-route-projectId="@project.ProjectId"
                                       class="w-full text-left px-3 py-2 text-xs hover:bg-base-200 flex items-center gap-2"
                                       role="menuitem">
                                        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                                            <path d="M21 8v13H3V8M1 3h22v5H1zM10 12h4"/>
                                        </svg>
                                        @L["ArchiveButton"]
                                    </a>
                                }
                                else
                                {
                                    <button type="button"
                                            class="delete-project-btn w-full text-left px-3 py-2 text-xs text-error hover:bg-error/10 flex items-center gap-2 cursor-pointer"
                                            role="menuitem"
                                            data-project-id="@project.ProjectId"
                                            data-project-name="@project.Name">
                                        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                                            <path d="M3 6h18M8 6V4a2 2 0 012-2h4a2 2 0 012 2v2m3 0v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6"/>
                                        </svg>
                                        @L["DeleteButton"]
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <dialog id="copy-modal-@project.ProjectId" class="modal">
                <div class="modal-box">
                    <h3 class="font-bold text-lg">@L["CopyModalTitle"]</h3>
                    <p class="py-2 text-sm">@Html.Raw(string.Format(L["CopyModalBody"].Value, $"<strong>{project.Name}</strong>"))</p>
                    <form asp-action="CopyProject" method="post">
                        <input type="hidden" name="projectId" value="@project.ProjectId" />
                        <label class="form-control w-full">
                            <span class="label-text">@L["CopyModalNewNameLabel"]</span>
                            <input type="text" name="newName" required maxlength="100"
                                   value="@(project.Name) @L["CopySuffix"].Value"
                                   class="input input-bordered w-full mt-1" />
                        </label>
                        <div class="modal-action">
                            <button type="button" class="btn btn-ghost"
                                    data-close-modal="copy-modal-@project.ProjectId">
                                @L["CancelButton"]
                            </button>
                            <button type="submit" class="btn btn-primary">@L["CopyButton"]</button>
                        </div>
                    </form>
                </div>
                <form method="dialog" class="modal-backdrop"><button>close</button></form>
            </dialog>
        }

        @* "Add new" tile — secondary entry point alongside the top-right primary button. *@
        <a asp-action="Create"
           class="group relative flex flex-col items-center justify-center gap-3 min-h-[280px] rounded-2xl
                  border-2 border-dashed border-base-300 bg-base-100/40
                  text-base-content/50 hover:text-primary hover:border-primary hover:bg-primary/5
                  transition-all duration-200 ease-out">
            <span class="w-12 h-12 rounded-full bg-base-200 group-hover:bg-primary/10 flex items-center justify-center transition-colors">
                <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
            </span>
            <span class="text-sm font-semibold">@L["NewButton"]</span>
        </a>
    </div>
</div>

@* Delete confirmation modal *@
<div id="delete-modal" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50">
    <div class="bg-base-100 border border-base-300 p-6 rounded-xl max-w-sm w-full shadow-xl">
        <p class="text-sm font-semibold text-base-content mb-2">@L["DeleteModalTitle"]</p>
        <p class="text-xs text-base-content/70 mb-5">
            @Html.Raw(string.Format(L["DeleteModalBody"].Value, "<strong id=\"delete-project-name\"></strong>"))
        </p>
        <div class="flex justify-end gap-3">
            <button type="button" id="delete-cancel"
                    class="btn btn-ghost btn-sm">@L["CancelButton"]</button>
            <form id="delete-form" asp-controller="Project" asp-action="DeleteProject" method="post">
                <input type="hidden" name="projectId" id="delete-project-id" />
                <button type="submit" class="btn btn-error btn-sm">@L["DeleteButton"]</button>
            </form>
        </div>
    </div>
</div>
