@model IEnumerable<SynapseEnqueteManagement.UI.Admin.Models.Project.ProjectAdminViewModel>
@{
    ViewData["Title"] = "Projecten";
    Layout = "_Layout";
    string StateLabel(string s) => s switch { "Active" => "Actief", "Archived" => "Gearchiveerd", "Draft" => "Concept", _ => s };
    string StateBadge(string s) => s switch { "Active" => "badge-success", "Archived" => "badge-ghost", _ => "badge-warning" };
}

<div class="max-w-6xl mx-auto">
    <div class="flex items-center justify-between mb-6">
        <h1 class="font-heading font-bold text-2xl text-base-content">Projecten</h1>
        <a asp-action="Create" class="btn btn-primary btn-sm gap-1.5">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
            Nieuw project
        </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        @foreach (var project in Model)
        {
            var href = project.ProjectState == "Draft"
                ? Url.Action("Create", new { projectId = project.ProjectId })
                : Url.Action("Dashboard", new { projectId = project.ProjectId });

            <div class="card bg-base-100 shadow-sm hover:shadow-md transition group overflow-hidden">
                <figure class="aspect-video bg-base-200 relative overflow-hidden">
                    @if (!string.IsNullOrEmpty(project.ProjectImage))
                    {
                        <img src="@project.ProjectImage" alt="@project.Name"
                             class="w-full h-full object-cover group-hover:scale-105 transition duration-300"
                             loading="lazy" decoding="async" />
                    }
                    else
                    {
                        <div class="w-full h-full flex items-center justify-center bg-primary/5">
                            <svg class="text-primary/20" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/></svg>
                        </div>
                    }
                    <span class="badge @StateBadge(project.ProjectState) badge-sm absolute top-2 right-2">@StateLabel(project.ProjectState)</span>
                </figure>
                <div class="card-body p-4 gap-1">
                    <h2 class="card-title text-sm font-semibold">@project.Name</h2>
                    <p class="text-xs text-base-content/50">@project.OrganisationName</p>
                    <div class="card-actions justify-between items-center mt-2">
                        <a href="@href" class="btn btn-primary btn-xs">Openen</a>
                        <form asp-action="DeleteProject" method="post" class="inline"
                              onsubmit="return confirm('Project verwijderen?')">
                            <input type="hidden" name="projectId" value="@project.ProjectId" />
                            <button type="submit" class="btn btn-ghost btn-xs text-error">Verwijderen</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@* Delete confirmation modal *@
<div id="delete-modal" class="hidden fixed inset-0 bg-black/70 flex items-center justify-center z-50">
    <div class="bg-gray-900 border border-gray-600 p-6 rounded max-w-sm w-full text-white">
        <p class="text-sm font-semibold mb-2">Project verwijderen</p>
        <p class="text-xs text-gray-300 mb-5">
            Weet je zeker dat je <strong id="delete-project-name"></strong> wilt verwijderen?
            Dit kan niet ongedaan worden gemaakt.
        </p>
        <div class="flex justify-end gap-3">
            <button type="button" id="delete-cancel"
                    class="border border-gray-500 px-4 py-2 text-xs hover:bg-gray-800">Annuleren</button>
            <form id="delete-form" asp-controller="Project" asp-action="DeleteProject" method="post">
                <input type="hidden" name="projectId" id="delete-project-id" />
                <button type="submit"
                        class="border border-red-500 text-red-400 px-4 py-2 text-xs hover:bg-red-500/20">Verwijderen</button>
            </form>
        </div>
    </div>
</div>
