@using SynapseEnqueteManagement.UI.Admin.Models.Question
@using SynapseEnqueteManagement.UI.Admin.Models.Enums
@using SynapseEnqueteManagement.UI.Admin.Models.Project
@using SynapseEnqueteManagement.UI.Admin.Models.Section
@using System.Text.Json
@model List<QuestionViewModel>
@inject IViewLocalizer L
@{
    ViewData["Title"] = L["PageTitle"].Value;
    Layout = "_Layout";
    int projectId = (int)ViewData["ProjectId"];
    string aiAssistance = ViewData["AiAssistance"]?.ToString() ?? "ProActive";
    var sections = ViewData["Sections"] as List<SectionViewModel> ?? new List<SectionViewModel>();
    var projectState = ViewData["ProjectState"]?.ToString() ?? "";
    var isLocked = projectState is "Active" or "Archived";
    bool isNew = ViewData["IsNew"] is true;
}
<div class="w-full grid grid-cols-1 lg:grid-cols-3 gap-6 items-start -mt-6 -mr-6">
<div class="lg:col-span-2 flex flex-col gap-4 pt-6">
    <div class="mb-2">
        <h1 class="font-heading font-bold text-2xl text-base-content">@L["Heading"]</h1>
        <p class="text-base-content/50 text-sm mt-1">@L["Subtitle"]</p>
    </div>
    @if (isLocked)
    {
        <div class="alert alert-warning mb-4">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" class="flex-shrink-0"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            <span>@(projectState == "Active" ? L["LockedActive"] : L["LockedArchived"])</span>
        </div>
    }

    <div id="questions-list"
         class="flex flex-col gap-1 mb-4"
         data-project-id="@projectId"
         data-questions-endpoint="/api/admin/projects/@projectId/questions"
         data-delete-endpoint="@Url.Action("Delete", "Question")"
         data-ai-assistance="@aiAssistance"
         data-locked="@(isLocked ? "true" : "false")">
        <p class="text-base-content/40 italic text-sm py-2">@L["LoadingQuestions"]</p>
    </div>

    <div class="flex justify-between">
        <a asp-action="Create" asp-route-projectId="@projectId" asp-route-isNew="@isNew" class="btn btn-ghost btn-sm">← @L["SettingsLink"]</a>
        @if (!isLocked)
        {
            <button type="button" id="questions-next-btn"
                    class="btn btn-primary btn-sm"
                    data-question-count="@Model.Count"
                    data-href="@Url.Action("Ideation", new { projectId, isNew })">@L["NextLink"] →</button>
        }
        else
        {
            <a asp-action="Ideation" asp-route-projectId="@projectId" asp-route-isNew="@isNew" class="btn btn-primary btn-sm">@L["NextLink"] →</a>
        }
    </div>
    <p id="questions-next-error" class="hidden text-error text-xs mt-2 text-right">@L["AddOneQuestionError"]</p>
</div>

<div id="qs-chat-panel" class="flex flex-col gap-3 sticky top-14 h-[calc(100vh-3.5rem)] self-start">
    <div class="card bg-base-100 shadow-sm overflow-hidden flex-1 flex flex-col rounded-none border-l border-base-300">
        <div class="flex items-center gap-3 px-4 py-3 border-b border-base-300">
            <div class="w-9 h-9 rounded-xl bg-primary flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-primary-content" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
                </svg>
            </div>
            <div class="flex-1 min-w-0">
                <p class="font-semibold text-sm text-base-content">@L["AiSupportHeading"]</p>
                <p class="text-xs text-base-content/50">@L["AiSupportSubtitle"]</p>
            </div>
            <select id="qs-mode-select"
                    class="select select-bordered select-xs w-auto flex-shrink-0"
                    data-prev="@aiAssistance">
                <option value="ProActive"  selected="@(aiAssistance == "ProActive"  ? "selected" : null)">@L["AiMode_ProActive"]</option>
                <option value="AskFirst"   selected="@(aiAssistance == "AskFirst"   ? "selected" : null)">@L["AiMode_AskFirst"]</option>
                <option value="Never"      selected="@(aiAssistance == "Never"      ? "selected" : null)">@L["AiMode_Never"]</option>
            </select>
        </div>

        <div class="card-body gap-4 pt-4 flex-1 min-h-0">
            <div id="qs-messages"
                 class="flex flex-col gap-3 overflow-y-auto flex-1 min-h-0">
            </div>

            <div id="qs-input-area" class="flex flex-col gap-2 @(aiAssistance == "Never" ? "hidden" : "")">
                <textarea id="qs-input"
                          rows="2"
                          class="textarea textarea-bordered textarea-sm w-full resize-none"
                          placeholder="@L["AiInputPlaceholder"]"></textarea>
                <button id="qs-btn-send" type="button"
                        class="btn btn-primary btn-sm self-end">
                    @L["SendButton"]
                </button>
            </div>
        </div>
    </div>
</div>
</div>

@* Type picker modal (V3): user picks type tile, then drawer opens *@
<div id="type-picker" class="modal !items-center !justify-center">
    <div class="modal-box w-[720px] max-w-[92vw] rounded-2xl p-7">
        <div class="flex items-center justify-between mb-1">
            <h2 class="font-heading font-bold text-xl text-base-content tracking-tight">@L["PickerHeading"]</h2>
            <button type="button" id="type-picker-close" class="btn btn-ghost btn-sm btn-circle">×</button>
        </div>
        <p class="text-base-content/50 text-sm mb-5">@L["PickerSubtitle"]</p>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-2.5">
            <button type="button" class="picker-tile group flex flex-col items-start gap-2 p-4 rounded-xl border-[1.5px] border-base-300 hover:border-primary hover:bg-primary/5 text-left transition-colors" data-type="MultipleChoice">
                <div class="w-9 h-9 rounded-lg bg-primary/15 text-primary flex items-center justify-center">
                    <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M5 8h14M5 16h10"/></svg>
                </div>
                <div class="text-sm font-bold text-base-content">@L["Type_MultipleChoice"]</div>
                <div class="text-xs text-base-content/50 leading-snug">@L["Picker_MCQDesc"]</div>
            </button>
            <button type="button" class="picker-tile group flex flex-col items-start gap-2 p-4 rounded-xl border-[1.5px] border-base-300 hover:border-secondary hover:bg-secondary/5 text-left transition-colors" data-type="SingleChoice">
                <div class="w-9 h-9 rounded-lg bg-secondary/15 text-secondary flex items-center justify-center">
                    <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M3 12a9 9 0 1018 0 9 9 0 00-18 0z"/></svg>
                </div>
                <div class="text-sm font-bold text-base-content">@L["Type_SingleChoice"]</div>
                <div class="text-xs text-base-content/50 leading-snug">@L["Picker_SCQDesc"]</div>
            </button>
            <button type="button" class="picker-tile group flex flex-col items-start gap-2 p-4 rounded-xl border-[1.5px] border-base-300 hover:border-info hover:bg-info/5 text-left transition-colors" data-type="Open">
                <div class="w-9 h-9 rounded-lg bg-info/15 text-info flex items-center justify-center">
                    <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 10h16M4 14h10"/></svg>
                </div>
                <div class="text-sm font-bold text-base-content">@L["Type_Open"]</div>
                <div class="text-xs text-base-content/50 leading-snug">@L["Picker_OpenDesc"]</div>
            </button>
            <button type="button" class="picker-tile group flex flex-col items-start gap-2 p-4 rounded-xl border-[1.5px] border-base-300 hover:border-warning hover:bg-warning/5 text-left transition-colors" data-type="Likert">
                <div class="w-9 h-9 rounded-lg bg-warning/15 text-warning flex items-center justify-center">
                    <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7 20V10M12 20V4M17 20V14"/></svg>
                </div>
                <div class="text-sm font-bold text-base-content">@L["Type_Likert"]</div>
                <div class="text-xs text-base-content/50 leading-snug">@L["Picker_LikertDesc"]</div>
            </button>
        </div>
    </div>
    <form method="dialog" class="modal-backdrop"><button id="type-picker-backdrop">close</button></form>
</div>

@* Right-side slide-in drawer for editing/creating a question — controlled by project-questions.ts *@
<div id="modal" class="modal !items-center !justify-center">
    <div class="modal-box w-[520px] max-w-[92vw] max-h-[90vh] rounded-2xl overflow-y-auto p-7 flex flex-col gap-4">
        <div class="flex items-center justify-between">
            <div class="flex items-center gap-3 min-w-0">
                <div id="drawer-type-icon" class="w-10 h-10 rounded-xl bg-primary/15 text-primary flex items-center justify-center flex-shrink-0">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M5 8h14M5 16h10"/></svg>
                </div>
                <div class="min-w-0">
                    <div id="modal-title" class="text-[11px] uppercase font-bold tracking-wide text-base-content/50">@L["ModalTitleCreate"]</div>
                    <div id="drawer-type-label" class="font-heading font-bold text-base text-base-content truncate">@L["Type_MultipleChoice"]</div>
                </div>
            </div>
            <button type="button" id="modal-close" class="btn btn-ghost btn-sm btn-circle">×</button>
        </div>

        @Html.AntiForgeryToken()
        <form id="question-form"
              asp-controller="Project" asp-action="CreateQuestion"
              data-update-url="@Url.Action("UpdateQuestion", "Project")"
              data-questions-endpoint="@($"/api/admin/projects/{projectId}/questions")"
              data-delete-endpoint="@Url.Action("Delete", "Question")"
              data-project-id="@projectId"
              data-ai-assistance="@aiAssistance"
              method="post">
            <input type="hidden" name="projectId" value="@projectId" />
            <input type="hidden" name="aiAssistance" value="@aiAssistance" />
            <input type="hidden" name="isNew" value="@isNew.ToString().ToLower()" />
            <input type="hidden" name="questionId" id="QuestionId" value="" />
            <input type="hidden" name="QuestionFormat" id="QuestionFormat" value="MultipleChoice" />
            <input type="hidden" name="AnswerChoicesRaw" id="AnswerChoicesRaw" />

            <label class="form-control mb-3">
                <div class="label"><span class="label-text text-xs">@L["QuestionTextLabel"]</span></div>
                <textarea name="Text" id="QuestionText" rows="3"
                          class="textarea textarea-bordered textarea-sm w-full resize-none"
                          placeholder="@L["ModalQuestionPlaceholder"]"></textarea>
                <span id="text-error" class="hidden text-error text-xs mt-1">@L["FieldRequiredError"]</span>
            </label>

            @* Legacy type buttons — hidden, picker drives type selection; project-questions.ts still uses these to set QuestionFormat *@
            <div class="hidden">
                <button type="button" class="type-btn" data-type="MultipleChoice"></button>
                <button type="button" class="type-btn" data-type="SingleChoice"></button>
                <button type="button" class="type-btn" data-type="Open"></button>
                <button type="button" class="type-btn" data-type="Likert"></button>
                <span class="type-selected-label"></span>
                <span class="type-selected-label hidden"></span>
                <span class="type-selected-label hidden"></span>
                <span class="type-selected-label hidden"></span>
            </div>

            <div id="answers-section" class="mb-4">
                <label class="label"><span class="label-text text-xs">@L["AnswersLabel"]</span></label>
                <div id="answer-list" class="space-y-2 mb-2"></div>
                <span id="answers-error" class="hidden text-error text-xs mb-2 block"></span>
                <button type="button" id="add-answer-btn" class="btn btn-ghost btn-xs">+ @L["AddAnswerButton"]</button>
            </div>

            @if (sections.Any())
            {
                <label class="form-control mb-4">
                    <div class="label"><span class="label-text text-xs">@L["SectionOptionalLabel"]</span></div>
                    <select name="SectionId" id="SectionId" class="select select-bordered select-sm w-full">
                        <option value="">@L["NoSectionOption"]</option>
                        @foreach (var sec in sections)
                        {
                            <option value="@sec.SectionId">@sec.Name</option>
                        }
                    </select>
                </label>
            }

            <label class="flex items-center justify-between gap-3 px-4 py-3 bg-base-200/60 rounded-xl cursor-pointer mb-2">
                <div>
                    <div class="text-sm font-semibold text-base-content">@L["MandatoryLabel"]</div>
                    <div class="text-xs text-base-content/50">@L["MandatoryHelper"]</div>
                </div>
                <input type="checkbox" id="IsMandatory-cb" name="IsMandatory" value="true" class="toggle toggle-primary toggle-sm" checked />
            </label>

            <div class="divider my-1"></div>

            <details id="media-section" class="mb-2">
                <summary class="font-semibold text-sm cursor-pointer">@L["MediaSummary"]</summary>
                <div class="flex flex-col gap-3 mt-3">
                    <label class="form-control">
                        <div class="label"><span class="label-text text-xs">@L["MediaTypeLabel"]</span></div>
                        <select id="MediaType" name="MediaType" class="select select-bordered select-sm w-full">
                            <option value="">@L["NoMediaOption"]</option>
                            <option value="1">@L["Media_Image"]</option>
                            <option value="2">@L["Media_Video"]</option>
                            <option value="3">@L["Media_Audio"]</option>
                        </select>
                    </label>

                    <div id="media-source-toggle" class="hidden">
                        <label class="label cursor-pointer justify-start gap-3">
                            <input type="checkbox" id="MediaIsEmbed" name="MediaIsEmbed" value="true" class="checkbox checkbox-sm" />
                            <span class="label-text text-sm">@L["MediaEmbedToggle"]</span>
                        </label>
                    </div>

                    <div id="media-upload-block" class="hidden flex-col gap-2">
                        <input type="file" id="MediaFile" class="file-input file-input-bordered file-input-sm w-full" />
                        <progress id="media-upload-progress" class="progress progress-primary w-full hidden" max="100"></progress>
                        <span id="media-upload-error" class="hidden text-error text-xs"></span>
                        <div id="media-preview" class="mt-2"></div>
                    </div>

                    <label class="form-control hidden" id="media-embed-block">
                        <div class="label"><span class="label-text text-xs" id="media-embed-label">URL</span></div>
                        <input type="url" id="MediaEmbedUrl" class="input input-bordered input-sm w-full"
                               placeholder="https://..." />
                        <span id="media-embed-error" class="hidden text-error text-xs mt-1"></span>
                    </label>

                    <input type="hidden" name="MediaUrl" id="MediaUrl" value="" />

                    <label class="form-control">
                        <div class="label">
                            <span class="label-text text-xs">@L["MediaTextMarkdownLabel"]</span>
                            <span id="media-text-counter" class="label-text-alt text-xs">0 / 2000</span>
                        </div>
                        <textarea id="MediaText" name="MediaText" rows="4" maxlength="2000"
                                  class="textarea textarea-bordered textarea-sm w-full resize-none"
                                  placeholder="@L["MediaTextPlaceholder"]"></textarea>
                    </label>
                </div>
            </details>

            <div class="flex-1"></div>

            <div class="flex justify-end gap-2 pt-3 border-t border-base-200 mt-2">
                <button type="button" id="modal-cancel" class="btn btn-ghost btn-sm">@L["CancelButton"]</button>
                <button type="submit" class="btn btn-primary btn-sm gap-1">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                    @L["AddButton"]
                </button>
            </div>
        </form>
    </div>
    <form method="dialog" class="modal-backdrop">
        <button id="modal-backdrop-close">close</button>
    </form>
</div>

@section Scripts {
    <script id="qs-i18n" type="application/json">
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
            addQuestion       = L["AddQuestionHeading"].Value,
            emptyNoQuestions  = L["EmptyNoQuestions"].Value,
            emptySectionAdd   = L["EmptySectionAdd"].Value,
            addInSection      = L["AddInSection"].Value,
            followupsSingular = L["FollowupsSingular"].Value,
            followupsPlural   = L["FollowupsPlural"].Value,
            subDropZone       = L["SubDropZone"].Value,
            promoteDropZone   = L["PromoteDropZone"].Value,
            endsSurveyLabel   = L["EndsSurveyLabel"].Value,
            endsSurveyToggle  = L["EndsSurveyToggle"].Value,
            dragTitle         = L["DragTitle"].Value,
            questionSingular  = L["QuestionSingular"].Value,
            questionPlural    = L["QuestionPlural"].Value,
            mandatory         = L["MandatoryLabel"].Value,
            formatOpen        = L["Type_Open"].Value,
            formatMCQ         = L["Type_MultipleChoice"].Value,
            formatSCQ         = L["Type_SingleChoice"].Value,
            formatLikert      = L["Type_Likert"].Value,
            mediaImage        = L["MediaShort_Image"].Value,
            mediaVideo        = L["MediaShort_Video"].Value,
            mediaAudio        = L["MediaShort_Audio"].Value,
            mediaGeneric      = L["MediaShort_Generic"].Value,
            modalTitleCreate  = L["ModalTitleCreate"].Value,
            modalTitleEdit    = L["ModalTitleEdit"].Value,
            answerPlaceholder = L["AnswerPlaceholder"].Value,
            savedToast        = L["SavedToast"].Value,
            saveFailedToast   = L["SaveFailedToast"].Value,
            fieldRequired     = L["FieldRequiredError"].Value,
            maxQuestionText   = L["MaxQuestionTextError"].Value,
            minTwoAnswers     = L["MinTwoAnswersError"].Value,
            allAnswersFilled  = L["AllAnswersRequired"].Value,
            addOneQuestion    = L["AddOneQuestionError"].Value
        }))
    </script>
    <script type="module" vite-src="~/project-questions.ts"></script>
    <script type="module" vite-src="~/questionsupportchat.ts"></script>
}
