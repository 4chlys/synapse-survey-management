@using SynapseEnqueteManagement.UI.Admin.Models.Question
@using SynapseEnqueteManagement.UI.Admin.Models.Enums
@using SynapseEnqueteManagement.UI.Admin.Models.Project
@using SynapseEnqueteManagement.UI.Admin.Models.Section
@using System.Text.Json
@model List<QuestionViewModel>
@{
    ViewData["Title"] = "Vragen";
    Layout = "_Layout";
    int projectId = (int)ViewData["ProjectId"];
    string aiAssistance = ViewData["AiAssistance"]?.ToString() ?? "ProActive";
    var sections = ViewData["Sections"] as List<SectionViewModel> ?? new List<SectionViewModel>();
}
<div class="max-w-3xl">
    <h1 class="font-heading font-bold text-2xl text-base-content mb-6">Vragen</h1>

    <div id="questions-list" class="card bg-base-100 shadow-sm mb-6">
        <div class="card-body p-0 overflow-x-auto">
            <table class="table table-sm">
                <thead><tr><th>#</th><th>Tekst</th><th>Type</th><th>Verplicht</th><th class="w-16"></th></tr></thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="5" class="text-center text-base-content/40 py-6 italic">Nog geen vragen.</td></tr>
                    }
                    @{ int qIdx = 1; }
                    @foreach (var q in Model)
                    {
                        <tr class="hover">
                            <td class="text-base-content/40 text-xs">@(qIdx++)</td>
                            <td class="max-w-xs truncate">@q.Text</td>
                            <td><span class="badge badge-ghost badge-sm">@q.QuestionFormat</span></td>
                            <td>@(q.IsMandatory ? "✓" : "–")</td>
                            <td>
                                <button type="button"
                                        class="btn btn-ghost btn-xs question-edit-btn"
                                        data-question-id="@q.QuestionId"
                                        data-text="@q.Text"
                                        data-format="@q.QuestionFormat"
                                        data-answers="@JsonSerializer.Serialize(q.AnswerChoices)"
                                        data-section-id="@(q.SectionId?.ToString() ?? "")">Bewerk</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card bg-base-100 shadow-sm mb-6">
        <div class="card-body gap-4">
            <h2 class="font-semibold">Vraag toevoegen</h2>
            <form asp-action="CreateQuestion" method="post" class="flex flex-col gap-3">
                <input type="hidden" name="projectId" value="@projectId" />
                <input type="hidden" name="aiAssistance" value="@aiAssistance" />
                <label class="form-control">
                    <div class="label"><span class="label-text text-xs">Vraagtekst *</span></div>
                    <input type="text" name="Text" class="input input-bordered input-sm w-full" required placeholder="Stel hier je vraag…" />
                </label>
                <div class="grid grid-cols-2 gap-3">
                    <label class="form-control">
                        <div class="label"><span class="label-text text-xs">Type</span></div>
                        <select name="QuestionFormat" class="select select-bordered select-sm w-full">
                            <option value="OpenQuestion">Open vraag</option>
                            <option value="MultipleChoice">Meerkeuze</option>
                            <option value="Range">Schaal</option>
                        </select>
                    </label>
                    <label class="form-control">
                        <div class="label"><span class="label-text text-xs">Sectie</span></div>
                        <select name="SectionId" class="select select-bordered select-sm w-full">
                            <option value="">— geen sectie —</option>
                            @foreach (var sec in sections)
                            {
                                <option value="@sec.SectionId">@sec.Name</option>
                            }
                        </select>
                    </label>
                </div>
                <label class="label cursor-pointer justify-start gap-3">
                    <input type="checkbox" name="IsMandatory" value="true" class="checkbox checkbox-primary checkbox-sm" />
                    <span class="label-text text-sm">Verplicht</span>
                </label>
                <button type="submit" class="btn btn-primary btn-sm self-end">Toevoegen</button>
            </form>
        </div>
    </div>

    <div class="flex justify-between">
        <a asp-action="Create" asp-route-projectId="@projectId" class="btn btn-ghost btn-sm">← Instellingen</a>
        <button type="button" id="questions-next-btn"
                class="btn btn-primary btn-sm"
                data-question-count="@Model.Count"
                data-href="@Url.Action("Ideation", new { projectId })">Volgende →</button>
    </div>
    <p id="questions-next-error" class="hidden text-error text-xs mt-2 text-right">Voeg minstens één vraag toe.</p>
</div>

@* Modal for editing a question — controlled by project-questions.ts via #questions-list event delegation *@
<div id="modal" class="modal hidden">
    <div class="modal-box w-[480px] max-w-xl">
        <div class="flex justify-between items-center mb-4">
            <span id="modal-title" class="font-bold text-base">Vraag aanmaken</span>
            <button type="button" id="modal-close" class="btn btn-ghost btn-sm btn-circle">×</button>
        </div>

        @Html.AntiForgeryToken()
        <form id="question-form"
              asp-controller="Project" asp-action="CreateQuestion"
              data-update-url="@Url.Action("UpdateQuestion", "Project")"
              data-questions-endpoint="@($"/api/admin/projects/{projectId}/questions")"
              data-delete-endpoint="@Url.Action("Delete", "Question")"
              data-project-id="@projectId"
              data-ai-assistance="@aiAssistance"
              method="post">
            <input type="hidden" name="projectId" value="@projectId" />
            <input type="hidden" name="aiAssistance" value="@aiAssistance" />
            <input type="hidden" name="questionId" id="QuestionId" value="" />
            <input type="hidden" name="QuestionFormat" id="QuestionFormat" value="MultipleChoice" />
            <input type="hidden" name="IsMandatory" value="false" />
            <input type="hidden" name="AnswerChoicesRaw" id="AnswerChoicesRaw" />

            <label class="form-control mb-3">
                <div class="label"><span class="label-text text-xs">Vraagtekst</span></div>
                <textarea name="Text" id="QuestionText" rows="3"
                          class="textarea textarea-bordered textarea-sm w-full resize-none"
                          placeholder="Vul je vraag in..."></textarea>
                <span id="text-error" class="hidden text-error text-xs mt-1">Dit veld moet ingevuld zijn.</span>
            </label>

            <label class="form-control mb-4">
                <div class="label"><span class="label-text text-xs">Vraagtype</span></div>
                <div class="flex gap-2">
                    <div class="flex flex-col items-center gap-1">
                        <button type="button" class="type-btn btn btn-sm btn-primary" data-type="MultipleChoice">MCQ</button>
                        <span class="type-selected-label text-base-content/40 italic text-xs">(geselecteerd)</span>
                    </div>
                    <div class="flex flex-col items-center gap-1">
                        <button type="button" class="type-btn btn btn-sm btn-ghost" data-type="SingleChoice">SCQ</button>
                        <span class="type-selected-label text-base-content/40 italic text-xs hidden">(geselecteerd)</span>
                    </div>
                    <div class="flex flex-col items-center gap-1">
                        <button type="button" class="type-btn btn btn-sm btn-ghost" data-type="Open">Open</button>
                        <span class="type-selected-label text-base-content/40 italic text-xs hidden">(geselecteerd)</span>
                    </div>
                    <div class="flex flex-col items-center gap-1">
                        <button type="button" class="type-btn btn btn-sm btn-ghost" data-type="Likert">Likert</button>
                        <span class="type-selected-label text-base-content/40 italic text-xs hidden">(geselecteerd)</span>
                    </div>
                </div>
            </label>

            <div id="answers-section" class="mb-4">
                <label class="label"><span class="label-text text-xs">Antwoorden</span></label>
                <div id="answer-list" class="space-y-2 mb-2"></div>
                <span id="answers-error" class="hidden text-error text-xs mb-2 block"></span>
                <button type="button" id="add-answer-btn" class="btn btn-ghost btn-xs">+ Antwoord toevoegen</button>
            </div>

            @if (sections.Any())
            {
                <label class="form-control mb-4">
                    <div class="label"><span class="label-text text-xs">Sectie (optioneel)</span></div>
                    <select name="SectionId" id="SectionId" class="select select-bordered select-sm w-full">
                        <option value="">— Geen sectie —</option>
                        @foreach (var sec in sections)
                        {
                            <option value="@sec.SectionId">@sec.Name</option>
                        }
                    </select>
                </label>
            }

            <div class="divider my-2"></div>

            <div class="modal-action gap-2">
                <button type="button" id="modal-cancel" class="btn btn-ghost btn-sm">Annuleer</button>
                <button type="submit" class="btn btn-primary btn-sm">OK</button>
            </div>
        </form>
    </div>
    <form method="dialog" class="modal-backdrop">
        <button id="modal-backdrop-close">close</button>
    </form>
</div>

@section Scripts {
    <script type="module" vite-src="~/project-questions.ts"></script>
}
