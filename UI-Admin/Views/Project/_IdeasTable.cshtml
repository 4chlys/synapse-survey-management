@model SynapseEnqueteManagement.UI.Admin.Models.Project.IdeasViewModel
@inject IViewLocalizer L
@{
    string StatusBadge(string s) => s switch {
        "Approved"  => "badge-success",
        "Declined"  => "badge-error",
        "Flagged"   => "badge-warning",
        _           => "badge-ghost"
    };
    string StatusLabel(string s) => s switch {
        "Approved"  => L["Status_Approved"].Value,
        "Declined"  => L["Status_Declined"].Value,
        "Flagged"   => L["Status_Flagged"].Value,
        "Unflagged" => L["Status_New"].Value,
        _           => s
    };
    string RowBg(string s) => s switch {
        "Unflagged" => "bg-warning/5",
        "Flagged"   => "bg-error/5",
        _           => ""
    };
    var ideasUrl = Url.Action("Ideas", new {
        Model.ProjectId, Model.Search, Model.CategoryId, Model.Status, Model.Page
    });
    var hasFilters = !string.IsNullOrEmpty(Model.Search) || Model.CategoryId.HasValue || !string.IsNullOrEmpty(Model.Status);
}

<div class="card bg-base-100 shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
        <table class="table table-sm">
            <thead>
                <tr class="bg-base-200">
                    <th class="w-auto">@L["TableIdea"]</th>
                    <th class="w-28">@L["TableCategory"]</th>
                    <th class="w-32">@L["TableStatus"]</th>
                    <th class="w-48">@L["TableAuthor"]</th>
                    <th class="w-12 text-center">👍</th>
                    <th class="w-28">@L["TableActions"]</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Ideas.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-base-content/40 py-10 italic">
                            @(hasFilters ? L["NoIdeasFiltered"] : L["NoIdeas"])
                        </td>
                    </tr>
                }
                @foreach (var idea in Model.Ideas)
                {
                    <tr class="hover @RowBg(idea.Status)">
                        <td class="max-w-xs">
                            @if (!string.IsNullOrEmpty(idea.ImageUrl))
                            {
                                <a href="@idea.ImageUrl" target="_blank" class="inline-block mr-2 align-middle">
                                    <img src="@idea.ImageUrl" alt="" class="w-12 h-12 object-cover rounded-md inline-block" />
                                </a>
                            }
                            <p class="font-medium text-sm leading-snug line-clamp-2 inline">@idea.Description</p>
                            <p class="text-xs text-base-content/40 mt-0.5">@idea.CreatedAt.ToString("dd MMM yyyy")</p>
                        </td>
                        <td>
                            <span class="badge badge-ghost badge-sm">@idea.CategoryName</span>
                        </td>
                        <td>
                            <span class="badge @StatusBadge(idea.Status) badge-sm">@StatusLabel(idea.Status)</span>
                        </td>
                        <td class="text-xs">
                            @if (!string.IsNullOrEmpty(idea.ParticipantEmail))
                            {
                                <a href="mailto:@idea.ParticipantEmail"
                                   class="link link-primary block truncate max-w-[12rem]"
                                   title="@idea.ParticipantEmail">@idea.ParticipantEmail</a>
                            }
                            else
                            {
                                <span class="text-base-content/30">—</span>
                            }
                        </td>
                        <td class="text-center font-semibold text-sm">@idea.ReactionCount</td>
                        <td>
                            <div class="flex gap-1">
                                @if (idea.Status != "Approved")
                                {
                                    <form asp-action="ApproveIdea" method="post" class="inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="projectId" value="@Model.ProjectId" />
                                        <input type="hidden" name="ideaId" value="@idea.IdeaId" />
                                        <input type="hidden" name="returnUrl" value="@ideasUrl" />
                                        <button type="submit" class="btn btn-success btn-xs" title="@L["ActionApprove"]">✓</button>
                                    </form>
                                }
                                @if (idea.Status != "Declined")
                                {
                                    <form asp-action="DeclineIdea" method="post" class="inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="projectId" value="@Model.ProjectId" />
                                        <input type="hidden" name="ideaId" value="@idea.IdeaId" />
                                        <input type="hidden" name="returnUrl" value="@ideasUrl" />
                                        <button type="submit" class="btn btn-error btn-xs" title="@L["ActionDecline"]">✕</button>
                                    </form>
                                }
                                @if (idea.Status != "Flagged")
                                {
                                    <form asp-action="FlagIdea" method="post" class="inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="projectId" value="@Model.ProjectId" />
                                        <input type="hidden" name="ideaId" value="@idea.IdeaId" />
                                        <input type="hidden" name="returnUrl" value="@ideasUrl" />
                                        <button type="submit" class="btn btn-warning btn-xs btn-outline" title="@L["ActionFlag"]">⚑</button>
                                    </form>
                                }
                                @if (!string.IsNullOrEmpty(idea.ImageUrl))
                                {
                                    <form asp-action="RemoveIdeaImage" method="post" class="inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="projectId" value="@Model.ProjectId" />
                                        <input type="hidden" name="ideaId" value="@idea.IdeaId" />
                                        <input type="hidden" name="returnUrl" value="@ideasUrl" />
                                        <button type="submit" class="btn btn-ghost btn-xs" title="@L["ActionRemoveImage"]"
                                                data-confirm="@L["ConfirmRemoveImage"].Value">🖼✕</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <div class="flex justify-between items-center mt-4">
        <span class="text-sm text-base-content/50">@string.Format(L["PageOf"].Value, Model.Page, Model.TotalPages)</span>
        <div class="join">
            @if (Model.Page > 1)
            {
                <a asp-action="Ideas"
                   asp-route-projectId="@Model.ProjectId"
                   asp-route-search="@Model.Search"
                   asp-route-categoryId="@Model.CategoryId"
                   asp-route-status="@Model.Status"
                   asp-route-page="@(Model.Page - 1)"
                   class="join-item btn btn-sm">←</a>
            }
            @for (int p = Math.Max(1, Model.Page - 2); p <= Math.Min(Model.TotalPages, Model.Page + 2); p++)
            {
                <a asp-action="Ideas"
                   asp-route-projectId="@Model.ProjectId"
                   asp-route-search="@Model.Search"
                   asp-route-categoryId="@Model.CategoryId"
                   asp-route-status="@Model.Status"
                   asp-route-page="@p"
                   class="join-item btn btn-sm @(p == Model.Page ? "btn-primary" : "")">@p</a>
            }
            @if (Model.Page < Model.TotalPages)
            {
                <a asp-action="Ideas"
                   asp-route-projectId="@Model.ProjectId"
                   asp-route-search="@Model.Search"
                   asp-route-categoryId="@Model.CategoryId"
                   asp-route-status="@Model.Status"
                   asp-route-page="@(Model.Page + 1)"
                   class="join-item btn btn-sm">→</a>
            }
        </div>
    </div>
}
