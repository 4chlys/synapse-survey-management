@model SynapseEnqueteManagement.UI.Admin.Models.Auth.ChangePasswordViewModel
@{
    ViewData["Title"] = "Wachtwoord wijzigen";
    ViewData["ActiveSection"] = "Wachtwoord wijzigen";
    Layout = "_Layout";
}

<div class="max-w-sm">
    <h1 class="font-heading font-bold text-xl text-base-content mb-6">Wachtwoord wijzigen</h1>

    @if (TempData["SuccessMessage"] is string msg)
    {
        <div class="alert alert-success mb-5 text-sm">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
            @msg
        </div>
    }

    <div class="card bg-base-100 shadow-sm">
        <div class="card-body gap-4">
            <form asp-action="ChangePassword" method="post" class="flex flex-col gap-4">

                <label class="form-control">
                    <div class="label"><span class="label-text text-xs font-medium">Huidig wachtwoord</span></div>
                    <input asp-for="CurrentPassword" type="password" autocomplete="current-password" class="input input-bordered w-full" />
                    <span asp-validation-for="CurrentPassword" class="label-text-alt text-error mt-1"></span>
                </label>

                <label class="form-control">
                    <div class="label"><span class="label-text text-xs font-medium">Nieuw wachtwoord</span></div>
                    <input asp-for="NewPassword" type="password" autocomplete="new-password" class="input input-bordered w-full" />
                    <span asp-validation-for="NewPassword" class="label-text-alt text-error mt-1"></span>
                </label>

                <label class="form-control">
                    <div class="label"><span class="label-text text-xs font-medium">Bevestig nieuw wachtwoord</span></div>
                    <input asp-for="ConfirmNewPassword" type="password" autocomplete="new-password" class="input input-bordered w-full" />
                    <span asp-validation-for="ConfirmNewPassword" class="label-text-alt text-error mt-1"></span>
                </label>

                <div asp-validation-summary="ModelOnly" class="text-error text-sm"></div>

                <button type="submit" class="btn btn-primary w-full">Wijzigen</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
