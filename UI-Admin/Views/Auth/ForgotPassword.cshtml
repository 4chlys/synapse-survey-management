@model SynapseEnqueteManagement.UI.Admin.Models.Auth.ForgotPasswordViewModel
@inject IViewLocalizer L
@inject IHtmlLocalizer<SharedResource> Shared
@{
    ViewData["Title"] = L["PageTitle"].Value;
    Layout = "_LoginLayout";
}

<div class="card bg-base-100 shadow-xl w-full max-w-sm">
    <div class="card-body gap-5">
        <div class="flex flex-col items-center gap-2">
            <div class="w-10 h-10 bg-primary rounded-xl flex items-center justify-center">
                <svg class="text-primary-content" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
                </svg>
            </div>
            <h1 class="font-heading font-bold text-lg text-base-content">@Shared["AppName"]</h1>
        </div>

        @if (TempData["ResetEmailSent"] is not null)
        {
            <div class="alert alert-success text-sm">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                @L["EmailSentMessage"]
            </div>
        }
        else
        {
            <p class="text-sm text-base-content/70">@L["Instructions"]</p>

            <form asp-action="ForgotPassword" method="post" class="flex flex-col gap-4">
                <label class="form-control">
                    <div class="label"><span class="label-text text-xs font-medium">@L["EmailLabel"]</span></div>
                    <input asp-for="Email" type="email" autocomplete="email"
                           class="input input-bordered w-full" placeholder="@L["EmailPlaceholder"]" />
                    <span asp-validation-for="Email" class="label-text-alt text-error mt-1"></span>
                </label>

                <button type="submit" class="btn btn-primary w-full mt-1">@L["SubmitButton"]</button>
            </form>
        }

        <a asp-action="Login" class="text-xs text-center text-base-content/60 hover:text-base-content">@L["BackToLogin"]</a>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
