@model SynapseEnqueteManagement.UI.Admin.Models.Auth.LoginViewModel
@inject IViewLocalizer L
@inject IHtmlLocalizer<SharedResource> Shared
@{
    ViewData["Title"] = L["PageTitle"].Value;
    Layout = "_LoginLayout";
}

<div class="w-full max-w-md">
    <div class="mb-8">
        <h1 class="font-heading font-bold text-2xl text-base-content mb-2">@L["Heading"]</h1>
        <p class="text-sm text-base-content/60">@L["Subheading"]</p>
    </div>

    @if (TempData["ResetSuccess"] is not null)
    {
        <div class="alert alert-success text-sm">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
            @L["ResetSuccessMessage"]
        </div>
    }
    
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-error text-sm mb-5">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
            <div asp-validation-summary="ModelOnly"></div>
        </div>
    }

    <form asp-action="Login" method="post" class="flex flex-col gap-4">
        <input type="hidden" asp-for="ReturnUrl" />

        <label class="form-control">
            <div class="label"><span class="label-text text-xs font-medium">@L["EmailLabel"]</span></div>
            <input asp-for="Email" type="email" autocomplete="email"
                   class="input input-bordered w-full" placeholder="@L["EmailPlaceholder"]" />
            <span asp-validation-for="Email" class="label-text-alt text-error mt-1"></span>
        </label>

        <label class="form-control">
            <div class="label"><span class="label-text text-xs font-medium">@L["PasswordLabel"]</span></div>
            <div class="relative">
                <input asp-for="Password" type="password" autocomplete="current-password"
                       id="login-password"
                       class="input input-bordered w-full pr-11" placeholder="••••••••" />
                <button type="button" id="toggle-password"
                        class="absolute inset-y-0 right-0 px-3 flex items-center text-base-content/50 hover:text-base-content transition-colors cursor-pointer"
                        aria-label="@L["TogglePassword"]">
                    <svg id="pw-eye" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8S1 12 1 12z"/><circle cx="12" cy="12" r="3"/>
                    </svg>
                    <svg id="pw-eye-off" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" class="hidden">
                        <path d="M17.94 17.94A10.94 10.94 0 0 1 12 20c-7 0-11-8-11-8a19.77 19.77 0 0 1 4.22-5.36M9.9 4.24A10.94 10.94 0 0 1 12 4c7 0 11 8 11 8a19.77 19.77 0 0 1-3.17 4.31M1 1l22 22"/>
                    </svg>
                </button>
            </div>
            <span asp-validation-for="Password" class="label-text-alt text-error mt-1"></span>
        </label>

        <button type="submit" class="btn btn-primary w-full mt-2 shadow-sm">@L["SubmitButton"]</button>
    </form>
    
    <a asp-action="ForgotPassword" class="text-xs text-center text-base-content/60 hover:text-base-content">@L["ForgotPasswordLink"]</a>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        (function () {
            var btn = document.getElementById('toggle-password');
            var input = document.getElementById('login-password');
            var eye = document.getElementById('pw-eye');
            var eyeOff = document.getElementById('pw-eye-off');
            if (!btn || !input) return;
            btn.addEventListener('click', function () {
                var show = input.type === 'password';
                input.type = show ? 'text' : 'password';
                eye.classList.toggle('hidden', show);
                eyeOff.classList.toggle('hidden', !show);
            });
        })();
    </script>
}
