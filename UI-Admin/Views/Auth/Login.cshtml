@model SynapseEnqueteManagement.UI.Admin.Models.Auth.LoginViewModel
@{
    ViewData["Title"] = "Inloggen";
    Layout = "_LoginLayout";
}

<div class="card bg-base-100 shadow-xl w-full max-w-sm">
    <div class="card-body gap-5">
        <div class="flex flex-col items-center gap-2">
            <div class="w-10 h-10 bg-primary rounded-xl flex items-center justify-center">
                <svg class="text-primary-content" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
                </svg>
            </div>
            <h1 class="font-heading font-bold text-lg text-base-content">Synapse Admin</h1>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-error text-sm">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
                <div asp-validation-summary="ModelOnly"></div>
            </div>
        }

        <form asp-action="Login" method="post" class="flex flex-col gap-4">
            <input type="hidden" asp-for="ReturnUrl" />

            <label class="form-control">
                <div class="label"><span class="label-text text-xs font-medium">E-mailadres</span></div>
                <input asp-for="Email" type="email" autocomplete="email"
                       class="input input-bordered w-full" placeholder="naam@voorbeeld.be" />
                <span asp-validation-for="Email" class="label-text-alt text-error mt-1"></span>
            </label>

            <label class="form-control">
                <div class="label"><span class="label-text text-xs font-medium">Wachtwoord</span></div>
                <input asp-for="Password" type="password" autocomplete="current-password"
                       class="input input-bordered w-full" placeholder="••••••••" />
                <span asp-validation-for="Password" class="label-text-alt text-error mt-1"></span>
            </label>

            <button type="submit" class="btn btn-primary w-full mt-1">Inloggen</button>
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
