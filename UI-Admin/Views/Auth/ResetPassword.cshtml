@model SynapseEnqueteManagement.UI.Admin.Models.Auth.ResetPasswordViewModel
@inject IViewLocalizer L
@inject IHtmlLocalizer<SharedResource> Shared
@{
    ViewData["Title"] = L["PageTitle"].Value;
    Layout = "_LoginLayout";
}

<div class="card bg-base-100 shadow-xl w-full max-w-sm">
    <div class="card-body gap-5">
        <div class="flex flex-col items-center gap-2">
            <div class="w-10 h-10 bg-primary rounded-xl flex items-center justify-center">
                <svg class="text-primary-content" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
                </svg>
            </div>
            <h1 class="font-heading font-bold text-lg text-base-content">@Shared["AppName"]</h1>
        </div>

        <h2 class="font-semibold text-base text-center">@L["Heading"]</h2>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-error text-sm">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
                <div asp-validation-summary="ModelOnly"></div>
            </div>
        }

        <form asp-action="ResetPassword" method="post" class="flex flex-col gap-4">
            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="Token" />

            <label class="form-control">
                <div class="label"><span class="label-text text-xs font-medium">@L["NewPasswordLabel"]</span></div>
                <input asp-for="NewPassword" type="password" autocomplete="new-password"
                       class="input input-bordered w-full" placeholder="••••••••" />
                <span asp-validation-for="NewPassword" class="label-text-alt text-error mt-1"></span>
            </label>

            <label class="form-control">
                <div class="label"><span class="label-text text-xs font-medium">@L["ConfirmLabel"]</span></div>
                <input asp-for="ConfirmPassword" type="password" autocomplete="new-password"
                       class="input input-bordered w-full" placeholder="••••••••" />
                <span asp-validation-for="ConfirmPassword" class="label-text-alt text-error mt-1"></span>
            </label>

            <button type="submit" class="btn btn-primary w-full mt-1">@L["SubmitButton"]</button>
        </form>

        <a asp-action="Login" class="text-xs text-center text-base-content/60 hover:text-base-content">@L["BackToLogin"]</a>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
