@using SynapseEnqueteManagement.UI.Admin.Models.Platform
@model AddAdminViewModel
@inject IViewLocalizer L
@{
    ViewData["Title"] = L["PageTitle"].Value;
    ViewData["ActiveSection"] = L["NavActive"].Value;
    Layout = "_Layout";
}

<div class="max-w-sm">
    <div class="card bg-base-100 shadow-sm">
        <div class="card-body gap-4">

            <div class="mb-1">
                <a asp-controller="Admin" asp-action="Index"
                   class="text-base-content/60 hover:text-base-content transition text-sm">
                    ← @Model.PlatformName
                </a>
            </div>

            <h1 class="font-heading font-bold text-xl text-base-content mb-5">@L["Heading"]</h1>

            <div asp-validation-summary="ModelOnly"
                 class="text-sm text-error border border-error bg-error/10 px-4 py-3 rounded"></div>

            <form asp-controller="Admin" asp-action="Add" method="post" class="flex flex-col gap-4">
                @Html.AntiForgeryToken()
                <input asp-for="ProjectPlatformId" type="hidden" />

                <label class="form-control">
                    <div class="label">
                        <span class="label-text text-xs font-medium">@L["PlatformLabel"]</span>
                    </div>
                    <p class="input input-bordered w-full flex items-center text-base-content/60">@Model.PlatformName</p>
                </label>

                <label class="form-control">
                    <div class="label">
                        <span class="label-text text-xs font-medium">@L["EmailLabel"]</span>
                    </div>
                    <input asp-for="Email"
                           class="input input-bordered w-full"
                           placeholder="@L["EmailPlaceholder"]" />
                    <span asp-validation-for="Email" class="text-xs text-error mt-1 block"></span>
                </label>

                <label class="form-control">
                    <div class="label">
                        <span class="label-text text-xs font-medium">@L["PasswordLabel"]</span>
                    </div>
                    <input asp-for="Password"
                           class="input input-bordered w-full"
                           placeholder="@L["PasswordPlaceholder"]" />
                    <span asp-validation-for="Password" class="text-xs text-error mt-1 block"></span>
                </label>

                <div class="flex items-center gap-3 mt-2">
                    <button type="submit" class="btn btn-primary w-full">
                        @L["SubmitButton"]
                    </button>
                    <a asp-controller="Admin" asp-action="Index"
                       class="btn btn-ghost btn-sm text-error">
                        @L["CancelButton"]
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
