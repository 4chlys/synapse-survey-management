@using SynapseEnqueteManagement.UI.Admin.Models.Platform
@model PlatformDetailViewModel
@{
    ViewData["Title"] = Model.Name;
    Layout = "_Layout";
}

<div class="min-h-screen bg-gray-900 text-white p-8">

    <div class="max-w-2xl">

        @* Platform info card *@
        <div class="bg-gray-800 p-6 mb-6">
            <div class="flex items-start justify-between mb-4">
                <div class="flex items-center gap-4">
                    @if (!string.IsNullOrEmpty(Model.LogoUrl))
                    {
                        <img src="@Model.LogoUrl" alt="@Model.Name logo"
                             class="h-14 w-auto object-contain" />
                    }
                    <div>
                        <h1 class="text-xl font-semibold text-white">@Model.Name</h1>
                        @if (!string.IsNullOrEmpty(Model.WebsiteUrl))
                        {
                            <a href="@Model.WebsiteUrl" target="_blank"
                               class="text-sm text-gray-400 hover:text-white transition underline underline-offset-2">
                                @Model.WebsiteUrl
                            </a>
                        }
                        else
                        {
                            <span class="text-sm text-gray-500 italic">Geen website</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        @* Admins card *@
        <div class="bg-gray-800 p-6">
            <div class="flex items-center justify-between mb-4">
                <h2 class="text-base font-semibold text-white">Beheerders</h2>
                <a asp-controller="Admin" asp-action="Add"
                   class="border border-gray-600 px-3 py-1 text-xs text-gray-300 hover:text-white hover:border-gray-400 transition">
                    + Beheerder toevoegen
                </a>
            </div>

            @if (Model.Admins == null || !Model.Admins.Any())
            {
                <p class="text-sm text-gray-400 italic">Geen beheerders</p>
            }
            else
            {
                <table class="w-full text-sm">
                    <thead>
                        <tr class="border-b border-gray-700 text-gray-400 text-xs uppercase tracking-wide">
                            <th class="text-left py-2 pr-4">Gebruikersnaam</th>
                            <th class="text-left py-2">E-mail</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var admin in Model.Admins)
                        {
                            <tr class="border-b border-gray-700 last:border-0">
                                <td class="py-3 pr-4 text-white">@admin.UserName</td>
                                <td class="py-3 text-gray-300">@admin.Email</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

    </div>
</div>
