{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.HttpLogging": "Information"
    }
  },
  "AllowedHosts": "*",
  "SummaryStorage": {
    "BaseDirectory": ""
  },
  "Subdomains": {
    "Reserved": [ "admin", "api", "www", "app", "mail", "static", "assets", "cdn", "auth", "health" ]
  },

  "VertexAi": {
    "ProjectId": "synapse-ip-j2",
    "Location": "europe-west1",
    "Model": "gemini-2.5-flash-lite",
    "Endpoint": "europe-west1-aiplatform.googleapis.com"
  },

  // Prices in EUR, approximated from Vertex AI published USD rates (converted at ~0.93 USD/EUR).
  // Source: https://cloud.google.com/vertex-ai/generative-ai/pricing
  "AiPricing": {
    "Models": {
      "gemini-2.5-flash-lite": {
        "InputPerMillion": 0.093,
        "AudioInputPerMillion": 0.279,
        "OutputPerMillion": 0.372
      },
      "gemini-embedding-001": {
        "InputPerMillion": 0.023,
        "AudioInputPerMillion": 0.0,
        "OutputPerMillion": 0.0
      },
      // Input (text prompt): $0.30/1M. Image output: $30/1M tokens; token count computed
      // from Width×Height in ai-config.json (1024×1024 = 1290 tokens, scales with pixel area).
      "gemini-2.5-flash-image": {
        "InputPerMillion": 0.279,
        "AudioInputPerMillion": 0.0,
        "OutputPerMillion": 27.9
      }
    }
  }
}
