# ══════════════════════════════════════════════════════════════
#  Synapse – Configuratie per omgeving
#  Kopieer dit bestand naar config.<omgeving>.env en vul in.
#
#  Voorbeelden:
#    deploy/config.test.env  → voor de testomgeving
#    deploy/config.prod.env  → voor productie
#
#  Gebruik: ./deploy/bootstrap.sh <omgeving>
#  Commit config.*.env NOOIT naar git (.gitignore houdt het tegen).
# ══════════════════════════════════════════════════════════════

# ── GCP Project ────────────────────────────────────────────────
PROJECT_ID="jouw-gcp-project-id"          # bijv. synapse-ip-j2
PROJECT_NUMBER=""                          # wordt automatisch opgevraagd
REGION="europe-west1"
ZONE="europe-west1-b"

# ── Domein voor DEZE omgeving ──────────────────────────────────
# prod: synapse-ip.xyz
# test: test.synapse-ip.xyz
DOMAIN="jouwdomein.be"
# Subdomains worden automatisch: api.DOMAIN en admin.DOMAIN

# ── Database ───────────────────────────────────────────────────
DB_PASSWORD=REDACTED"   # minimaal 12 tekens

# ── API beveiliging ────────────────────────────────────────────
API_KEY=""                                 # leeg = automatisch gegenereerd

# ── Cloud Storage ──────────────────────────────────────────────
# Standaard: <PROJECT_ID>-assets-<omgeving>  (bijv. synapse-ip-j2-assets-test)
GCS_BUCKET=""

# ── Vertex AI ──────────────────────────────────────────────────
VERTEX_AI_LOCATION="europe-west1"

# ── Resend API Key & e-mail ──────────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="noreply@email.com"
