# ══════════════════════════════════════════════════════════════
#  Synapse – Klantconfiguratie
#  Kopieer dit bestand naar config.env en vul alle waarden in.
#  Commit config.env NOOIT naar git (.gitignore houdt het tegen).
# ══════════════════════════════════════════════════════════════

# ── GCP Project ────────────────────────────────────────────────
PROJECT_ID="jouw-gcp-project-id"         # bijv. mijn-bedrijf-synapse
PROJECT_NUMBER=""                         # wordt automatisch opgevraagd
REGION="europe-west1"                     # GCP regio
ZONE="europe-west1-b"                     # GCP zone

# ── Domein ─────────────────────────────────────────────────────
DOMAIN="jouwdomein.be"                    # hoofddomein (zonder https://)
# Subdomains worden automatisch: api.DOMAIN en admin.DOMAIN

# ── Database ───────────────────────────────────────────────────
DB_PASSWORD=REDACTED"  # minimaal 12 tekens

# ── API beveiliging ────────────────────────────────────────────
API_KEY=REDACTED" # bijv. output van: openssl rand -base64 32

# ── Cloud Storage ──────────────────────────────────────────────
GCS_BUCKET="${PROJECT_ID}-assets-prod"    # naam van de storage bucket

# ── Vertex AI (optioneel) ──────────────────────────────────────
VERTEX_AI_LOCATION="europe-west1"
